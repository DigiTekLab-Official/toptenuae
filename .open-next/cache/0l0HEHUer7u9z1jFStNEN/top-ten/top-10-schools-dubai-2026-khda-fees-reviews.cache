\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"b3cb05a40be6\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"93e5c83e1f9e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"For FS1 (Pre-KG):\\\"},{\\\"_key\\\":\\\"b4470bf80ea9\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Child must be 3 years old by Dec 31st.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"d971e1cbad56\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"1aafda943f46\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"For FS2 (KG1):\\\"},{\\\"_key\\\":\\\"931e18d918d9\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Child must be 4 years old by Dec 31st.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"031722f868c8\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"3d14c3672c02\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"For Year 1 (KG2):\\\"},{\\\"_key\\\":\\\"010e7bf47ab7\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Child must be 5 years old by Dec 31st.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"9b3c9e8b9c78\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"d2ce266d8502\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"em\\\"],\\\"text\\\":\\\"Note: This applies to schools starting in September. Schools starting in April (Indian/Pakistani curriculum) adhere to a March 31st cut-off.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"question\\\":\\\"Has the school entry age changed for Dubai schools in 2026?\\\"},{\\\"_key\\\":\\\"2c6b63e8a586\\\",\\\"answer\\\":[{\\\"_key\\\":\\\"8d72d945e8cf\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"3c9757196617\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Yes. The UAE Ministry of Education now mandates Arabic instruction for \\\"},{\\\"_key\\\":\\\"42d7586698e0\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"all students\\\"},{\\\"_key\\\":\\\"677e184e5003\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" in private schools, starting from Kindergarten.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"e98b61016cb5\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"54aeca2b189e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"KG/Foundation Stage:\\\"},{\\\"_key\\\":\\\"fac878ca0902\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Schools must provide at least 4 daily lessons per week (approx. 30-40 mins each).\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"9ab7f7070332\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"6ae1529a20d9\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Grade 1-9:\\\"},{\\\"_key\\\":\\\"05afab469c08\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Mandatory Arabic as a Second Language (ASL) for non-native speakers.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"ca52d52c9e85\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"94c86c37c22c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Grade 10-12:\\\"},{\\\"_key\\\":\\\"0470627e1b1a\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Optional in some curricula (like British/IB) if the student has completed 9 years of Arabic, but many schools keep it mandatory until Year 10.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"question\\\":\\\"Is Arabic mandatory for non-Arab children in Dubai?\\\"},{\\\"_key\\\":\\\"4578b4a16a03\\\",\\\"answer\\\":[{\\\"_key\\\":\\\"6e874ea1b868\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"e8a8095bf3d3\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Generally, no. The KHDA is very strict about age-appropriate placement, especially for younger children (FS1 to Year 2). Demotion or promotion is rarely approved without significant evidence (e.g., a medical report or transfer from a different country's distinct education system) and must be officially sanctioned by the KHDA.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"question\\\":\\\"Can I transfer my child to a lower/higher grade if they are gifted?\\\"},{\\\"_key\\\":\\\"88de5692021f\\\",\\\"answer\\\":[{\\\"_key\\\":\\\"7b9e344b6176\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"804902d8d051\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"If you are moving from outside Dubai, a Transfer Certificate is mandatory for admission to Year 2 (Grade 1) and upwards.\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"573fa600224d\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"a01cf443ca2e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"From UK/USA/Australia/Canada/Europe:\\\"},{\\\"_key\\\":\\\"fbd79dbbdeb5\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Usually only requires the school stamp and signature.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"ae9c8be44b02\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"825f913c7728\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"From India/GCC/South Africa/Other:\\\"},{\\\"_key\\\":\\\"d039704f17b1\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Must be attested by the \\\"},{\\\"_key\\\":\\\"f245f76fdbfb\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Ministry of Education\\\"},{\\\"_key\\\":\\\"16ca7e059ff8\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" in the country of origin, the \\\"},{\\\"_key\\\":\\\"bfccab844056\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Ministry of Foreign Affairs\\\"},{\\\"_key\\\":\\\"b67d5436d30c\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" (in that country), and the \\\"},{\\\"_key\\\":\\\"bc3eb89f8f34\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"UAE Embassy\\\"},{\\\"_key\\\":\\\"a7e246495e3e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" there.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"question\\\":\\\"What documents do I need for the \\\\\\\"Transfer Certificate\\\\\\\" (TC)?\\\"},{\\\"_key\\\":\\\"2031c351a67b\\\",\\\"answer\\\":[{\\\"_key\\\":\\\"8345fd6e9e3d\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"1c584abf24be\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\"Following the UAE's working week change, all schools in Dubai operate on a \\\"},{\\\"_key\\\":\\\"8da691ee4cbd\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"4.5-day week\\\"},{\\\"_key\\\":\\\"e211c16a9527\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\".\\\"}],\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"eec460bebb48\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"27a0d75e6e8e\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Monday - Thursday:\\\"},{\\\"_key\\\":\\\"f18ac3d8d957\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Full school days (typically 7:45 AM – 3:00 PM).\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"},{\\\"_key\\\":\\\"4e4eaceaf1b5\\\",\\\"_type\\\":\\\"block\\\",\\\"children\\\":[{\\\"_key\\\":\\\"5066c67894fe\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[\\\"strong\\\"],\\\"text\\\":\\\"Friday:\\\"},{\\\"_key\\\":\\\"53f34d6e9c47\\\",\\\"_type\\\":\\\"span\\\",\\\"marks\\\":[],\\\"text\\\":\\\" Half-day (ends by 11:30 AM - 12:00 PM) to accommodate Friday prayers.\\\"}],\\\"level\\\":1,\\\"listItem\\\":\\\"bullet\\\",\\\"markDefs\\\":[],\\\"style\\\":\\\"normal\\\"}],\\\"question\\\":\\\"Why do Dubai schools finish early on Fridays?\\\"}],\\\"intro\\\":\\\"Stop guessing. We've ranked the top 10 schools in Dubai for 2026 based on real parent feedback, traffic realities, and the latest KHDA 'Outstanding' ratings. Find out where your money actually goes—beyond the brochure.\\\",\\\"listItems\\\":[{\\\"_key\\\":\\\"e75f8ac5f61d\\\",\\\"badgeLabel\\\":\\\"The Academic Heavyweight\\\",\\\"customVerdict\\\":null,\\\"product\\\":{\\\"_type\\\":\\\"institution\\\",\\\"address\\\":\\\"Al Sufouh Road, \\\\nAl Sufouh 2, \\\\nPO Box 837, \\\\nDubai, United Arab Emirates.\\\",\\\"affiliateLink\\\":null,\\\"availability\\\":null,\\\"brand\\\":null,\\\"code\\\":null,\\\"cons\\\":null,\\\"country\\\":null,\\\"currency\\\":null,\\\"curriculum\\\":\\\"British\\\",\\\"customerRating\\\":null,\\\"entityType\\\":null,\\\"feeRange\\\":\\\"AED 97,415 – AED 110,305\\\",\\\"heroFeature\\\":null,\\\"keyFeatures\\\":null,\\\"location\\\":\\\"Al Sufouh\\\",\\\"mainImage\\\":{\\\"alt\\\":\\\"Dubai College campus main entrance with distinctive red brick facade.\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/kxdjzy8e/production/0ada3a9e4d93a81b4060bfa8825c5e3f55331ca0-1200x675.webp\\\"},\\\"price\\\":null,\\\"priceTier\\\":null,\\\"pros\\\":null,\\\"rating\\\":\\\"Outstanding\\\",\\\"realityCheck\\\":[\\\"Admissions are highly selective; top 10-15% academic performers only.\\\",\\\"No Primary school; you need a strategic feeder school (like DESS).\\\",\\\"Morning congestion in Al Sufouh is inevitable.\\\",\\\"Mandatory Debenture: New students must pay a refundable AED 30,000 debenture.\\\"],\\\"retailer\\\":null,\\\"reviewCount\\\":null,\\\"slug\\\":\\\"dubai-college\\\",\\\"specifications\\\":null,\\\"title\\\":\\\"Dubai College\\\",\\\"verdict\\\":\\\"Dubai College remains the undisputed academic champion of Dubai. It operates as a not-for-profit and is the closest thing Dubai has to an elite British grammar school.\\\",\\\"website\\\":\\\"https://www.dubaicollege.org/\\\"},\\\"rank\\\":1,\\\"whySelected\\\":\\\"Best for high-achieving students aiming for Oxbridge.\\\"},{\\\"_key\\\":\\\"25ae6f39cf6e\\\",\\\"badgeLabel\\\":\\\"The All-Rounder\\\",\\\"customVerdict\\\":null,\\\"product\\\":{\\\"_type\\\":\\\"institution\\\",\\\"address\\\":\\\"Arabian Ranches, \\\\nSheikh Mohammed Bin Zayed Road, \\\\nPO Box 24463, \\\\nDubai, UAE.\\\",\\\"affiliateLink\\\":null,\\\"availability\\\":null,\\\"brand\\\":null,\\\"code\\\":null,\\\"cons\\\":null,\\\"country\\\":null,\\\"currency\\\":null,\\\"curriculum\\\":\\\"Dual (British / IB)\\\",\\\"customerRating\\\":null,\\\"entityType\\\":null,\\\"feeRange\\\":\\\"AED 54,129 – AED 104,544\\\",\\\"heroFeature\\\":null,\\\"keyFeatures\\\":null,\\\"location\\\":\\\"Arabian Ranches\\\",\\\"mainImage\\\":{\\\"alt\\\":\\\"JESS Arabian Ranches school grounds and main sports field.\\\",\\\"url\\\":\\\"https://cdn.sanity.io/images/kxdjzy8e/production/dfbd1ce5966cca2a0cfa38a9e8ab7191d5844147-1200x675.webp\\\"},\\\"price\\\":null,\\\"priceTier\\\":null,\\\"pros\\\":null,\\\"rating\\\":\\\"Outstanding\\\",\\\"realityCheck\\\":[\\\"Requires a Debenture (approx. AED 20k interest-free loan).\\\",\\\"The waitlist is massive; parents often apply at birth.\\\",\\\"Difficult to enter without corporate priority.\\\"],\\\"retailer\\\":null,\\\"reviewCount\\\":null,\