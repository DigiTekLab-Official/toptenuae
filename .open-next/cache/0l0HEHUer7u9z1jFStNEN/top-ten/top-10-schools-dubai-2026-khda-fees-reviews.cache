i\",null,{\"className\":\"flex items-center shrink-0\",\"children\":[\"$\",\"$L1a\",null,{\"href\":\"/top-ten\",\"className\":\"text-gray-500 hover:text-[#4b0082] hover:underline transition-colors font-medium whitespace-nowrap\",\"title\":\"View all top-ten\",\"children\":\"top-ten\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"className\":\"text-gray-400 shrink-0\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]}],[\"$\",\"li\",null,{\"className\":\"flex items-center min-w-0\",\"aria-current\":\"page\",\"children\":[\"$\",\"span\",null,{\"className\":\"truncate max-w-[150px] sm:max-w-[200px] md:max-w-md text-gray-900 font-semibold block\",\"title\":\"Top 10 Schools in Dubai (2026): Honest Reviews, Fees & KHDA Ratings\",\"children\":\"Top 10 Schools in Dubai (2026): Honest Reviews, Fees & KHDA Ratings\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row gap-8 lg:gap-5\",\"children\":[[\"$\",\"main\",null,{\"className\":\"flex-1 min-w-0 bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8\",\"children\":[[\"$\",\"header\",null,{\"className\":\"border-b border-gray-100 pb-6 mb-6\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl lg:text-4xl font-black text-gray-900 mb-4 leading-tight tracking-tight\",\"children\":\"Top 10 Schools in Dubai (2026): Honest Reviews, Fees & KHDA Ratings\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center text-sm text-gray-500 gap-4\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Last Updated:\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-01-14T16:25:00.000Z\",\"children\":\"14 January 2026\"}]]}]}],false]}],[\"$\",\"$L33\",null,{\"data\":{\"_type\":\"topTenList\",\"body\":[{\"_key\":\"c73e9ad052d7\",\"_type\":\"block\",\"children\":[{\"_key\":\"2866c79fd978\",\"_type\":\"span\",\"marks\":[],\"text\":\"Choosing a school in Dubai is rarely just about the curriculum; it is about logistics, budget, and finding the right environment. With the \"},{\"_key\":\"91732a53ca56\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"KHDA (Knowledge and Human Development Authority)\"},{\"_key\":\"a88d44f2f8e1\",\"_type\":\"span\",\"marks\":[],\"text\":\" approving a fee increase for the 2025-2026 academic year, and traffic hotspots shifting, the \\\"best\\\" school on paper might not be the best for your daily life.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7661712fe64c\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c7c77cacd70\",\"_type\":\"span\",\"marks\":[],\"text\":\"This guide cuts through the marketing fluff. We have analysed 10 of the highest-performing schools in Dubai—including \"},{\"_key\":\"831bdc0fc228\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"KHDA\"},{\"_key\":\"103be8020085\",\"_type\":\"span\",\"marks\":[],\"text\":\" 'Outstanding' and select 'Very Good' institutions, but we have added what the brochures won't tell you: the real costs, the traffic struggles, and who these schools are \"},{\"_key\":\"7664eb50e0ac\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"actually\"},{\"_key\":\"915cbf0ef808\",\"_type\":\"span\",\"marks\":[],\"text\":\" right for.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"517d4129b759\",\"_type\":\"relatedLink\",\"label\":\"For New Parents\",\"preText\":\"For parents with younger children, setting up a safe home environment is just as important as choosing the right school.\",\"targetPost\":{\"_ref\":\"feb1c065-faab-4318-88a5-9eb1081fbff7\",\"_type\":\"reference\"}},{\"_key\":\"09597458650d\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"ce348fc1586d\",\"_type\":\"block\",\"children\":[{\"_key\":\"181133075e3a\",\"_type\":\"span\",\"marks\":[],\"text\":\"The \\\"Real\\\" Criteria: How We Ranked These Schools\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"a867f3908442\",\"_type\":\"block\",\"children\":[{\"_key\":\"29ca13110645\",\"_type\":\"span\",\"marks\":[],\"text\":\"Beyond the official \\\"Outstanding\\\" badge, we evaluated these schools on three practical factors:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"eced67ab4750\",\"_type\":\"block\",\"children\":[{\"_key\":\"985dd49655c5\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The \\\"Hessa Street\\\" Factor:\"},{\"_key\":\"b4ecec672722\",\"_type\":\"span\",\"marks\":[],\"text\":\" How difficult is the school run? (Traffic in Dubai is a major quality-of-life factor).\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9b4239a3d44\",\"_type\":\"block\",\"children\":[{\"_key\":\"d293195634b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The Hidden Costs:\"},{\"_key\":\"9bf6d3f2bf43\",\"_type\":\"span\",\"marks\":[],\"text\":\" Beyond tuition, what are you paying for? (Debentures, tech fees, and uniforms).\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ac6727757a89\",\"_type\":\"block\",\"children\":[{\"_key\":\"5125ade84a75\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The Vibe:\"},{\"_key\":\"f57ae037775d\",\"_type\":\"span\",\"marks\":[],\"text\":\" Is it an academic pressure cooker or a creative haven?\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e22af6001b2b\",\"_type\":\"block\",\"children\":[{\"_key\":\"7ddf053a47e3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Our research combines\"},{\"_key\":\"71f289fdcaff\",\"_type\":\"span\",\"marks\":[],\"text\":\" KHDA inspection reports, published fee schedules, curriculum outcomes, on-ground location analysis, and long-term parent feedback. \"},{\"_key\":\"2e75d30ddf2d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Rankings are editorially independent\"},{\"_key\":\"26620d98be19\",\"_type\":\"span\",\"marks\":[],\"text\":\" — we do not accept paid placements or referral incentives from schools.\"}],\"markDefs\":[],\"style\":\"blockquote\"},{\"_key\":\"94417ec20a26\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"69857ed49565\",\"_type\":\"block\",\"children\":[{\"_key\":\"9228ba9fbfb8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Note: All fees listed are indicative for the 2025-2026 academic year and are subject to final KHDA approval and annual revision.\"}],\"markDefs\":[],\"style\":\"blockquote\"},{\"_key\":\"7f474c3b7e48\",\"_type\":\"block\",\"children\":[{\"_key\":\"bf24bdfae576\",\"_type\":\"span\",\"marks\":[],\"text\":\"Parents can also refer to \"},{\"_key\":\"360a8a61936e\",\"_type\":\"span\",\"marks\":[\"strong\",\"dcf6d53efa17\"],\"text\":\"KHDA’s official guide on choosing a school in Dubai\"},{\"_key\":\"e60d27c8e1f4\",\"_type\":\"span\",\"marks\":[\"dcf6d53efa17\"],\"text\":\" \"},{\"_key\":\"958c7314827c\",\"_type\":\"span\",\"marks\":[],\"text\":\"to understand inspection ratings, fee frameworks, and admission guidelines set by the regulator.\"}],\"markDefs\":[{\"_key\":\"dcf6d53efa17\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://web.khda.gov.ae/en/Guides/Parents/Choosing-a-School\"}],\"style\":\"blockquote\"}],\"closingContent\":[{\"_key\":\"905895659bfe\",\"_type\":\"relatedLink\",\"label\":\"Community & Giving Back\",\"preText\":\"Many Dubai schools encourage community involvement, sustainability, and giving back through family-led initiatives.\",\"targetPost\":{\"_ref\":\"e8d0ac6b-8006-4a83-aaf7-9a83af79db34\",\"_type\":\"reference\"}},{\"_key\":\"ac71fd3dca65\",\"_type\":\"block\",\"children\":[{\"_key\":\"082f48cbf76d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Practical Guide: Admission Tips for 2026\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"18b6250896ec\",\"_type\":\"block\",\"children\":[{\"_key\":\"629daa1034b8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1. The \\\"January Rule\\\":\"},{\"_key\":\"390b9bc4b413\",\"_type\":\"span\",\"marks\":[],\"text\":\" If you are reading this in January 2026, \"},{\"_key\":\"f45d01fdc90d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"apply now\"},{\"_key\":\"376018c87d5e\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f3d92230776c\",\"_type\":\"block\",\"children\":[{\"_key\":\"31ce84b43a1f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Top Tier (DC, JESS):\"},{\"_key\":\"59fbb05b3a3e\",\"_type\":\"span\",\"marks\":[],\"text\":\" Likely closed or waitlisted. Call admissions immediately to ask about \\\"unexpected exits.\\\"\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"902d50791cd5\",\"_type\":\"block\",\"children\":[{\"_key\":\"091e9640c72f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Mid Tier:\"},{\"_key\":\"85e043a7d691\",\"_type\":\"span\",\"marks\":[],\"text\":\" Admissions are processing.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"12d889c27fef\",\"_type\":\"block\",\"children\":[{\"_key\":\"bb38473be575\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"New Schools:\"},{\"_key\":\"268368b895ab\",\"_type\":\"span\",\"marks\":[],\"text\":\" Look for newly opened branches (e.g., Dubai British School Jumeira or similar new expansions) as they often have capacity when established schools don't.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"aaa743cb7f5b\",\"_type\":\"block\",\"children\":[{\"_key\":\"2b77ebf37258\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2. Budget for the \\\"Hidden 20k\\\".\"},{\"_key\":\"471c69b95aab\",\"_type\":\"span\",\"marks\":[],\"text\":\" Do not just look at the tuition fee. For a top-tier school, your first year will include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e8c60d9244e8\",\"_type\":\"block\",\"children\":[{\"_key\":\"e908a3453e86\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Registration Fee:\"},{\"_key\":\"466610ea3ad2\",\"_type\":\"span\",\"marks\":[],\"text\":\" ~AED 500 (non-refundable).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a6835f3938e9\",\"_type\":\"block\",\"children\":[{\"_key\":\"802c5fa049aa\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Admission Fee:\"},{\"_key\":\"4cdfa69abc94\",\"_type\":\"span\",\"marks\":[],\"text\":\" ~AED 3,000 - 5,000 (deducted from tuition).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0a032c75770d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6ed5631340c4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Uniforms:\"},{\"_key\":\"7e5b55d7d41d\",\"_type\":\"span\",\"marks\":[],\"text\":\" AED 1,500+.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"26e63e7e8ff6\",\"_type\":\"block\",\"children\":[{\"_key\":\"3cf608fa3aaa\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Laptop/iPad:\"},{\"_key\":\"11f1ebae1ae5\",\"_type\":\"span\",\"marks\":[],\"text\":\" Mandatory in most schools from Year 3+ (AED 2,000+).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f56c834b794a\",\"_type\":\"block\",\"children\":[{\"_key\":\"695f60315005\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Transport:\"},{\"_key\":\"9eddf3d2eef0\",\"_type\":\"span\",\"marks\":[],\"text\":\" AED 8,000 - 10,000 per year.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"738a34498bab\",\"_type\":\"block\",\"children\":[{\"_key\":\"a2f88fdfaa2b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"3. Check the \\\"School Run\\\" Map.\"},{\"_key\":\"d4b0aee2d5b8\",\"_type\":\"span\",\"marks\":[],\"text\":\" Before paying a deposit, drive from your home to the school at \"},{\"_key\":\"d492270d558b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"7:30 AM\"},{\"_key\":\"f84030d397b3\",\"_type\":\"span\",\"marks\":[],\"text\":\" on a weekday. A \\\"15-minute drive\\\" on a Sunday can easily become a 45-minute commute on a Tuesday morning.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f70ad0112b81\",\"_type\":\"relatedLink\",\"label\":\"Family Essentials\",\"preText\":\"Beyond school fees, families should also plan for everyday child-care and living expenses in Dubai’s climate.\",\"targetPost\":{\"_ref\":\"284e557a-b327-4426-b659-a1c5e407d113\",\"_type\":\"reference\"}},{\"_key\":\"bedb7d396759\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"4e0e328d785d\",\"_type\":\"block\",\"children\":[{\"_key\":\"aaa6f8de0b7c\",\"_type\":\"span\",\"marks\":[],\"text\":\"The \\\"Hidden\\\" First-Year Costs (2026 Estimates)\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"fc5cbb27dc9e\",\"_type\":\"block\",\"children\":[{\"_key\":\"095c9c2725bc\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Beyond the tuition fee, here is what you will actually pay in your first year.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"18906d830978\",\"_type\":\"table\",\"rows\":[{\"_key\":\"cef87f36-2206-4626-a9ef-a42031c044bc\",\"_type\":\"tableRow\",\"cells\":[\"Expense Item\",\"Estimated Cost (AED)\",\"Notes\"]},{\"_key\":\"4790d635-a872-4431-8d71-b163bcdf0350\",\"_type\":\"tableRow\",\"cells\":[\"Registration Fee\",\"525\",\"Standard non-refundable fee (inclusive of VAT).\"]},{\"_key\":\"b34c3351-d6b1-4498-b604-c5dc4d534c38\",\"_type\":\"tableRow\",\"cells\":[\"Assessment Fee\",\"500 - 1,000\",\"Paid upon invitation for an entrance test/interview.\"]},{\"_key\":\"97db21fe-b551-4bfa-9bf5-a33d0e658d04\",\"_type\":\"tableRow\",\"cells\":[\"Seat Deposit\",\"4,000 - 10,000\",\"5-10% of tuition, deducted from Term 1 fees.\"]},{\"_key\":\"159b5929-cae6-4dc0-8926-e42882d1d03d\",\"_type\":\"tableRow\",\"cells\":[\"Uniforms (Full Kit)\",\"2,500\",\"Includes daily wear, PE kit, house colors, and school bag.\"]},{\"_key\":\"6fbf22bb-8011-437f-bf77-30ee4639dbb2\",\"_type\":\"tableRow\",\"cells\":[\"School Transport\",\"9,000 - 10,000\",\"Average annual cost for two-way bus service.\"]},{\"_key\":\"148e4a03-2892-4e7f-8854-c55f3995dc94\",\"_type\":\"tableRow\",\"cells\":[\"Device (BYOD)\",\"3,000\",\"Mandatory iPad (Primary) or Laptop (Secondary).\"]},{\"_key\":\"67e242bc-5720-430e-aab0-7169fe9ad676\",\"_type\":\"tableRow\",\"cells\":[\"Canteen / Lunch\",\"4,000\",\"Optional meal plan (approx. AED 20-25 per day).\"]},{\"_key\":\"1ffcdafa-8e67-4ca6-83bf-07ffa3616747\",\"_type\":\"tableRow\",\"cells\":[\"Extracurriculars\",\"3,000\",\"Paid after-school clubs or sports squads.\"]},{\"_key\":\"dba37fc3-ac5f-41ad-bae4-f36824521ee2\",\"_type\":\"tableRow\",\"cells\":[\"Debenture\",\"20,000 - 30,000\",\"Refundable deposit required at specific schools (e.g., DC, JESS).\"]},{\"_key\":\"8362ede5-450a-4328-be9e-1a5314a273d7\",\"_type\":\"tableRow\",\"cells\":[\"TOTAL \\\"EXTRAS\\\"\",\"AED 28,000+\",\"Budget higher if a Debenture is required.\"]}]},{\"_key\":\"e142e64ed0ba\",\"_type\":\"relatedLink\",\"label\":\"Planning the School Year\",\"preText\":\"When planning admissions and travel, it helps to be aware of UAE public holidays during the school year.\",\"targetPost\":{\"_ref\":\"4a34eb7a-3040-41fa-a334-d9de1a6471b0\",\"_type\":\"reference\"}}],\"faqs\":[{\"_key\":\"6568bce39e11\",\"answer\":[{\"_key\":\"8bfa87a1925f\",\"_type\":\"block\",\"children\":[{\"_key\":\"07398d81bbf6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. Starting from the 2026-2027 academic year, the age cut-off date has shifted to \"},{\"_key\":\"4bef1981c114\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"December 31st\"},{\"_key\":\"77f891ae2a35\",\"_type\":\"span\",\"marks\":[],\"text\":\" (previously August 31st).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b3cb05a40be6\",\"_type\":\"block\",\"children\":[{\"_key\":\"93e5c83e1f9e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"For FS1 (Pre-KG):\"},{\"_key\":\"b4470bf80ea9\",\"_type\":\"span\",\"marks\":[],\"text\":\" Child must be 3 years old by Dec 31st.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d971e1cbad56\",\"_type\":\"block\",\"children\":[{\"_key\":\"1aafda943f46\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"For FS2 (KG1):\"},{\"_key\":\"931e18d918d9\",\"_type\":\"span\",\"marks\":[],\"text\":\" Child must be 4 years old by Dec 31st.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"031722f868c8\",\"_type\":\"block\",\"children\":[{\"_key\":\"3d14c3672c02\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"For Year 1 (KG2):\"},{\"_key\":\"010e7bf47ab7\",\"_type\":\"span\",\"marks\":[],\"text\":\" Child must be 5 years old by Dec 31st.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b3c9e8b9c78\",\"_type\":\"block\",\"children\":[{\"_key\":\"d2ce266d8502\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Note: This applies to schools starting in September. Schools starting in April (Indian/Pakistani curriculum) adhere to a March 31st cut-off.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Has the school entry age changed for Dubai schools in 2026?\"},{\"_key\":\"2c6b63e8a586\",\"answer\":[{\"_key\":\"8d72d945e8cf\",\"_type\":\"block\",\"children\":[{\"_key\":\"3c9757196617\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes. The UAE Ministry of Education now mandates Arabic instruction for \"},{\"_key\":\"42d7586698e0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"all students\"},{\"_key\":\"677e184e5003\",\"_type\":\"span\",\"marks\":[],\"text\":\" in private schools, starting from Kindergarten.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e98b61016cb5\",\"_type\":\"block\",\"children\":[{\"_key\":\"54aeca2b189e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"KG/Foundation Stage:\"},{\"_key\":\"fac878ca0902\",\"_type\":\"span\",\"marks\":[],\"text\":\" Schools must provide at least 4 daily lessons per week (approx. 30-40 mins each).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9ab7f7070332\",\"_type\":\"block\",\"children\":[{\"_key\":\"6ae1529a20d9\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Grade 1-9:\"},{\"_key\":\"05afab469c08\",\"_type\":\"span\",\"marks\":[],\"text\":\" Mandatory Arabic as a Second Language (ASL) for non-native speakers.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ca52d52c9e85\",\"_type\":\"block\",\"children\":[{\"_key\":\"94c86c37c22c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Grade 10-12:\"},{\"_key\":\"0470627e1b1a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Optional in some curricula (like British/IB) if the student has completed 9 years of Arabic, but many schools keep it mandatory until Year 10.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Is Arabic mandatory for non-Arab children in Dubai?\"},{\"_key\":\"4578b4a16a03\",\"answer\":[{\"_key\":\"6e874ea1b868\",\"_type\":\"block\",\"children\":[{\"_key\":\"e8a8095bf3d3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Generally, no. The KHDA is very strict about age-appropriate placement, especially for younger children (FS1 to Year 2). Demotion or promotion is rarely approved without significant evidence (e.g., a medical report or transfer from a different country's distinct education system) and must be officially sanctioned by the KHDA.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Can I transfer my child to a lower/higher grade if they are gifted?\"},{\"_key\":\"88de5692021f\",\"answer\":[{\"_key\":\"7b9e344b6176\",\"_type\":\"block\",\"children\":[{\"_key\":\"804902d8d051\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you are moving from outside Dubai, a Transfer Certificate is mandatory for admission to Year 2 (Grade 1) and upwards.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"573fa600224d\",\"_type\":\"block\",\"children\":[{\"_key\":\"a01cf443ca2e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"From UK/USA/Australia/Canada/Europe:\"},{\"_key\":\"fbd79dbbdeb5\",\"_type\":\"span\",\"marks\":[],\"text\":\" Usually only requires the school stamp and signature.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ae9c8be44b02\",\"_type\":\"block\",\"children\":[{\"_key\":\"825f913c7728\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"From India/GCC/South Africa/Other:\"},{\"_key\":\"d039704f17b1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Must be attested by the \"},{\"_key\":\"f245f76fdbfb\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Ministry of Education\"},{\"_key\":\"16ca7e059ff8\",\"_type\":\"span\",\"marks\":[],\"text\":\" in the country of origin, the \"},{\"_key\":\"bfccab844056\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Ministry of Foreign Affairs\"},{\"_key\":\"b67d5436d30c\",\"_type\":\"span\",\"marks\":[],\"text\":\" (in that country), and the \"},{\"_key\":\"bc3eb89f8f34\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"UAE Embassy\"},{\"_key\":\"a7e246495e3e\",\"_type\":\"span\",\"marks\":[],\"text\":\" there.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"What documents do I need for the \\\"Transfer Certificate\\\" (TC)?\"},{\"_key\":\"2031c351a67b\",\"answer\":[{\"_key\":\"8345fd6e9e3d\",\"_type\":\"block\",\"children\":[{\"_key\":\"1c584abf24be\",\"_type\":\"span\",\"marks\":[],\"text\":\"Following the UAE's working week change, all schools in Dubai operate on a \"},{\"_key\":\"8da691ee4cbd\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"4.5-day week\"},{\"_key\":\"e211c16a9527\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"eec460bebb48\",\"_type\":\"block\",\"children\":[{\"_key\":\"27a0d75e6e8e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Monday - Thursday:\"},{\"_key\":\"f18ac3d8d957\",\"_type\":\"span\",\"marks\":[],\"text\":\" Full school days (typically 7:45 AM – 3:00 PM).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4e4eaceaf1b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"5066c67894fe\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Friday:\"},{\"_key\":\"53f34d6e9c47\",\"_type\":\"span\",\"marks\":[],\"text\":\" Half-day (ends by 11:30 AM - 12:00 PM) to accommodate Friday prayers.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Why do Dubai schools finish early on Fridays?\"}],\"intro\":\"Stop guessing. We've ranked the top 10 schools in Dubai for 2026 based on real parent feedback, traffic realities, and the latest KHDA 'Outstanding' ratings. Find out where your money actually goes—beyond the brochure.\",\"listItems\":[{\"_key\":\"e75f8ac5f61d\",\"badgeLabel\":\"The Academic Heavyweight\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Al Sufouh Road, \\nAl Sufouh 2, \\nPO Box 837, \\nDubai, United Arab Emirates.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"British\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 97,415 – AED 110,305\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Al Sufouh\",\"mainImage\":{\"alt\":\"Dubai College campus main entrance with distinctive red brick facade.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/0ada3a9e4d93a81b4060bfa8825c5e3f55331ca0-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Admissions are highly selective; top 10-15% academic performers only.\",\"No Primary school; you need a strategic feeder school (like DESS).\",\"Morning congestion in Al Sufouh is inevitable.\",\"Mandatory Debenture: New students must pay a refundable AED 30,000 debenture.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"dubai-college\",\"specifications\":null,\"title\":\"Dubai College\",\"verdict\":\"Dubai College remains the undisputed academic champion of Dubai. It operates as a not-for-profit and is the closest thing Dubai has to an elite British grammar school.\",\"website\":\"https://www.dubaicollege.org/\"},\"rank\":1,\"whySelected\":\"Best for high-achieving students aiming for Oxbridge.\"},{\"_key\":\"25ae6f39cf6e\",\"badgeLabel\":\"The All-Rounder\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Arabian Ranches, \\nSheikh Mohammed Bin Zayed Road, \\nPO Box 24463, \\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"Dual (British / IB)\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 54,129 – AED 104,544\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Arabian Ranches\",\"mainImage\":{\"alt\":\"JESS Arabian Ranches school grounds and main sports field.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/dfbd1ce5966cca2a0cfa38a9e8ab7191d5844147-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Requires a Debenture (approx. AED 20k interest-free loan).\",\"The waitlist is massive; parents often apply at birth.\",\"Difficult to enter without corporate priority.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"jess-arabian-ranches\",\"specifications\":null,\"title\":\"JESS Arabian Ranches\",\"verdict\":\"Follows the National Curriculum for England leading to IGCSEs, but switches to the IB Diploma in Sixth Form (Years 12-13). It is known for being a broad, balanced, and nurturing environment with a strong community focus.\",\"website\":\"https://www.jess.sch.ae\"},\"rank\":2,\"whySelected\":\"Best for a British foundation leading to the global IB Diploma.\"},{\"_key\":\"0bde51a9f2fd\",\"badgeLabel\":\"The American Giant\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Hessa Street,\\nSheikh Zayed Road,\\nAl Barsha, PO Box 45111, \\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"American\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 66,185 – AED 93,300\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Al Barsha South\",\"mainImage\":{\"alt\":\"Modern glass exterior of GEMS Dubai American Academy near Hessa Street.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/39ab55b2b8e176c4d1ebdd05a802254045073fb1-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Located near notorious Hessa Street traffic; school runs can take 45+ mins.\",\"Massive campus size; shy children might feel lost in the crowd.\",\"Fees are premium for the American curriculum sector.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"gems-dubai-american-academy\",\"specifications\":null,\"title\":\"GEMS Dubai American Academy\",\"verdict\":\"The flagship American school with jaw-dropping facilities (AI studios, Olympic pools). Blends US flexibility with IB Diploma rigor.\",\"website\":\"https://www.gemsaa-dubai.com\"},\"rank\":3,\"whySelected\":\"Best facilities and broadest subject choices.\"},{\"_key\":\"de92fe0a5549\",\"badgeLabel\":\"Best Primary School\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"26th Street, \\nUmm Suqeim 3,\\nPO Box 38199, \\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"British\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 47,179 – AED 71,801\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Umm Suqeim 3\",\"mainImage\":{\"alt\":\"Kings' School Dubai playground and primary classrooms.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/2a0db614772fbf3c5d00fc65369245da2c6a0e4e-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Primary only: You must move schools after Year 6 (usually to Kings' Al Barsha).\",\"Parking is difficult; Umm Suqeim residential streets gridlock at 2:30 PM.\",\"Fees are high for a primary-only education.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"kings-school-dubai\",\"specifications\":null,\"title\":\"Kings' School Dubai\",\"verdict\":\"The only school to maintain an 'Outstanding' rating every year since inspections began. A nurturing Primary-only campus (FS1 to Year 6).\",\"website\":\"https://kings-edu.com/dubai\"},\"rank\":4,\"whySelected\":\"Best for a gentle, nurturing start to education.\"},{\"_key\":\"8ee458f0b7c8\",\"badgeLabel\":\"The IB Specialist\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Al Sufouh Area,\\nSheikh Zayed Road,\\nPO Box 37486,\\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"Dual (British / IB)\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 47,527 – AED 103,399\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Al Sufouh\",\"mainImage\":{\"alt\":\"GEMS Wellington International School main building architecture.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/fa3f4120ec67d16eb3aca1dde8fd965fbd389db8-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"One of the pricier GEMS schools.\",\"Social scene is affluent; pressure to keep up with peers' lifestyle is real.\",\"Al Sufouh traffic affects drop-off/pick-up.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"gems-wellington-international-school\",\"specifications\":null,\"title\":\"GEMS Wellington International School\",\"verdict\":\"A high-performing school that excels in the IB Diploma. Has a very \\\"international\\\" feel with high student turnover, making integration easy.\",\"website\":\"https://www.wellingtoninternationalschool.com\"},\"rank\":5,\"whySelected\":\"Best for pure IB pathway with British foundation.\"},{\"_key\":\"bf7d5fae7a82\",\"badgeLabel\":\"Luxury & Tradition\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Nad Al Sheba 3, \\nPO Box 300331, \\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"Dual (British / IB)\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 57,178 – AED 102,753\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Nad Al Sheba\",\"mainImage\":{\"alt\":\"Repton Dubai distinctive clock tower and campus entrance.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/2af446a5a5e8ae207732628b0d8cfcfd4229ffea-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Location is far from Marina/JLT areas.\",\"Academic and behavioral rigor is high; not for \\\"free spirits.\\\"\",\"Very traditional British ethos might feel stiff to some.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"repton-school-dubai\",\"specifications\":null,\"title\":\"Repton School Dubai\",\"verdict\":\"Think Harry Potter in the desert. Repton looks and acts like a British boarding school (formal uniforms, strict discipline). Great for structure.\",\"website\":\"https://www.reptondubai.org\"},\"rank\":6,\"whySelected\":\"Best for discipline and traditional boarding school values.\"},{\"_key\":\"5b977932d854\",\"badgeLabel\":\"The IB Pioneer\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"First Al Khail Street,\\nEmirates Hills,\\nPO Box 118111,\\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"IB\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 44,979 – AED 79,696\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Emirates Hills\",\"mainImage\":{\"alt\":\"Dubai International Academy Emirates Hills campus entrance.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/49473588b43e33634a5cc86fbc3c44c09dac8b8f-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Traffic getting into Emirates Hills/The Lakes is difficult during rush hour.\",\"Facilities are older compared to the newest \\\"super schools.\\\"\",\"Very large class sizes in some years.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"dubai-international-academy-emirates-hills\",\"specifications\":null,\"title\":\"Dubai International Academy Emirates Hills\",\"verdict\":\"One of the first IB schools in the UAE. It lacks the shiny glass buildings of newer schools, but has \\\"soul\\\" and a proven academic track record\",\"website\":\"https://www.diadubai.com\"},\"rank\":7,\"whySelected\":\"Best for diversity (80+ nationalities) and IB history.\"},{\"_key\":\"049d360420e8\",\"badgeLabel\":\"Best Value \\\"Outstanding\\\"\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Nad Al Sheba 3,\\nMain Avenue,\\nPO Box 53663,\\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"Dual (Indian / IB)\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 30,983 – AED 73,876\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Nad Al Sheba\",\"mainImage\":{\"alt\":\"GEMS Modern Academy sprawling campus and sports facilities.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/cd3253e3a7ecf588632c0cac3c1340c6ad83fdde-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Academic year starts in April (Indian calendar), complicating moves from UK/US schools.\",\"Workload is heavy; the dual focus requires significant commitment.\",\"Large campus population can feel overwhelming.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"gems-modern-academy\",\"specifications\":null,\"title\":\"GEMS Modern Academy\",\"verdict\":\"A unique dual-curriculum powerhouse. Primarily follows the CISCE (Indian) curriculum (ICSE/ISC) but blends it with the International Baccalaureate (IB) Programme (PYP, MYP, DP), offering the best of Indian academic rigor and international inquiry-based learning.\",\"website\":\"https://www.gemsmodernacademy-dubai.com\"},\"rank\":8,\"whySelected\":\"Best for academic rigor offering both Indian (ICSE/ISC) and IB pathways.\"},{\"_key\":\"dae68f5a7e83\",\"badgeLabel\":\"The Ultra-Premium Choice\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Nad Al Sheba,\\nMohammed Bin Rashid Al Maktoum City,\\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"IB\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 91,735 – AED 143,681\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Nad Al Sheba\",\"mainImage\":{\"alt\":\"Contemporary atrium and design of North London Collegiate School Dubai.\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/af34a37cc1e4ff8d214eeec8a4401845081fe650-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Very Good\",\"realityCheck\":[\"Eye-watering fees; among the most expensive in Dubai.\",\"Newer alumni network compared to DC or JESS.\",\"Strict academic selection process.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"north-london-collegiate-school\",\"specifications\":null,\"title\":\"North London Collegiate School\",\"verdict\":\"Brings prestigious London heritage to Dubai. Focuses on \\\"academic ambition\\\" and subject passion with elite facilities.\",\"website\":\"https://www.nlcsdubai.ae\"},\"rank\":9,\"whySelected\":\"Best for elite academic ambition and brand prestige.\"},{\"_key\":\"f0491dfa48bf\",\"badgeLabel\":\"The Community Gem\",\"customVerdict\":null,\"product\":{\"_type\":\"institution\",\"address\":\"Springs 3,\\nEmirates Hills,\\nPO Box 37428,\\nDubai, UAE.\",\"affiliateLink\":null,\"availability\":null,\"brand\":null,\"code\":null,\"cons\":null,\"country\":null,\"currency\":null,\"curriculum\":\"British\",\"customerRating\":null,\"entityType\":null,\"feeRange\":\"AED 53,027 – AED 79,541\",\"heroFeature\":null,\"keyFeatures\":null,\"location\":\"Emirates Hills\",\"mainImage\":{\"alt\":\"Dubai British School Emirates Hills courtyard and student area.  Curriculum: British\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/75878f760f1291329b999bffd305e9bdb53770b9-1200x675.webp\"},\"price\":null,\"priceTier\":null,\"pros\":null,\"rating\":\"Outstanding\",\"realityCheck\":[\"Extremely oversubscribed due to smaller size.\",\"Sports fields are smaller than the \\\"giants\\\" like Repton.\",\"Facilities are older but well-maintained.\"],\"retailer\":null,\"reviewCount\":null,\"slug\":\"dubai-british-school-emirates-hills\",\"specifications\":null,\"title\":\"Dubai British School Emirates Hills\",\"verdict\":\"A warm, tight-knit community school that feels like a village school in the city. Principals know students by name.\",\"website\":\"https://www.dubaibritishschool.ae\"},\"rank\":10,\"whySelected\":\"Best for families wanting a small, personal school feel.\"}],\"mainImage\":{\"alt\":\"Feature image for Top 10 Schools in Dubai 2026 showing diverse students in uniforms walking in front of a modern school campus\",\"url\":\"https://cdn.sanity.io/images/kxdjzy8e/production/d86dfbbe8baf0c016931ab4cd4c21b43803d71b3-1920x1080.webp\"},\"publishedAt\":\"2026-01-14T16:25:00.000Z\",\"seoDescription\":\"\",\"seoTitle\":\"Top 10 Schools in Dubai 2026: Reviews, KHDA Ratings & Fees\",\"showAffiliateDisclosure\":true,\"slug\":\"top-10-schools-dubai-2026-khda-fees-reviews\",\"title\":\"Top 10 Schools in Dubai (2026): Honest Reviews, Fees & KHDA Ratings\",\"updatedAt\":\"2026-01-24T06:51:05Z\",\"relatedLists\":[],\"relatedProducts\":[]}}]]}],\"$L34\"]}]]}]\n2c:[\"$\",\"link\",\"43\",{\"rel\":\"shortcut icon\",\"href\":\"/icon.png\"}]\n2d:[\"$\",\"link\",\"44\",{\"rel\":\"icon\",\"href\":\"/icon.png\",\"type\":\"image/png\",\"sizes\":\"192x192\"}]\n2e:[\"$\",\"link\",\"45\",{\"rel\":\"icon\",\"href\":\"/icon-v2.svg\",\"type\":\"image/svg+xml\"}]\n2f:[\"$\",\"link\",\"46\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"any\"}]\n30:[\"$\",\"link\",\"47\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png\",\"sizes\":\"180x180\",\"type\":\"image/png\"}]\n31:[\"$\",\"link\",\"48\",{\"rel\":\"mask-icon\",\"href\":\"/icon-v2.svg\",\"color\":\"#4b0082\"}]\n32:[\"$\",\"$L35\",\"49\",{}]\n34:[\"$\",\"aside\",null,{\"className\":\"w-full lg:w-80 shrink-0 space-y-8 mt-12 lg:mt-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white border border-gray-200 rounded-2xl p-6 shadow-sm relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-full translate-x-1/2 -translate-y-1/2\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 mb-4 relative z-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-14 h-14 bg-gray-50 rounded-full flex items-center justify-center overflow-hidden border-2 border-white shadow-md\",\"chil