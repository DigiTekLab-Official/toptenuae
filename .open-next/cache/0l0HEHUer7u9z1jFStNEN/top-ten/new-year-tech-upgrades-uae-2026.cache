-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"\">Haptic Feedback Controller Included</span></li></ul></div><div class=\"bg-rose-50 rounded-xl p-4 border border-rose-100\"><h3 class=\"font-bold text-rose-900 text-sm mb-2 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-x w-4 h-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m15 9-6 6\"></path><path d=\"m9 9 6 6\"></path></svg> Watch Out</h3><ul class=\"space-y-1\"><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-x w-4 h-4 text-rose-500 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m15 9-6 6\"></path><path d=\"m9 9 6 6\"></path></svg><span>No Disc Drive (Digital Games Only)</span></li><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-x w-4 h-4 text-rose-500 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m15 9-6 6\"></path><path d=\"m9 9 6 6\"></path></svg><span>Mixed Reports on Missing Game Codes</span></li><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-x w-4 h-4 text-rose-500 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m15 9-6 6\"></path><path d=\"m9 9 6 6\"></path></svg><span>825GB Usable Storage (System takes some)</span></li></ul></div></div><div class=\"mb-4 p-4 bg-slate-100 rounded-xl border border-slate-300 border-l-4 border-l-slate-600\"><div class=\"flex items-center gap-2 mb-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-info w-3 h-3 text-primary\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4\"></path><path d=\"M12 8h.01\"></path></svg><h3 class=\"text-sm font-bold text-primary uppercase tracking-widest\">Why we picked this</h3></div><p class=\"text-sm text-slate-900 font-semibold leading-relaxed italic\">&quot;<!-- -->The ultimate holiday bundle for football fans, combining the PS5 Slim Digital console with EA Sports FC—making it one of the most affordable and modern entry points into next-gen gaming.<!-- -->&quot;</p></div></div><div class=\"bg-gradient-to-r from-amber-50 to-orange-50 border-t border-amber-200 p-5\"><div class=\"flex flex-col sm:flex-row items-center justify-between gap-4\"><div class=\"flex flex-col gap-0.5 w-full sm:w-auto text-center sm:text-left\"><span class=\"text-[14px] font-black text-gray-800 uppercase tracking-tight flex items-center justify-center sm:justify-start gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"2