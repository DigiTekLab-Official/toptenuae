-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"font-semibold\">20+ hour battery life</span></li><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"font-semibold\">Beautiful 3:2 aspect ratio screen</span></li><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"\">Premium keyboard</span></li></ul></div></div><div class=\"mb-4 p-4 bg-slate-100 rounded-xl border border-slate-300 border-l-4 border-l-slate-600\"><div class=\"flex items-center gap-2 mb-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-info w-3 h-3 text-primary\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4\"></path><path d=\"M12 8h.01\"></path></svg><h3 class=\"text-sm font-bold text-primary uppercase tracking-widest\">Why we picked this</h3></div><p class=\"text-sm text-slate-900 font-semibold leading-relaxed italic\">&quot;<!-- -->This laptop finally answers the MacBook&#x27;s battery dominance. Thanks to the Snapdragon X chip, it offers 20+ hours of battery life, making it perfect for mobile professionals.<!-- -->&quot;</p></div></div><div class=\"bg-gradient-to-r from-amber-50 to-orange-50 border-t border-amber-200 p-5\"><div class=\"flex flex-col sm:flex-row items-center justify-between gap-4\"><div class=\"flex flex-col gap-0.5 w-full sm:w-auto text-center sm:text-left\"><span class=\"text-[14px] font-black text-gray-800 uppercase tracking-tight flex items-center justify-center sm:justify-start gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-tag w-4 h-4\" aria-hidden=\"true\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\"></path><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg>Approx. Price:</span><span class=\"text-2xl font-black text-emerald-700 tracking-tight\">AED 2,799</span></div><div class=\"w-full sm:w-auto transform transition-transform hover:scale-105 active:scale-95 duration-200\"><a href=\"https://amzn.to/3ZNU55l\" target=\"_blank\" rel=\"nofollow noopener\" class=\"flex items-center justify-center gap-2 w-full sm:w-auto bg-yellow-400 hover:bg-yellow-500 text-black font-bold py-3 px-8 rounded-lg shadow-sm text-center transition-colors\">Check Price on <!-- -->Amazon.ae<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" s