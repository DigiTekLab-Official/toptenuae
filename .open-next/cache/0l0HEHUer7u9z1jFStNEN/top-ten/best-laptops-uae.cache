g-white\"><td class=\"px-4 py-2 text-slate-500 font-medium w-1/3 border-r border-slate-100\">Operating System</td><td class=\"px-4 py-2 text-slate-900 font-semibold\">Windows 11 Pro</td></tr><tr class=\"bg-slate-50/30\"><td class=\"px-4 py-2 text-slate-500 font-medium w-1/3 border-r border-slate-100\">Weight</td><td class=\"px-4 py-2 text-slate-900 font-semibold\">1.81 kg</td></tr><tr class=\"bg-white\"><td class=\"px-4 py-2 text-slate-500 font-medium w-1/3 border-r border-slate-100\">Build</td><td class=\"px-4 py-2 text-slate-900 font-semibold\">MIL-STD-810H Certified Durability</td></tr></tbody></table></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\"><div class=\"bg-emerald-50 rounded-xl p-4 border border-emerald-100\"><h3 class=\"font-bold text-emerald-900 text-sm mb-2 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg> The Good</h3><ul class=\"space-y-1\"><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"font-semibold\">Best typing experience (Keyboard)</span></li><li class=\"flex items-start gap-2 text-sm text-gray-800 leading-snug\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-l