e\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-instagram w-5 h-5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"2e1cvw\",{\"width\":\"20\",\"height\":\"20\",\"x\":\"2\",\"y\":\"2\",\"rx\":\"5\",\"ry\":\"5\"}],[\"$\",\"path\",\"9exkf1\",{\"d\":\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"}],[\"$\",\"line\",\"r4j83e\",{\"x1\":\"17.5\",\"x2\":\"17.51\",\"y1\":\"6.5\",\"y2\":\"6.5\"}],\"$undefined\"]}]}]\n24:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover, user-scalable=yes\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"media\":\"(prefers-color-scheme: light)\",\"content\":\"#4b0082\"}],[\"$\",\"meta\",\"3\",{\"name\":\"theme-color\",\"media\":\"(prefers-color-scheme: dark)\",\"content\":\"#0f172a\"}]]\n2a:T1096,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://toptenuae.com/#organization\",\"name\":\"TopTenUAE\",\"alternateName\":\"Top Ten UAE\",\"url\":\"https://toptenuae.com\",\"logo\":{\"@type\":\"ImageObject\",\"@id\":\"https://toptenuae.com/#logo\",\"url\":\"https://toptenuae.com/icon.png\",\"width\":512,\"height\":512,\"caption\":\"TopTenUAE Logo\"},\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://toptenuae.com/images/brand/og-default.png\",\"width\":1200,\"height\":630},\"description\":\"Expert reviews, rankings, and smart tools for UAE residents. Your trusted guide to the best products, services, and experiences in the Emirates.\",\"foundingDate\":\"2020\",\"areaServed\":{\"@type\":\"Country\",\"name\":\"United Arab Emirates\",\"@id\":\"https://www.wikidata.org/wiki/Q878\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"Customer Service\",\"areaServed\":\"AE\",\"availableLanguage\":[\"en\",\"ar\"]},\"sameAs\":[]},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://toptenuae.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Top ten\",\"item\":\"https://toptenuae.com/top-ten\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"State of AI Dec 2025: GPT-5.2, Agentic AI & The UAE Strategy\",\"item\":\"https://toptenuae.com/top-ten/state-of-ai-december-2025-uae-report\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What are the key AI trends defining December 2025?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The end of 2025 is characterized by three pivotal shifts in the artificial intelligence landscape: The \\\"Frontier\\\" Model War: The simultaneous release of massive reasoning models, specifically GPT-5.2 (OpenAI) and Gemini 3 (Google), has reset industry benchmarks. The Rise of \\\"Agentic AI\\\": We have moved beyond chatbots to autonomous systems capable of planning and executing multi-step workflows without human intervention. Infrastructure Scaling: A rapid expansion of physical AI infrastructure, driven by custom silicon and gigawatt-scale data centers (such as the Stargate project).\"}},{\"@type\":\"Question\",\"name\":\"How is the UAE leading AI adoption in 2025?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The UAE has cemented its status as a global AI sanctuary, achieving a world-leading 97% AI adoption rate across federal government entities. Key milestones defining this leadership include: Stargate UAE: The operational launch of the 5-gigawatt AI campus in Abu Dhabi. Historic Investment: Total AI-directed investments exceeded AED 543 billion between 2024 and 2025. Sovereign Infrastructure: The expansion of localized data centers ensures data residency and security.\"}},{\"@type\":\"Question\",\"name\":\"What is Agentic AI and why does it matter for business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Agentic AI refers to autonomous agents that do not just \\\"talk\\\" but \\\"do.\\\" Unlike 2024's LLMs, which required constant prompting, 2025's agents can plan complex execution paths. Driven by frameworks like OpenAI’s AgentKit and the Model Context Protocol (MCP), these agents are now reliable enough for enterprise tasks, such as autonomous supply chain optimisation, real-time code deployment, and complex financial auditing.\"}},{\"@type\":\"Question\",\"name\":\"What is the \\\"Jais 2\\\" model mentioned in recent UAE reports?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jais 2 is the UAE's sovereign, open-weight Large Language Model (LLM), released in December 2025. Specs: A 70-billion-parameter model designed specifically for high-performance Arabic capabilities. Significance: It allows UAE enterprises to leverage top-tier AI while adhering to local cultural values and strict data privacy standards, outperforming Western models in Arabic-language nuances.\"}},{\"@type\":\"Question\",\"name\":\"Is GPT-5.2 available for enterprise use?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Following its release in early December 2025 (after OpenAI's internal \\\"code red\\\" acceleration), GPT-5.2 is now available for enterprise tenants. It offers substantial upgrades in long-context reasoning and multimodal processing, effectively becoming the new gold standard for professional automated workflows.\"}}]}]}20:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2a\"}}],\"$L2b\"]\n22:null\n26:[[\"$\",\"title\",\"0\",{\"children\":\"State of AI Dec 2025: GPT-5.2, Agentic AI & The UAE Strategy | TopTenUAE\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"From OpenAI's 'Code Red' launch of GPT-5.2 to the UAE's record-breaking 97% government adoption rate, December 2025 marks a turning point. This report...\"}],[\"$\",\"meta\",\"2\",{\"name\":\"applicatio