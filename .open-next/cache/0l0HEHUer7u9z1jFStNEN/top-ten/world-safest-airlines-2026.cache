and \\\"counting\\\" is more reliable than \\\"looking.\\\"\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"318f2c6edced\",\"_type\":\"block\",\"children\":[{\"_key\":\"66b88bbf9e20\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Listen to the Briefing:\"},{\"_key\":\"37bdd40b1487\",\"_type\":\"span\",\"marks\":[],\"text\":\" Aircraft configurations vary. Even frequent flyers should watch the safety demo to know exactly how \"},{\"_key\":\"0686aa59ea8e\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"this specific\"},{\"_key\":\"47e63d307e14\",\"_type\":\"span\",\"marks\":[],\"text\":\" plane’s doors open.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e881c2f9ed5d\",\"_type\":\"relatedLink\",\"label\":\"Best Travel Headphones for 2026\",\"preText\":\"Safety is priority #1, but comfort is #2. To block out engine noise on your next flight, see our guide to the:\",\"targetPost\":{\"_ref\":\"eee7c364-c239-4226-82f0-79b52b0aad6e\",\"_type\":\"reference\"}},{\"_key\":\"6a820f79ebca\",\"_type\":\"block\",\"children\":[{\"_key\":\"0afa792ec0a7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"}],\"faqs\":[{\"_key\":\"a9c993a2907c\",\"answer\":[{\"_key\":\"a414d1132658\",\"_type\":\"block\",\"children\":[{\"_key\":\"39e1fe961bb5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Etihad Airways (UAE) has been named the World's Safest Airline for 2026, followed closely by Qantas and Emirates.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"question\":\"Which is the safest airline in the world in 2026?\"},{\"_key\":\"559e3509e648\",\"answer\":[{\"_key\":\"a4e2b03c837d\",\"_type\":\"block\",\"children\":[{\"_key\":\"79f1cd11e546\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, absolutely. Emirates is ranked #3 globally for safety in 2026. It operates one of the world's youngest fleets and has a dedicated flight training academy in Dubai.\"}],\"markDefs\":[],