none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]}],[\"$\",\"li\",null,{\"className\":\"flex items-center min-w-0\",\"aria-current\":\"page\",\"children\":[\"$\",\"span\",null,{\"className\":\"truncate max-w-[150px] sm:max-w-[200px] md:max-w-md text-gray-900 font-semibold block\",\"title\":\"How to Clean Your Washing Machine in the UAE: The 2026 Maintenance Guide\",\"children\":\"How to Clean Your Washing Machine in the UAE: The 2026 Maintenance Guide\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row gap-8 lg:gap-5\",\"children\":[[\"$\",\"main\",null,{\"className\":\"flex-1 min-w-0 bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8\",\"children\":[[\"$\",\"header\",null,{\"className\":\"border-b border-gray-100 pb-6 mb-6\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl lg:text-4xl font-black text-gray-900 mb-4 leading-tight tracking-tight\",\"children\":\"How to Clean Your Washing Machine in the UAE: The 2026 Maintenance Guide\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center text-sm text-gray-500 gap-4\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Last Updated:\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-02-02T16:33:53Z\",\"children\":\"2 February 2026\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mt-6 relative w-full h-auto aspect-video rounded-xl overflow-hidden bg-gray-100\",\"children\":\"$L2d\"}]]}],\"$L2e\"]}],\"$L2f\"]}]]}]\n2c:[\"$\",\"$L30\",\"44\",{}]\n31:I[1398,[\"/_next/static/chunks/7871b60fc891ab96.js\",\"/_next/static/chunks/c1f3fffdf1d840b7.js\",\"/_next/static/chunks/19701a61bc0542e6.js\",\"/_next/static/chunks/c4f2d57ce4578b7e.js\",\"/_next/static/chunks/39fff9f81ea21df5.js\"],\"default\"]\n2d:[\"$\",\"$L1b\",null,{\"src\":\"https://cdn.sanity.io/images/kxdjzy8e/production/b4df67ed4b0c518cefdd76d7611f2be3d0d76517-1200x675.webp\",\"alt\":\"How to Clean Your Washing Machine | UAE Home Care Tips for Top & Front Loaders\",\"fill\":true,\"className\":\"object-cover\",\"priority\":true}]\n2e:[\"$\",\"div\",null,{\"className\":\"max-w-4xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-xl md:text-2xl font-medium text-slate-700 leading-relaxed mb-10 border-l-4 border-[#4b0082] pl-6\",\"children\":[\"$\",\"$L31\",null,{\"value\":\"Updated for 2026: Hard water and humidity in the UAE can ruin your machine. Here is the essential maintenance routine to banish odours and limescale for good.\"}]}],false,[\"$\",\"article\",null,{\"className\":\"prose prose-lg prose-slate max-w-none  prose-headings:font-bold prose-headings:text-slate-900  prose-a:text-[#4b0082] prose-a:font-bold hover:prose-a:text-amber-500  prose-img:rounded-2xl prose-img:shadow-md\",\"children\":[\"$\",\"$L31\",null,{\"value\":[{\"_key\":\"7169baf4c115\",\"_type\":\"block\",\"children\":[{\"_key\":\"b18117654b15\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Introduction:\"},{\"_key\":\"4f862754c4a8\",\"_type\":\"span\",\"marks\":[],\"text\":\" A clean washing machine is non-negotiable in the UAE, where hard water, fine dust, and high humidity create the perfect storm for limescale, mould, and unpleasant odours. This updated 2026 guide provides you with a clear, effective maintenance routine to ensure your machine runs efficiently, your clothes smell fresh, and your appliance lasts longer.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3cacda27466a\",\"_type\":\"block\",\"children\":[{\"_key\":\"e4289aa16842\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why Cleaning is Critical in the UAE\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"099660877b1b\",\"_type\":\"block\",\"children\":[{\"_key\":\"464eeb38d597\",\"_type\":\"span\",\"marks\":[],\"text\":\"Your washing machine works harder here than in many other parts of the world.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a53a239b6525\",\"_type\":\"block\",\"children\":[{\"_key\":\"f47f25fe8419\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Hard Water:\"},{\"_key\":\"2b631492f9e7\",\"_type\":\"span\",\"marks\":[],\"text\":\" Rich in calcium and magnesium, it leaves behind \"},{\"_key\":\"f818275f26cb\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"limescale\"},{\"_key\":\"3a2d5217e92d\",\"_type\":\"span\",\"marks\":[],\"text\":\" that clogs pipes and reduces heating efficiency.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"34f1fb706131\",\"_type\":\"block\",\"children\":[{\"_key\":\"e7cb005fb3fa\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Humidity:\"},{\"_key\":\"659450e4e825\",\"_type\":\"span\",\"marks\":[],\"text\":\" Encourages \"},{\"_key\":\"dd85d01e8533\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"mould and mildew\"},{\"_key\":\"faba19808e17\",\"_type\":\"span\",\"marks\":[],\"text\":\" to thrive, especially in the hidden rubber seals of front-loaders.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"47a275692f4f\",\"_type\":\"block\",\"children\":[{\"_key\":\"e78c0a99c985\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The Result:\"},{\"_key\":\"f9d806c22145\",\"_type\":\"span\",\"marks\":[],\"text\":\" Musty smells, dingy clothes, and higher utility bills. A regular clean is the simplest fix.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"119d22bd4f77\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"5bbc330ff8fa\",\"_type\":\"block\",\"children\":[{\"_key\":\"1a6ac38555af\",\"_type\":\"span\",\"marks\":[],\"text\":\"Your UAE Cleaning Schedule\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"dd8f094fee1a\",\"_type\":\"block\",\"children\":[{\"_key\":\"607d3653934d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Adopt this proactive schedule to prevent problems before they start:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"44cb69db62f1\",\"_type\":\"block\",\"children\":[{\"_key\":\"76610eb34c71\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"After Every Wash:\"},{\"_key\":\"9be1fedc594a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Leave the door and dispenser drawer open. (Prevents mould).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"aada28580201\",\"_type\":\"block\",\"children\":[{\"_key\":\"35a5d0844b03\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Weekly:\"},{\"_key\":\"f3bccad61f36\",\"_type\":\"span\",\"marks\":[],\"text\":\" Wipe the door seal (rubber gasket) to remove trapped water and lint.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"222eb87b4efb\",\"_type\":\"block\",\"children\":[{\"_key\":\"c87b87776d98\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Monthly:\"},{\"_key\":\"733c6afb6666\",\"_type\":\"span\",\"marks\":[],\"text\":\" Clean the detergent dispenser drawer to remove sludge.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fda45209421a\",\"_type\":\"block\",\"children\":[{\"_key\":\"022c04ffc9c0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Every 2 Months:\"},{\"_key\":\"67c2d2a6e5dc\",\"_type\":\"span\",\"marks\":[],\"text\":\" Run a \\\"Maintenance Wash\\\" (Method 1 below).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"dcc77eda9384\",\"_type\":\"block\",\"children\":[{\"_key\":\"48285e32538a\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Every 6 Months:\"},{\"_key\":\"9ac41d624310\",\"_type\":\"span\",\"marks\":[],\"text\":\" Clean the Drain Pump Filter to remove sand and coins.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1a335a0cc9bc\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"8e8c3a423fc8\",\"_type\":\"image\",\"alt\":\"How to Clean a Top-Loading Washing Machine- tools- White vinegar, Baking soda, Microfiber cloth\",\"asset\":{\"_ref\":\"image-e201feca9dc4d7eec69bbb4a0b40c50666c4a1d4-800x450-webp\",\"_type\":\"reference\"},\"caption\":\"Washing Machine: DYI Cleaning Tool\",\"display\":\"right\"},{\"_key\":\"c27719a92eb1\",\"_type\":\"block\",\"children\":[{\"_key\":\"faa4ae71bf36\",\"_type\":\"span\",\"marks\":[],\"text\":\"Method 1: The Essential Monthly Maintenance Wash\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"c55c9465493e\",\"_type\":\"block\",\"children\":[{\"_key\":\"e7dc88cc0040\",\"_type\":\"span\",\"marks\":[],\"text\":\"This is your baseline clean using natural, readily available ingredients.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1f866971d42c\",\"_type\":\"block\",\"children\":[{\"_key\":\"f528876fbb4f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Empty the Machine:\"},{\"_key\":\"65d70de4bad6\",\"_type\":\"span\",\"marks\":[],\"text\":\" Ensure the drum is completely empty of laundry.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c9ae2bea0c7e\",\"_type\":\"block\",\"children\":[{\"_key\":\"f33c6dcc4ba6\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Add Cleaning Agent:\"},{\"_key\":\"b35c545658b3\",\"_type\":\"span\",\"marks\":[],\"text\":\" Pour \"},{\"_key\":\"6127b6aefdc3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2 cups of white vinegar\"},{\"_key\":\"a5e6bf4b623f\",\"_type\":\"span\",\"marks\":[],\"text\":\" directly into the drum. Vinegar is excellent at dissolving mineral (limescale) and soap residue.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a97864dc99c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"64b552e0ab22\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Run a Hot Cycle:\"},{\"_key\":\"0dc3928eca5c\",\"_type\":\"span\",\"marks\":[],\"text\":\" Set the machine to the \"},{\"_key\":\"2d8673cbfbea\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"hottest, longest wash cycle\"},{\"_key\":\"41cc43ad4ca3\",\"_type\":\"span\",\"marks\":[],\"text\":\" (e.g., \\\"Cotton\\\" at 60-90°C).\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3dcc17e41017\",\"_type\":\"block\",\"children\":[{\"_key\":\"63679d1916e8\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Front-Loader Tip:\"},{\"_key\":\"0dcb83d56a9b\",\"_type\":\"span\",\"marks\":[],\"text\":\" Add \"},{\"_key\":\"7cafad60d524\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"½ cup of baking soda\"},{\"_key\":\"7eae9cdc9895\",\"_type\":\"span\",\"marks\":[],\"text\":\" to the detergent drawer for extra deodorizing power.\"}],\"level\":2,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9a947334c3ed\",\"_type\":\"block\",\"children\":[{\"_key\":\"f26eab70e361\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Final Rinse & Dry:\"},{\"_key\":\"5ffd2724fbe1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Once the cycle is complete, wipe the inside of the drum and door seal with a dry cloth. Leave the door wide open to air out.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bd8b6395bc92\",\"_type\":\"block\",\"children\":[{\"_key\":\"80ec95cca149\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"311927677dcc\",\"_type\":\"block\",\"children\":[{\"_key\":\"d9e08d121191\",\"_type\":\"span\",\"marks\":[],\"text\":\"Method 2: The Quarterly Deep Clean\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"54f1f8c316db\",\"_type\":\"block\",\"children\":[{\"_key\":\"86dbf5ce551a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Every 3-4 months, or if you notice strong odours, give your machine a thorough treatment.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"41efb22a19c7\",\"_type\":\"block\",\"children\":[{\"_key\":\"acaf5ede9166\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1. Clean the Detergent Dispenser\"},{\"_key\":\"d9e8cca9000c\",\"_type\":\"span\",\"marks\":[],\"text\":\" Over time, old powder and fabric softener turn into a black, mouldy sludge inside the drawer housing.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5b3a7ee4501b\",\"_type\":\"block\",\"children\":[{\"_key\":\"4227094eb48b\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9273fd443ff5\",\"_type\":\"block\",\"children\":[{\"_key\":\"011ea35deb3b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Kitchen Upgrade: \"},{\"_key\":\"80ba32cc7105\",\"_type\":\"span\",\"marks\":[],\"text\":\"While you are tackling chores in the kitchen, why not upgrade your cooking setup? Check out our top picks for the \"},{\"_key\":\"5a368a95b4f4\",\"_type\":\"span\",\"marks\":[\"strong\",\"1455d82e0996\"],\"text\":\"Best Air Fryers in UAE (2026)\"},{\"_key\":\"1de64d0c4e47\",\"_type\":\"span\",\"marks\":[],\"text\":\": The Ultimate Buyer’s Guide & Maintenance Tip\"},{\"_key\":\"4311a29b9bd5\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"s\"}],\"markDefs\":[{\"_key\":\"1455d82e0996\",\"_type\":\"link\",\"href\":\"https://toptenuae.com/top-ten/best-air-fryers-uae-2026/\"}],\"style\":\"blockquote\"},{\"_key\":\"0b746d6eb9cc\",\"_type\":\"block\",\"children\":[{\"_key\":\"a216bd4860d5\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f944972a3e4d\",\"_type\":\"image\",\"alt\":\"Washin Machine Detergent Dispenser Cleaning\",\"asset\":{\"_ref\":\"image-00bbef4c614e002f01b22805a21994c32289b820-800x450-webp\",\"_type\":\"reference\"},\"caption\":\"Old detergent buildup can cause blockages and smells.\",\"display\":\"left\"},{\"_key\":\"3e6e178a9d54\",\"_type\":\"block\",\"children\":[{\"_key\":\"c0d1936d1daf\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Remove the Drawer:\"},{\"_key\":\"2927909189f1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Press the release tab (usually blue) and pull the drawer completely out.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"95ec3217b291\",\"_type\":\"block\",\"children\":[{\"_key\":\"c32810fe1417\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Scrub:\"},{\"_key\":\"b668d9b2222f\",\"_type\":\"span\",\"marks\":[],\"text\":\" Soak it in hot soapy water and scrub away the black residue with an old toothbrush.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"43d2610edf22\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b1b8a722d22\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Clean the Cavity:\"},{\"_key\":\"911e5552231c\",\"_type\":\"span\",\"marks\":[],\"text\":\" Don't forget to wipe the inside of the slot where the drawer sits—this is often where mould hides.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b79f897032c\",\"_type\":\"separator\",\"style\":\"gap\"},{\"_key\":\"15339c8e19c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"3ab166d0e37e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2. Clean the Drain Pump Filter\"},{\"_key\":\"c726cdc2a3d2\",\"_type\":\"span\",\"marks\":[],\"text\":\" This is the most critical step for preventing leaks and \\\"E18\\\" drainage errors. In the UAE, this filter often gets clogged with fine sand and lint.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c14f9bb2bdc6\",\"_type\":\"image\",\"alt\":\"Washing machine cleaning: Unscrew the filter (usually located at the bottom front) and rinse out debris.\",\"asset\":{\"_ref\":\"image-1958cd0ce4cedc166140ba316d31d0941434ef17-800x450-webp\",\"_type\":\"reference\"},\"caption\":\"Always have a tray ready to catch the water when opening the filter.\",\"display\":\"full\"},{\"_key\":\"c4ba06168d20\",\"_type\":\"block\",\"children\":[{\"_key\":\"022a0286fd7c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Locate:\"},{\"_key\":\"d8b99b9e45e1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Find the small door at the bottom right of your machine.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"858601776bad\",\"_type\":\"block\",\"children\":[{\"_key\":\"005be86cba57\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Drain:\"},{\"_key\":\"cc908f5b38d3\",\"_type\":\"span\",\"marks\":[],\"text\":\" Place a shallow tray or towel underneath. Open the small drain hose (if available) to release excess water.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e150206b0d9a\",\"_type\":\"block\",\"children\":[{\"_key\":\"882e8b021bc1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Unscrew:\"},{\"_key\":\"9280d8ee8f09\",\"_type\":\"span\",\"marks\":[],\"text\":\" Turn the filter cap anti-clockwise. Be prepared for a gush of water.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1b1c20cb304e\",\"_type\":\"block\",\"children\":[{\"_key\":\"16727fb7b2bb\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Clean:\"},{\"_key\":\"442e6e0feb6d\",\"_type\":\"span\",\"marks\":[],\"text\":\" Remove any coins, buttons, hair, or sand. Rinse the filter under a tap and screw it back in tightly.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"64a42c128d58\",\"_type\":\"block\",\"children\":[{\"_key\":\"44169cb2c130\",\"_type\":\"span\",\"marks\":[],\"text\":\"Method 3: For Stubborn Mould or Limescale\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"828186184330\",\"_type\":\"block\",\"children\":[{\"_key\":\"89559afd9690\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you see black mould spots or significant white scaling, stronger action is needed.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"947a098265b3\",\"_type\":\"block\",\"children\":[{\"_key\":\"ef6b5197e341\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"For Mould:\"},{\"_key\":\"1e535503188f\",\"_type\":\"span\",\"marks\":[],\"text\":\" Use a solution of \"},{\"_key\":\"c63be2d30765\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1 part chlorine bleach to 10 parts water\"},{\"_key\":\"3d3f4701a853\",\"_type\":\"span\",\"marks\":[],\"text\":\". Apply only to the affected mouldy areas with a cloth. \"},{\"_key\":\"95e93c392829\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Never mix bleach with vinegar\"},{\"_key\":\"c2324e51ec77\",\"_type\":\"span\",\"marks\":[],\"text\":\", as it creates toxic gas. Rinse thoroughly.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a775f687ca9c\",\"_type\":\"block\",\"children\":[{\"_key\":\"3a52578cc6ee\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"For Heavy Limescale:\"},{\"_key\":\"dc0cc41dbdc1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Use a \"},{\"_key\":\"e5dcfe41dd91\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"citric acid-based washing machine cleaner\"},{\"_key\":\"e6ca0c359684\",\"_type\":\"span\",\"marks\":[],\"text\":\". Citric acid is highly effective against UAE hard water scale.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1997dc993d4e\",\"_type\":\"relatedLink\",\"label\":\"Smart Shopper Tip\",\"preText\":\"Buying specialized descaling agents or cleaning supplies? Make sure you calculate the exact total cost using our:\",\"targetPost\":{\"_ref\":\"dcc33432-46ed-4553-b709-554ff8596a03\",\"_type\":\"reference\"}},{\"_key\":\"6872d02b6d79\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c74355c0de2\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d6d8e21e0fe6\",\"_type\":\"block\",\"children\":[{\"_key\":\"eeb27c84108c\",\"_type\":\"span\",\"marks\":[],\"text\":\"UAE-Specif