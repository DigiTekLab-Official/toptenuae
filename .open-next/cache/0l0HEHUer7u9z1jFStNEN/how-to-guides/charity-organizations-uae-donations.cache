\":\"block\",\"children\":[{\"_key\":\"3a8489bfb268\",\"_type\":\"span\",\"marks\":[\"strong\",\"aa5ac8ecd0fa\"],\"text\":\"Authority of Social Contribution – Ma’an\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"aa5ac8ecd0fa\",\"_type\":\"link\",\"href\":\"https://maan.gov.ae/en/\"}],\"style\":\"normal\"},{\"_key\":\"6b303228e7b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"34f1c0fdcd58\",\"_type\":\"span\",\"marks\":[\"strong\",\"27339d5298c7\"],\"text\":\"Abu Dhabi Social Support Authority\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"27339d5298c7\",\"_type\":\"link\",\"href\":\"https://www.ssa.gov.ae/\"}],\"style\":\"normal\"},{\"_key\":\"241ce90075a7\",\"_type\":\"block\",\"children\":[{\"_key\":\"2ca31f0a7cee\",\"_type\":\"span\",\"marks\":[\"strong\",\"27c9aecc5a60\"],\"text\":\"Jood – Dubai’s Community Contributions Platform\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"27c9aecc5a60\",\"_type\":\"link\",\"href\":\"https://jood.ae/home\"}],\"style\":\"normal\"},{\"_key\":\"be64ab3ffa8e\",\"_type\":\"block\",\"children\":[{\"_key\":\"a67971715772\",\"_type\":\"span\",\"marks\":[],\"text\":\"Reputable UAE Charity Organizations Accepting Online Donations\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"e10268185836\",\"_type\":\"block\",\"children\":[{\"_key\":\"bf767b5e1444\",\"_type\":\"span\",\"marks\":[],\"text\":\"The following organizations are well-established and allow online donations through their websites:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f09d2581d299\",\"_type\":\"block\",\"children\":[{\"_key\":\"9cf896d0bdef\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. \"},{\"_key\":\"8ba40a92f873\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Emirates Red Crescent\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"0193143df1b4\",\"_type\":\"block\",\"children\":[{\"_key\":\"0583faab6a89\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Mission\"},{\"_key\":\"cdc0a315d