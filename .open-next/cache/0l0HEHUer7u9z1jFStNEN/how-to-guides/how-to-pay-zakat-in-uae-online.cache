\"max-w-4xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-xl md:text-2xl font-medium text-slate-700 leading-relaxed mb-10 border-l-4 border-[#4b0082] pl-6\",\"children\":[\"$\",\"$Lf\",null,{\"value\":\"Zakat is a key pillar of Islam, and the UAE offers secure digital channels to fulfill this duty. This guide covers how to calculate your contribution, pay online via the Zakat Fund or DubaiNow, and details the eligibility criteria for those seeking financial assistance.\"}]}],false,[\"$\",\"article\",null,{\"className\":\"prose prose-lg prose-slate max-w-none  prose-headings:font-bold prose-headings:text-slate-900  prose-a:text-[#4b0082] prose-a:font-bold hover:prose-a:text-amber-500  prose-img:rounded-2xl prose-img:shadow-md\",\"children\":[\"$\",\"$Lf\",null,{\"value\":[{\"_key\":\"30b1cced3e39\",\"_type\":\"block\",\"children\":[{\"_key\":\"7994451d389c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Understanding Zakat in the UAE\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"6264771f00da\",\"_type\":\"block\",\"children\":[{\"_key\":\"c3f1f9b6230c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Paying Zakat is one of the five pillars of Islam, a mandatory charitable contribution for those who meet the wealth criteria (Nisab). In the UAE, the \"},{\"_key\":\"cf7ed44c7f22\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Zakat Fund\"},{\"_key\":\"124f264faa81\",\"_type\":\"span\",\"marks\":[],\"text\":\" is the specialized government authority responsible for collecting and distributing Zakat to deserving beneficiaries in accordance with Sharia law.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"720327e236d9\",\"_type\":\"block\",\"children\":[{\"_key\":\"ca5b1083fa55\",\"_type\":\"span\",\"marks\":[],\"text\":\"Before making a payment, ensure you know the exact amount due. You can easily \"},{\"_key\":\"3612f7c3ae7e\",\"_type\":\"span\",\"marks\":[\"strong\",\"b619df408727\"],\"text\":\"calculate your Zakat here\"},{\"_key\":\"9f1088106c30\",\"_type\":\"span\",\"marks\":[],\"text\":\" to ensure accuracy.\"}],\"markDefs\":[{\"_key\":\"b619df408727\",\"_type\":\"link\",\"href\":\"https://toptenuae.com/finance-tools/zakat-calculator/\"}],\"style\":\"normal\"},{\"_key\":\"4263a7b4057a\",\"_type\":\"block\",\"children\":[{\"_key\":\"076ca68a9c97\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Eligibility Guide: Who Needs to Pay vs. Who Can Receive\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"8696f5c37bd4\",\"_type\":\"block\",\"children\":[{\"_key\":\"ba3716d6b415\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1. Eligibility to Pay Zakat (The Payer)\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"0ed303c9bc2f\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c23db62e584\",\"_type\":\"span\",\"marks\":[],\"text\":\"You are obligated to pay Zakat if you meet the following conditions:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"66b09c3b5b38\",\"_type\":\"block\",\"children\":[{\"_key\":\"044680a04673\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Muslim:\"},{\"_key\":\"efe1312c3999\",\"_type\":\"span\",\"marks\":[],\"text\":\" Zakat is a religious duty for Muslims.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"186c15a9fa5f\",\"_type\":\"block\",\"children\":[{\"_key\":\"74784c80fe85\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Nisab (Minimum Wealth):\"},{\"_key\":\"223fa3593f10\",\"_type\":\"span\",\"marks\":[],\"text\":\" Your wealth (cash, gold, silver, business assets) must exceed the \"},{\"_key\":\"c50034d9206e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Nisab threshold\"},{\"_key\":\"a82048a7dff1\",\"_type\":\"span\",\"marks\":[],\"text\":\" (equivalent to 85g of gold).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"437e22fb13d6\",\"_type\":\"block\",\"children\":[{\"_key\":\"1c48c616f12e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Hawl (Duration):\"},{\"_key\":\"5d526d79ff25\",\"_type\":\"span\",\"marks\":[],\"text\":\" You must have held this wealth for one full lunar year.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8764c6030445\",\"_type\":\"block\",\"children\":[{\"_key\":\"b1ce9a2335b6\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Rate:\"},{\"_key\":\"d8f94b44b86c\",\"_type\":\"span\",\"marks\":[],\"text\":\" The standard rate is \"},{\"_key\":\"c60efec71397\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2.5%\"},{\"_key\":\"5564ce46a3af\",\"_type\":\"span\",\"marks\":[],\"text\":\" of your total savings/wealth.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1f0534ccf34a\",\"_type\":\"block\",\"children\":[{\"_key\":\"c2b58cd0f3f9\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2. Eligibility to Receive Zakat (The Beneficiary)\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"d82532525387\",\"_type\":\"block\",\"children\":[{\"_key\":\"41b49018fe73\",\"_type\":\"span\",\"marks\":[],\"text\":\"To apply for Zakat assistance in the UAE, you must fall into one of the eligible categories defined by Sharia and UAE regulations. Common eligible groups include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a63726b4a68f\",\"_type\":\"block\",\"children\":[{\"_key\":\"b5fbbaea99ef\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Low-Income Families:\"},{\"_key\":\"210dd24b1c71\",\"_type\":\"span\",\"marks\":[],\"text\":\" Households where the total income does not cover basic needs (rent, food, education).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"65dd725572a6\",\"_type\":\"block\",\"children\":[{\"_key\":\"251c1d7dd196\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Orphans & Widows:\"},{\"_key\":\"6f461aee04d1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Individuals who have lost their primary breadwinner and lack financial support.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7e1aa4f37f21\",\"_type\":\"block\",\"children\":[{\"_key\":\"ceca91be445d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"People of Determination:\"},{\"_key\":\"fa8b23009820\",\"_type\":\"span\",\"marks\":[],\"text\":\" Individuals with disabilities requiring medical or financial aid.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4b6c53c2534d\",\"_type\":\"block\",\"children\":[{\"_key\":\"b16e1e29f58f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The Unemployed:\"},{\"_key\":\"cf5f89501a6f\",\"_type\":\"span\",\"marks\":[],\"text\":\" Residents seeking work who cannot meet daily expenses.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"05510de0273a\",\"_type\":\"block\",\"children\":[{\"_key\":\"99b1711d46d3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Debtors:\"},{\"_key\":\"bfd317bf1501\",\"_type\":\"span\",\"marks\":[],\"text\":\" Individuals facing legal or financial crises due to unmanageable debt (excluding loans for luxury items).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"48d12f4c8652\",\"_type\":\"block\",\"children\":[{\"_key\":\"04fd2248b87b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Students:\"},{\"_key\":\"cfaed987471f\",\"_type\":\"span\",\"marks\":[],\"text\":\" \\\"Needy Student\\\" projects support those unable to pay tuition fees.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3c65bb50a7b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"e84fa0322608\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Patients:\"},{\"_key\":\"69a3e7e4c4b8\",\"_type\":\"span\",\"marks\":[],\"text\":\" Those unable to afford critical medical treatments.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"59086d3a1646\",\"_type\":\"block\",\"children\":[{\"_key\":\"0d417c0da7ee\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Required Documents for Application\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"87a4ae9d68dd\",\"_type\":\"block\",\"children\":[{\"_key\":\"281702816db2\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you plan to apply for assistance, you must prepare digital copies of the following documents to prove your eligibility:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d52d25ef8f18\",\"_type\":\"block\",\"children\":[{\"_key\":\"b33ac42b3a99\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Valid Emirates ID:\"},{\"_key\":\"a1f98261a115\",\"_type\":\"span\",\"marks\":[],\"text\":\" Front and back copies for all family members.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e75ed1dd28f0\",\"_type\":\"block\",\"children\":[{\"_key\":\"c4719e7a2139\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Proof of Income:\"},{\"_key\":\"9a6bb9f78151\",\"_type\":\"span\",\"marks\":[],\"text\":\" Latest Salary Certificate. If unemployed, a letter from the court or labor department is required.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c4addd6b6275\",\"_type\":\"block\",\"children\":[{\"_key\":\"32f42e2e45a1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Bank Statements:\"},{\"_key\":\"4f983ff3c7d1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Official statements for the last 3 to 6 months.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a7f6913cca79\",\"_type\":\"block\",\"children\":[{\"_key\":\"eaf9f1fe0812\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Residency Proof:\"},{\"_key\":\"61f7b22476c2\",\"_type\":\"span\",\"marks\":[],\"text\":\" Valid Tenancy Contract and Electricity Bill (DEWA/SEWA).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e49af9b8ff49\",\"_type\":\"block\",\"children\":[{\"_key\":\"3d34f24a1a5b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Supporting Documents:\"},{\"_key\":\"36cc5f389d3a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Specific papers depending on your case (e.g., Medical report, Divorce certificate, Death certificate of guardian).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c9258b079a5a\",\"_type\":\"relatedLink\",\"label\":\"Free Tool\",\"preText\":\"Not sure exactly how much you owe? Use our instant tool to get the precise figure:\",\"targetPost\":{\"_ref\":\"9bbedecd-3927-468f-af00-93c9691884ac\",\"_type\":\"reference\"}},{\"_key\":\"4d8a771180c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"90cafcfbf786\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Official Channels to Pay Zakat Online\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"a4be151c1ff3\",\"_type\":\"block\",\"children\":[{\"_key\":\"f840f97a03f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The UAE government provides several digital platforms to make paying Zakat fast, secure, and transparent:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a7a2f2d73026\",\"_type\":\"block\",\"children\":[{\"_key\":\"7ad322ad40dd\",\"_type\":\"span\",\"marks\":[\"strong\",\"d97cd6e32869\"],\"text\":\"Zakat Fund Website\"},{\"_key\":\"cbbacc8c68d9\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\":\"},{\"_key\":\"993607fafb4a\",\"_type\":\"span\",\"marks\":[],\"text\":\" The primary portal for calculation and payment.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[{\"_key\":\"d97cd6e32869\",\"_type\":\"link\",\"href\":\"https://www.awqaf.gov.ae/zakatPayment\"}],\"style\":\"normal\"},{\"_key\":\"b8f19c695a24\",\"_type\":\"block\",\"children\":[{\"_key\":\"87acdaca7fa7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"DubaiNow App:\"},{\"_key\":\"3c538135679a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Under the \\\"Donations\\\" or \\\"Islam\\\" section, you can pay Zakat directly.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e5796c23bb98\",\"_type\":\"block\",\"children\":[{\"_key\":\"d6f332b247e8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Zaki Platform:\"},{\"_key\":\"ba6b7b15952e\",\"_type\":\"span\",\"marks\":[],\"text\":\" A smart electronic platform for easy Zakat payments.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"61a94a86be4d\",\"_type\":\"block\",\"children\":[{\"_key\":\"9ff5190e2a05\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Bank Apps:\"},{\"_key\":\"72a41341ff8b\",\"_type\":\"span\",\"marks\":[],\"text\":\" Most major UAE banks (ADCB, ENBD, DIB) have a \\\"Zakat Fund\\\" payment option in their bill payment section.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cadbf552e9b0\",\"_type\":\"block\",\"children\":[{\"_key\":\"4db732c54f4b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"AWQAF Portal:\"},{\"_key\":\"05f89da27ed4\",\"_type\":\"span\",\"marks\":[],\"text\":\" You can also pay directly via the General Authority of Islamic Affairs and Endowments at \"},{\"_key\":\"a2bc2d09e29a\",\"_type\":\"span\",\"marks\":[\"strong\",\"3aa9ba0997fd\"],\"text\":\"Awqaf Zakat Payment\"},{\"_key\":\"b8acb58c2521\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[{\"_key\":\"3aa9ba0997fd\",\"_type\":\"link\",\"href\":\"https://www.awqaf.gov.ae/zakatPayment\"}],\"style\":\"normal\"},{\"_key\":\"cf684e569522\",\"_type\":\"relatedLink\",\"label\":\"Where to Donate\",\"preText\":\"You can distribute your Zakat directly to trusted causes. Browse our list of registered:\",\"targetPost\":{\"_ref\":\"d5f94261-1084-4d3c-86c1-da0c0066cd7b\",\"_type\":\"reference\"}},{\"_key\":\"9d1981b039ea\",\"_type\":\"block\",\"children\":[{\"_key\":\"54e83d50bec2\",\"_type\":\"span\",\"marks\":[\"strong\"],