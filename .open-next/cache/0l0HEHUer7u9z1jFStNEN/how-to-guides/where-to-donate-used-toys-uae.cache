:\"normal\"},{\"_key\":\"73dd3b79292c\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"7f2ec059499e\",\"_type\":\"block\",\"children\":[{\"_key\":\"46267f799a55\",\"_type\":\"span\",\"marks\":[],\"text\":\"Where to Donate Toys in Sharjah\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"8c773038e49d\",\"_type\":\"block\",\"children\":[{\"_key\":\"21082313ff4b\",\"_type\":\"span\",\"marks\":[],\"text\":\"6. Dar Al Ber Society\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ea3e0541bf85\",\"_type\":\"block\",\"children\":[{\"_key\":\"55c4a27703d9\",\"_type\":\"span\",\"marks\":[\"em\",\"strong\"],\"text\":\"Best for\"},{\"_key\":\"ad7033c32c86\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\": Neighborhood drop-offs.\"},{\"_key\":\"57a7d8bc770e\",\"_type\":\"span\",\"marks\":[],\"text\":\" A prominent charity running social welfare programs across the UAE. They are heavily active in Sharjah and the Northern Emirates, accepting toy donations to support low-income families.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2382cec27d87\",\"_type\":\"block\",\"children\":[{\"_key\":\"da7fc2ca7e9d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"How to Donate:\"},{\"_key\":\"6f89bdf07572\",\"_type\":\"span\",\"marks\":[],\"text\":\" Drop off at their ubiquitous donation bins in residential areas or arrange a pickup for bulk items.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0a86d6d60e3e\",\"_type\":\"block\",\"children\":[{\"_key\":\"54e9db4094d2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Website:\"},{\"_key\":\"7bf7f85aa4ef\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"ce3eb250907c\",\"_type\":\"span\",\"marks\":[\"8f8744772885\"],\"text\":\"daralber.ae\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"8f8744772885\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.daralber.ae/ar/home\"}],\"style\":\"normal\"},{\"_key\":\"f4eeacd1cb90\",\"_type\":\"block\",\"children\":[{\"_key\":\"b8a0f1b5ace7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"7. Sharjah Charity International\"},{\"_key\":\"843580dac0db\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"e941667ea0b3\",\"_type\":\"block\",\"children\":[{\"_key\":\"790337afa789\",\"_type\":\"span\",\"marks\":[\"em\",\"strong\"],\"text\":\"Best for\"},{\"_key\":\"7143b3d3baef\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\": Northern Emirates distribution.\"},{\"_key\":\"a8c873c189ce\",\"_type\":\"span\",\"marks\":[],\"text\":\" They play an active role in assisting orphans and families in distress. Toys are always welcome to bring smiles to children during Eid and holidays.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"759813d759f6\",\"_type\":\"block\",\"children\":[{\"_key\":\"db62e9845703\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"How to Donate:\"},{\"_key\":\"01b4bd8dc202\",\"_type\":\"span\",\"marks\":[],\"text\":\" Visit their main collection centers in Sharjah.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"136d5399f5d7\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb4c2d036895\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Website:\"},{\"_key\":\"61adf5d53366\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"6dd328895ee9\",\"_type\":\"span\",\"marks\":[\"dbdddc747369\"],\"text\":\"shjc.sharjah.ae\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"dbdddc747369\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://shjc.sharjah.ae\"}],\"style\":\"normal\"},{\"_key\":\"76e7e794890f\",\"_type\":\"block\",\"children\":[{\"_key\":\"aca4976c28a0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"8. The Big Heart Foundation (TBHF)\"},{\"_key\":\"90e8ecb91cbd\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"e214b8391fa7\",\"_type\":\"block\",\"children\":[{\"_key\":\"94cd160e3c76\",\"_type\":\"span\",\"marks\":[\"em\",\"strong\"],\"text\":\"Best for\"},{\"_key\":\"dda8f4131ed5\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\": Crisis relief.\"},{\"_key\":\"5a06d3922019\",\"_type\":\"span\",\"marks\":[],\"text\":\" Focused on refugees and children in crisis zones. They occasionally run specific drives for educational materials and comfort toys.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"49e7723c863c\",\"_type\":\"block\",\"children\":[{\"_key\":\"fd62c91906bf\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"How to Donate:\"},{\"_key\":\"4143e21b2eef\",\"_type\":\"span\",\"marks\":[],\"text\":\" Check their social media for specific \\\"Toy Drive\\\" announcements before dropping off.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"67f63f9de06b\",\"_type\":\"block\",\"children\":[{\"_key\":\"469ee145b3cd\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Website:\"},{\"_key\":\"b6642d2718c8\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"e4e625b9429d\",\"_type\":\"span\",\"marks\":[\"4ad93bac47a3\"],\"text\":\"tbhf.ae\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"4ad93bac47a3\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.tbhf.ae\"}],\"style\":\"normal\"},{\"_key\":\"0a9529e5290b\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"5b6c8927e69f\",\"_type\":\"block\",\"children\":[{\"_key\":\"ab240f898de1\",\"_type\":\"span\",\"marks\":[],\"text\":\"How to Prepare Your Toys for Donation\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"bf84f825255b\",\"_type\":\"block\",\"children\":[{\"_key\":\"7b18e3c5a014\",\"_type\":\"span\",\"marks\":[],\"text\":\"Don't just dump a bag of broken plastic. Follow these rules to ensure your donation is actually helpful:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b2d43bfd3edc\",\"_type\":\"block\",\"children\":[{\"_key\":\"e2070687900c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Cleanliness is Key:\"},{\"_key\":\"d2345e2a74d6\",\"_type\":\"span\",\"marks\":[],\"text\":\" Wipe down plastic toys with disinfectant. Wash soft toys if possible.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"56d53c3ceafb\",\"_type\":\"block\",\"children\":[{\"_key\":\"d9ae15281449\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Check for Parts:\"},{\"_key\":\"4b86faf94daa\",\"_type\":\"span\",\"marks\":[],\"text\":\" Ensure puzzles and board games have all their pieces. A puzzle with a missing piece is frustration, not a gift.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6b38f886824a\",\"_type\":\"block\",\"children\":[{\"_key\":\"7777ee3a9d81\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Sort by Age:\"},{\"_key\":\"a76f3826714e\",\"_type\":\"span\",\"marks\":[],\"text\":\" Bag baby toys separate from LEGOs or board games. This helps charities distribute them faster.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"aa76d86ef14d\",\"_type\":\"block\",\"children\":[{\"_key\":\"ccc2b8c64105\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Power Check:\"},{\"_key\":\"2e16174327e7\",\"_type\":\"span\",\"marks\":[],\"text\":\" If it needs batteries, remove the old dead ones to prevent leakage.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"db2bd9ffa670\",\"_type\":\"block\",\"children\":[{\"_key\":\"f810a2b06be9\",\"_type\":\"span\",\"marks\":[],\"text\":\"As children grow, many families also reassess schooling options. If you’re planning ahead, you might find value in exploring \"},{\"_key\":\"9f7274bd4275\",\"_type\":\"span\",\"marks\":[\"strong\",\"056b36be12b9\"],\"text\":\"the top schools in Dubai for 2026\"},{\"_key\":\"e054e3437040\",\"_type\":\"span\",\"marks\":[],\"text\":\" while decluttering toys and kids’ items.\"}],\"markDefs\":[{\"_key\":\"056