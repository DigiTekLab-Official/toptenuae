"],\"text\":\"does not include VAT\"},{\"_key\":\"e4c9f0834e45\",\"_type\":\"span\",\"marks\":[],\"text\":\" and you want to calculate the VAT amount and total price.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b2234b27b764\",\"_type\":\"block\",\"children\":[{\"_key\":\"b09407fefdf7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Select “Remove VAT”\"},{\"_key\":\"259f68b3f473\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nChoose this option if your price \"},{\"_key\":\"996c238c752d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"already includes VAT\"},{\"_key\":\"fc2f178afed4\",\"_type\":\"span\",\"marks\":[],\"text\":\" and you want to find the VAT portion and net amount.\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fd0082b30164\",\"_type\":\"block\",\"children\":[{\"_key\":\"f2b84b4c4735\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"View results instantly\"},{\"_key\":\"fba47bd77bee\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nThe calculator will instantly display the \"},{\"_key\":\"790e55aab4ef\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"VAT amount\"},{\"_key\":\"19b5e25e3479\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"7218b02f5117\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"final total\"},{\"_key\":\"1617172f897d\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a3c638ab7094\",\"_type\":\"block\",\"children\":[{\"_key\":\"be4f918cdcad\",\"_type\":\"span\",\"marks\":[],\"text\":\"This tool is useful for \"},{\"_key\":\"b9ee141d7168\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"business owners, freelancers, shoppers, and accountants\"},{\"_key\":\"a1efb414199c\",\"_type\":\"span\",\"marks\":[],\"text\":\" who need quick VAT calculations without manual formulas.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d0d5de37cfaf\",\"_type\":\"block\",\"children\":[{\"_key\":\"68a8ff5fde58\",\"_type\":\"span\",\"marks\":[],\"text\":\"What Is VAT in the UAE?\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"03efb8130fc2\",\"_type\":\"block\",\"children\":[{\"_key\":\"9e1d8356a349\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT (Value Added Tax) in the UAE is an \"},{\"_key\":\"fe42ee5b4eb0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"indirect tax\"},{\"_key\":\"907aecb7ee4d\",\"_type\":\"span\",\"marks\":[],\"text\":\" applied to most goods and services sold in the country. It is collected at each stage of the supply chain and ultimately paid by the \"},{\"_key\":\"9bb649d8e7c7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"final consumer\"},{\"_key\":\"018f5cf58421\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"252f18b31dc7\",\"_type\":\"block\",\"children\":[{\"_key\":\"e46963d173eb\",\"_type\":\"span\",\"marks\":[],\"text\":\"The UAE introduced VAT to diversify government revenue while keeping tax rates relatively low compared to global standards. VAT is regulated by the \"},{\"_key\":\"a9115fb532c0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Federal Tax Authority (FTA)\"},{\"_key\":\"27e774835a72\",\"_type\":\"span\",\"marks\":[],\"text\":\", which oversees registration, compliance, and reporting.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cc1b7dc34879\",\"_type\":\"block\",\"children\":[{\"_key\":\"91060f96c3e4\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT applies to most everyday transactions, including retail purchases, professional services, and digital products, with certain supplies treated as \"},{\"_key\":\"62d730d6b48e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"zero-rated or exempt\"},{\"_key\":\"bb7a9a376a05\",\"_type\":\"span\",\"marks\":[],\"text\":\" under UAE tax law.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b21112241544\",\"_type\":\"block\",\"children\":[{\"_key\":\"45a1ad00e900\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT in the UAE is regulated by the \"},{\"_key\":\"a277a13827c5\",\"_type\":\"span\",\"marks\":[\"strong\",\"5cc97670bad3\"],\"text\":\"Federal Tax Authority (FTA)\"},{\"_key\":\"89981a4cba72\",\"_type\":\"span\",\"marks\":[],\"text\":\", which defines how VAT is applied, collected, and reported across the country.\"}],\"markDefs\":[{\"_key\":\"5cc97670bad3\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://tax.gov.ae/en/taxes/vat.aspx\"}],\"style\":\"normal\"},{\"_key\":\"dc8464b2b63f\",\"_type\":\"block\",\"children\":[{\"_key\":\"216cc745f47f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Who Must Charge VAT in the UAE?\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"0cbe09862559\",\"_type\":\"block\",\"children\":[{\"_key\":\"477dab18461a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Businesses and individuals must charge VAT if they are \"},{\"_key\":\"102197631e13\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"registered or required to register\"},{\"_key\":\"4cfdc945e1de\",\"_type\":\"span\",\"marks\":[],\"text\":\" with the \"},{\"_key\":\"371579d04bb4\",\"_type\":\"span\",\"marks\":[\"a29662e4be0a\"],\"text\":\"Federal Tax Authority (FTA)\"},{\"_key\":\"8ab95465a7a4\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"a29662e4be0a\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://tax.gov.ae/en/taxes/Vat/vat.topics/what.is.vat.aspx\"}],\"style\":\"normal\"},{\"_key\":\"9af897a6f02a\",\"_type\":\"block\",\"children\":[{\"_key\":\"8b78b51ff3d7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Typically, VAT registration becomes mandatory when taxable supplies exceed the \"},{\"_key\":\"29785b9f43e9\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"FTA’s mandatory registration threshold\"},{\"_key\":\"3190bc0f81f0\",\"_type\":\"span\",\"marks\":[],\"text\":\". Once registered, the business must:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f26de4409a72\",\"_type\":\"block\",\"children\":[{\"_key\":\"82f6dfe8078e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Charge VAT on eligible goods and services\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c8a2fa0e87a\",\"_type\":\"block\",\"children\":[{\"_key\":\"92105adf6c49\",\"_type\":\"span\",\"marks\":[],\"text\":\"Issue tax-compliant invoices\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ae8f3c5319bc\",\"_type\":\"block\",\"children\":[{\"_key\":\"b2782880f54c\",\"_type\":\"span\",\"marks\":[],\"text\":\"File VAT returns within the required timelines\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"04f7dc8ed2ef\",\"_type\":\"block\",\"children\":[{\"_key\":\"29c7183a398d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Some businesses may register \"},{\"_key\":\"505f338280ce\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"voluntarily\"},{\"_key\":\"bb8240c8f41c\",\"_type\":\"span\",\"marks\":[],\"text\":\", even if they are below the mandatory threshold, to improve compliance and credibility.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1791f189b068\",\"_type\":\"block\",\"children\":[{\"_key\":\"af29c3c2235e\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b1f1f126f765\",\"_type\":\"block\",\"children\":[{\"_key\":\"7cfc02e123f3\",\"_type\":\"span\",\"marks\":[],\"text\":\"⚠️ Registration requirements depend on turnover, activity type, and FTA regulations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"121a1d105081\",\"_type\":\"block\",\"children\":[{\"_key\":\"d81d9a1fae2a\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4fb58bf77288\",\"_type\":\"block\",\"children\":[{\"_key\":\"90ff5afd22e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"How to Calculate 5% VAT in the UAE\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"8ef52ea2aee8\",\"_type\":\"block\",\"children\":[{\"_key\":\"2dcc17648f0a\",\"_type\":\"span\",\"marks\":[],\"text\":\"The United Arab Emirates introduced Value Added Tax (VAT) at a standard rate of \"},{\"_key\":\"621336a6f6ab\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"5%\"},{\"_key\":\"aa8e3fa59388\",\"_type\":\"span\",\"marks\":[],\"text\":\" under the Federal Tax Authority (FTA). This calculator helps you comply accurately with VAT-inclusive and VAT-exclusive pricing.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a44fb3697c5\",\"_type\":\"infoCards\",\"cards\":[{\"_key\":\"b0a6c580b3e1\",\"description\":\"Used when pricing goods.\\n\\nAmount × 1.05 = Total\\n\\nExample: 100 × 1.05 = AED 105\",\"title\":\"Adding VAT (Exclusive)\",\"variant\":\"amber\"},{\"_key\":\"f04e85beb882\",\"description\":\"How to calculate VAT from the total amount.\\n\\nTotal ÷ 1.05 = Base\\n\\nExample: 105 ÷ 1.05 = AED 100\",\"title\":\"Reverse VAT (Inclusive)\",\"variant\":\"purple\"}]},{\"_key\":\"a3dff1ebbf25\",\"_type\":\"table\",\"rows\":[{\"_key\":\"12a5c3c2-0f42-4456-8cd6-0ef166b2c19b\",\"_type\":\"tableRow\",\"cells\":[\"Goal\",\"Excel Formula\",\"Example (Cell A1 = 100)\"]},{\"_key\":\"ad504312-91f8-478c-9a29-e4e78b075fb7\",\"_type\":\"tableRow\",\"cells\":[\"Calculate VAT Amount only\",\"=A1 * 0.05\",\"5.00\"]},{\"_key\":\"ac644e76-16e5-437d-b139-81a9feb59273\",\"_type\":\"tableRow\",\"cells\":[\"Calculate Total (with VAT)\",\"=A1 * 1.05\",\"105.00\"]},{\"_key\":\"0c4652e5-b057-4431-a096-2d0096d6e031\",\"_type\":\"tableRow\",\"cells\":[\"Remove VAT (Reverse)\",\"=A1 / 1.05\",\"95.24\"]}]},{\"_key\":\"8bb20d53798e\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"990a05a6a707\",\"_type\":\"block\",\"children\":[{\"_key\":\"6d7a325994f6\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT for Freelancers & Small Businesses\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"e1fab6d02b37\",\"_type\":\"block\",\"children\":