key\":\"b000095d9cca\",\"_type\":\"block\",\"children\":[{\"_key\":\"717ae01fc5f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT is added on top of the base amount\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b0261ab07b11\",\"_type\":\"block\",\"children\":[{\"_key\":\"5f342690cb2f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Common in B2B invoices\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8fc3040ee6b4\",\"_type\":\"block\",\"children\":[{\"_key\":\"3d9b43d4a832\",\"_type\":\"span\",\"marks\":[],\"text\":\"Example:\\nIf a service costs AED 1,000 (exclusive), VAT is added to calculate the final amount.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b630741e14e\",\"_type\":\"block\",\"children\":[{\"_key\":\"079f41a7bca9\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT-Inclusive Price\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"a352c9dcdffc\",\"_type\":\"block\",\"children\":[{\"_key\":\"d42d8f7d07e5\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT is \"},{\"_key\":\"6cb3000fb3f9\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"already included\"},{\"_key\":\"1176db449286\",\"_type\":\"span\",\"marks\":[],\"text\":\" in the price\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6dd7228d627f\",\"_type\":\"block\",\"children\":[{\"_key\":\"be7128e4bf3f\",\"_type\":\"span\",\"marks\":[],\"text\":\"The VAT portion must be extracted\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"05de3ab809c6\",\"_type\":\"block\",\"children\":[{\"_key\":\"5c907b5a2841\",\"_type\":\"span\",\"marks\":[],\"text\":\"Common in retail pricing\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f9696c061a95\",\"_type\":\"block\",\"children\":[{\"_key\":\"7ac38e12f5cd\",\"_type\":\"span\",\"marks\":[],\"text\":\"Example:\\nIf a product costs AED 1,050 (inclusive), the VAT amount is part of that total.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c3bca817f15c\",\"_type\":\"block\",\"children\":[{\"_key\":\"b9471df59845\",\"_type\":\"span\",\"marks\":[],\"text\":\"This UAE VAT Calculator supports \"},{\"_key\":\"6ccd93254164\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"both scenarios\"},{\"_key\":\"a0681da138a2\",\"_type\":\"span\",\"marks\":[],\"text\":\", eliminating the need for manual formulas.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0514f07993b\",\"_type\":\"separator\",\"style\":\"line\"},{\"_key\":\"aa745932e528\",\"_type\":\"block\",\"children\":[{\"_key\":\"4cbdee449938\",\"_type\":\"span\",\"marks\":[],\"text\":\"Important VAT Disclaimer\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"70bc14fd3efb\",\"_type\":\"block\",\"children\":[{\"_key\":\"31a2dc2caf01\",\"_type\":\"span\",\"marks\":[],\"text\":\"This calculator is provided for \"},{\"_key\":\"4a9c938440b2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"general informational purposes only\"},{\"_key\":\"34c7198a51d7\",\"_type\":\"span\",\"marks\":[],\"text\":\" and does not constitute tax, legal, or financial advice.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"97d14030dafb\",\"_type\":\"block\",\"children\":[{\"_key\":\"812f4916d3ba\",\"_type\":\"span\",\"marks\":[],\"text\":\"VAT rules and registration requirements are governed by the \"},{\"_key\":\"54537c58c1c5\",\"_type\":\"span\",\"marks\":[\"strong\",\"4253c1692c96\"],\"text\":\"Federal Tax Authority (FTA)\"},{\"_key\":\"210aafa8a6dc\",\"_type\":\"span\",\"marks\":[],\"text\":\" and may change over time. For official guidance, compliance confirmation, or complex tax situations, consult the FTA or a licensed tax professional in the UAE.\"}],\"markDefs\":[{\"_key\":\"4253c1692c96\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://tax.gov.ae/en/default.aspx\"}],\"style\":\"normal\"}]}]}],\"$L31\",\"$L32\"]}]]}]\n33:I[48845,[\"/_next/static/chunks/7871b60fc891ab96.js\",\"/_next/static/chunks/c1f3fffdf1d840b7.js\",\"/_next/static/chunks/19701a61bc0542e6.js\",\"/_next/static/chunks/c4f2d57ce4578b7e.js\",\"/_next/static/chunks/39fff9f81ea21df5.js\"],\"default\"]\n31:[\"$\",\"div\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-900 mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"$L33\",null,{\"items\":[{\"_key\":\"0d389f3360d0\",\"answer\":\"VAT in UAE is calculated at a standard rate of 5%. To add VAT, multiply your amount by 0.05. To get the total price (Gross), multiply the original amount by 1.05.\\n\\n\",\"question\":\"How is VAT calculated in UAE?\"},{\"_key\":\"246f1142be14\",\"answer\":\"5% VAT in Dubai is the same as the federal UAE tax. It applies to most goods and services, including food, electronics, and consulting. If you buy an item for AED 100, you will pay AED 5 in tax.\",\"question\":\"What is 5% VAT in Dubai?\"},{\"_key\":\"69981508c314\",\"answer\":\"To calculate VAT in Excel: 1) For exclusive tax, use the formula '=A1*0.05'. 2) For inclusive tax (extracting VAT), use the formula '=A1-(A1/1.05)'.\",\"question\":\"How to calculate UAE VAT in Excel?\"},{\"_key\":\"531884cbf553\",\"answer\":\"To calculate the pre-tax price from a total amount (reverse calculation), divide the total by 1.05. For example: 105 ÷ 1.05 = 100.\",\"question\":\"How to calculate VAT from total amount?\"}],\"title\":\"Frequently Asked Questions\",\"icon\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark w-6 h-6 text-primary\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\"