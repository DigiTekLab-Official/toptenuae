nization\"},\"inLanguage\":\"en-AE\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://toptenuae.com/images/brand/og-default.png\",\"width\":1200,\"height\":630}},{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"@id\":\"https://toptenuae.com/finance-tools/zakat-calculator#tool\",\"name\":\"UAE Zakat Calculator 2026\",\"description\":\"\",\"url\":\"https://toptenuae.com/finance-tools/zakat-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web Browser, Android, iOS\",\"isAccessibleForFree\":true,\"author\":{\"@type\":\"Organization\",\"@id\":\"https://toptenuae.com/#organization\"},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://toptenuae.com/#organization\"},\"featureList\":[\"Gold & Silver Nisab calculation\",\"Cash & assets 2.5% Zakat rate\",\"Islamic Shariah compliant\",\"Live gold prices (Dubai)\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"AED\",\"availability\":\"https://schema.org/InStock\"},\"image\":[\"https://toptenuae.com/images/brand/og-default.png\"],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://toptenuae.com/#webpage\"}},{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the current Nisab in UAE?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nisab is the minimum wealth required to pay Zakat. It is equivalent to 85 grams of 24K Gold. As of 2026, if your savings exceed the gold value threshold (approx. AED 25,000 - 30,000 depending on daily rates), you are eligible to pay Zakat.\"}},{\"@type\":\"Question\",\"name\":\"How to calculate Zakat on Gold?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Determine the weight of your gold in grams. Multiply the weight by the current scrap gold price per gram. If the total value exceeds Nisab, pay 2.5% of that total value.\"}},{\"@type\":\"Question\",\"name\":\"Can I deduct debts from Zakat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, you can deduct immediate debts (due within the lunar year) from your total assets before calculating Zakat. Long-term loans (like a 20-year mortgage) are generally not deducted in full—consult a scholar.\"}},{\"@type\":\"Question\",\"name\":\"Is Zakat calculated on Income or Savings?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Zakat is calculated on *accumulated savings* held for one full lunar year (Hawl), not on your monthly salary/income.\"}}]}]}20:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2a\"}}],\"$L2b\"]\n22:null\n26:[[\"$\",\"title\",\"0\",{\"children\":\"UAE Zakat Calculator 2026 | TopTenUAE\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Calculate your 2.5% Zakat accurately using the latest UAE gold prices. Suitable for savings, investments, and business assets.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"application-name\",\"content\":\"TopTenUAE\"}],[\"$\",\"link\",\"3\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"UAE calculator,free tool UAE,online calculator Dubai\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"TopTenUAE Editorial Team\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"TopTenUAE\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"9\",{\"name\":\"category\",\"content\":\"finance-tools\"}],[\"$\",\"meta\",\"10\",{\"name\":\"article:publisher\",\"content\":\"https://toptenuae.com\"}],[\"$\",\"meta\",\"11\",{\"name\":\"article:published_time\",\"content\":\"2025-12-24T14:55:58Z\"}],[\"$\",\"meta\",\"12\",{\"name\":\"article:modified_time\",\"content\":\"2026-01-01T03:55:39Z\"}],[\"$\",\"link\",\"13\",{\"rel\":\"canoni