).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bbb5f06ddc6c\",\"_type\":\"infoCards\",\"cards\":[{\"_key\":\"870147572f0a\",\"description\":\"Nisab = 85 grams of 24K Gold\\n\\nExample: If Gold is AED 300/g,\\nNisab = 85 x 300 = AED 25,500\",\"title\":\"The Gold Standard\",\"variant\":\"purple\"},{\"_key\":\"60ccb080e254\",\"description\":\"Total Assets - Liabilities = Net Wealth\\n\\nZakat Payable = Net Wealth x 2.5%\",\"title\":\"The Calculation\",\"variant\":\"blue\"}]},{\"_key\":\"d456268498e3\",\"_type\":\"block\",\"children\":[{\"_key\":\"111076763327\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Note:\"},{\"_key\":\"06b39d457c8c\",\"_type\":\"span\",\"marks\":[],\"text\":\" This calculator follows the standard 2.5% rate. For specific scenarios (like livestock or agricultural produce), please consult a qualified Islamic scholar.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"43111334932b\",\"_type\":\"relatedLink\",\"label\":\"Next Step\",\"preText\":\"Now that you have calculated your amount, read our guide on official payment channels:\",\"targetPost\":{\"_ref\":\"70c36b63-0eeb-4b7d-bac0-1de42abca8ac\",\"_type\":\"reference\"}}]}]}],[\"$\",\"div\",null,{\"className\":\"mt-12 pt-8 border-t border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-900 mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"$L31\",null,{\"items\":[{\"_key\":\"5c9a98aa2ad9\",\"answer\":\"Nisab is the minimum wealth required to pay Zakat. It is equivalent to 85 grams of 24K Gold. As of 2026, if your savings exceed the gold value threshold (approx. AED 25,000 - 30,000 depending on daily rates), you are eligible to pay Zakat.\\n\",\"question\":\"What is the current Nisab in UAE?\"},{\"_key\":\"3b7f94180392\",\"answer\":\"Determine the weight of your gold in grams. Multiply the weight by the current scrap gold price per gram. If the total value exceeds Nisab, pay 2.5% of that total value.\\n\",\"question\":\"How to calculate Zakat on Gold?\"},{\"_key\":\"da5d53511806\",\"answer\":\"Yes, you can deduct immediate debts (due within the lunar year) from your total assets before calculating Zakat. Long-term loans (like a 20-year mortgage) are generally not deducted in full—consult a scholar.\\n\",\"question\":\"Can I deduct debts from Zakat?\"},{\"_key\":\"548ba1c65a63\",\"answer\":\"Zakat is calculated on *accumulated savings* held for one full lunar year (Hawl), not on your monthly salary/income.\\n\",\"question\":\"Is Zakat calculated on Income or Savings?\"}],\"title\":\"Frequently Asked Questions\",\"icon\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark w-6 h-6 text-primary\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}]}]]}],\"$L32\"]}]]}]\n32:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-slate-100 pt-10\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-slate-900 mb-6\",\"children\":\"More UAE Finance Tools\"}],[\"$\",\"div\",null,{\"className\":\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\",\"children\":[[\"$\",\"$L1a\",\"gratuity\",{\"href\":\"/finance-tools/gratuity-calculator-uae\",\"className\":\"group flex items-center gap-4 p-5 rounded-2xl border transition-all hover:shadow-md bg-amber-50 text-amber-700 border-amber-200 hover:border-amber-400\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-white/60 p-3 rounded-xl backdrop-blur-sm\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"v