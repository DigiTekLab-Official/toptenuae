# TopTenUAE Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control (add to .gitignore)

# =============================================================================
# PUBLIC VARIABLES (Visible to Browser) - Must start with NEXT_PUBLIC_
# =============================================================================

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id-here"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Google Analytics & GTM
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Cloudflare Turnstile (Bot Protection) - Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAxx..."

# Microsoft Clarity (Analytics)
NEXT_PUBLIC_CLARITY_ID="your-clarity-id"

# Base URL (for generating email confirmation links)
# Use http://localhost:3000 for local development
# Use https://toptenuae.com for production
NEXT_PUBLIC_BASE_URL="https://toptenuae.com"

# Sentry Error Tracking (Optional but recommended for production)
NEXT_PUBLIC_SENTRY_DSN="https://your-key@sentry.io/your-project-id"

# =============================================================================
# PRIVATE SECRETS (Server-Side Only) - NEVER expose these to the browser
# =============================================================================

# JWT Secret for email token generation
# Generate with: openssl rand -hex 32
JWT_SECRET="your-secret-key-here"

# Cloudflare Turnstile Secret Key
TURNSTILE_SECRET_KEY="0x4AAAAAxx..."

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxx"

# ISR Revalidation Secret (for on-demand cache invalidation)
# Generate with: openssl rand -hex 32
# Used by Sanity webhooks to trigger content revalidation
REVALIDATE_SECRET="your-revalidation-secret-here"

# =============================================================================
# FEATURE FLAGS - Control feature availability
# =============================================================================

# Product Features
FEATURE_NEW_CARD=false
FEATURE_PRODUCT_COMPARISON=false
FEATURE_AMAZON_SYNC=false

# UI/UX Features
FEATURE_NEWSLETTER_POPUP=false
FEATURE_BREADCRUMBS=true
FEATURE_TESTIMONIALS=false

# Performance Features
FEATURE_IMAGE_OPT=true
FEATURE_LAZY_LOADING=true

# Analytics & Tracking
FEATURE_GTM=false
FEATURE_CLARITY=false
FEATURE_EVENT_TRACKING=false

# Advanced Features
FEATURE_ADVANCED_SEARCH=false
FEATURE_WISHLIST=false
FEATURE_USER_REVIEWS=false

# Experimental Features
FEATURE_REACT_QUERY=true
FEATURE_NEW_LAYOUT=false
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Sanity Write Token (for syncing/updating content)
SANITY_WRITE_TOKEN="sanity_write_xxxxx"

# Amazon Product Advertising API (Optional - required only if using Amazon deals)
AMAZON_ACCESS_KEY="your-access-key"
AMAZON_SECRET_KEY="your-secret-key"
AMAZON_PARTNER_TAG="toptenuae-20"

# =============================================================================
# DEPLOYMENT-SPECIFIC NOTES
# =============================================================================
# 
# For Cloudflare Pages deployment:
# 1. Set these environment variables in Cloudflare Dashboard
# 2. Go to: Pages > Settings > Environment variables
# 3. Add Production and Preview environment sets
#
# For local development:
# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. Restart dev server: pnpm dev
#
# Security Best Practices:
# - NEVER commit .env.local to Git
# - Rotate JWT_SECRET periodically
# - Use strong, unique TURNSTILE_SECRET_KEY
# - Restrict API keys to required services only
# - Use separate keys for staging/production
