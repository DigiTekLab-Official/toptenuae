---
// src/pages/thank-you.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank You! | Top Ten UAE"
  description="Subscription confirmed."
  noIndex={true}
>
  <div class="min-h-screen bg-gray-50">

    <!-- HERO SECTION -->
    <section class="bg-primary text-white pt-20 pb-32 px-4 text-center rounded-b-[3rem] relative overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 py-1 px-3 rounded-full bg-green-500/20 text-green-500 border border-green-500/30 text-xs font-bold uppercase tracking-wider mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Success
        </span>
        <h1 class="text-4xl md:text-6xl font-black mb-6 tracking-tight leading-tight">
          You are <span class="text-yellow-400">Officially In!</span>
        </h1>
        <p class="text-lg md:text-xl text-indigo-50 max-w-2xl mx-auto pb-10 font-medium leading-relaxed">
          Welcome to the inner circle. You've just taken the first step towards smarter shopping in the UAE.
        </p>
      </div>
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <circle cx="0" cy="0" r="40" fill="white" />
          <circle cx="100" cy="100" r="40" fill="white" />
        </svg>
      </div>
    </section>

    <!-- FLOATING CONTENT CARD -->
    <div class="max-w-2xl mx-auto px-4 -mt-24 pb-20 relative z-10">
      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden p-8 md:p-12 text-center">

        <!-- Icon -->
        <div class="w-24 h-24 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto mb-8">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>

        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Thank You for Subscribing!
        </h2>
        <p class="text-gray-600 mb-10 max-w-lg mx-auto">
          We are thrilled to have you. We've sent a little welcome gift to your inbox.
        </p>

        <!-- Next Steps Box -->
        <div class="bg-blue-50/50 border border-blue-100 rounded-2xl p-6 md:p-8 text-left mb-10 mx-auto max-w-xl">
          <h3 class="font-bold text-blue-900 mb-6 flex items-center gap-2 text-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            What happens next?
          </h3>

          <div class="space-y-4">
            <div class="flex gap-4">
              <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">1</div>
              <div>
                <p class="font-bold text-gray-900">Check your inbox</p>
                <p class="text-base text-gray-600">We've sent a confirmation email to verify your address.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">2</div>
              <div>
                <p class="font-bold text-gray-900">Mark as "Safe"</p>
                <p class="text-base text-gray-600">Move us to your Primary tab so you don't miss the deals.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="flex flex-col items-center gap-4">
          <a href="/" class="group relative inline-flex items-center gap-2 bg-primary text-white font-bold py-4 px-4 rounded-xl hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 hover:shadow-primary/40 transform hover:-translate-y-1">
            Start Browsing Deals
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <p class="text-base text-gray-700">
            Did not receive email? Check your Spam/Junk folder.<a href="/subscribe" class="underline hover:text-gray-600 pl-2">Try again</a>
          </p>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>
