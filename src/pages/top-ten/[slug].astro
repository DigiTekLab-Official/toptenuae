---
// src/pages/top-ten/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { TOP_TEN_LIST_QUERY } from '@/sanity/lib/queries';
import { generateSchema } from '@/lib/schemaGenerator';
import ArticleView from '@/components/views/ArticleView';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404', 404);

let data: any = null;
try {
  data = await client.fetch(TOP_TEN_LIST_QUERY, { slug });
} catch (error) {
  console.error(`Error fetching top-ten list [${slug}]:`, error);
}

if (!data) {
  // Commit 2a: legacy /top-ten/{product} → canonical /reviews/{product}.
  // GSC shows a 404 cluster where old /top-ten/{slug} URLs point at slugs that
  // are actually live products (canonical at /reviews/{slug}). Probe ONLY for an
  // exact product with this slug — scoped to _type == "product" so a cross-type
  // slug collision (howTo/holiday/tool/etc.) can never trigger this redirect.
  let productId: string | null = null;
  try {
    productId = await client.fetch(
      `*[_type == "product" && slug.current == $slug][0]._id`,
      { slug }
    );
  } catch (error) {
    console.error(`Error probing product for top-ten slug [${slug}]:`, error);
  }
  if (productId) {
    return Astro.redirect(`/reviews/${slug}`, 301);
  }
  // No exact product → preserve existing null-list behavior unchanged.
  return Astro.redirect('/404', 404);
}

// Issue 4 fix: type guard — if a non-topTenList doc somehow resolves here
// (e.g. slug collision from a future content type), redirect to 404 rather
// than rendering with a wrong schema. Preserves all existing valid behaviour
// since TOP_TEN_LIST_QUERY is already scoped to _type == "topTenList".
if (data._type && data._type !== 'topTenList') {
  return Astro.redirect('/404');
}

// Issue 1 fix: _type fallback corrected to 'topTenList' so the schema
// dispatcher routes to generateTopTenListSchema (case 'toptenlist') instead
// of generateArticleSchema (case 'article') when _type is unexpectedly absent.
const schemaData = generateSchema(
  {
    ...data,
    slug: { current: slug },
    _type: data._type || 'topTenList',
  },
  'top-ten',
  slug
);

// Issue 3 fix: derive base URL from environment variable so staging/preview
// environments don't emit a hardcoded production canonical.
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://toptenuae.com';
const canonicalUrl = `${baseUrl}/top-ten/${slug}`;

// Issue 2 fix: prefer Sanity seo{} block fields before falling back to
// top-level seoTitle / seoDescription, then data.intro for description.
const seoTitle =
  data.seo?.metaTitle ||
  data.seoTitle ||
  data.title;

const seoDescription =
  data.seo?.metaDescription ||
  data.seoDescription ||
  data.intro ||
  '';

const transformedData = {
  ...data,
  listItems: data.listItems || [],
  relatedLists: data.relatedLists || [],
  relatedProducts: data.relatedProducts || [],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  ogImage={data.mainImage?.url}
  jsonLd={schemaData}
>
  <ArticleView data={transformedData} category="top-ten" slug={slug} client:load />
</BaseLayout>