---
// src/pages/top-ten/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';

const SECTIONS_CONFIG: Record<string, { title: string; color: string; bg: string }> = {
  'tech': { title: 'Tech & Gadgets', color: 'text-blue-600', bg: 'bg-blue-50' },
  'home-kitchen': { title: 'Home & Kitchen', color: 'text-emerald-600', bg: 'bg-emerald-50' },
  'parenting': { title: 'Parenting & Baby', color: 'text-pink-600', bg: 'bg-pink-50' },
  'health': { title: 'Health & Fitness', color: 'text-teal-600', bg: 'bg-teal-50' },
  'beauty': { title: 'Beauty & Grooming', color: 'text-purple-600', bg: 'bg-purple-50' },
  'travel': { title: 'Travel & Hotels', color: 'text-sky-600', bg: 'bg-sky-50' },
  'lifestyle': { title: 'Lifestyle & Places', color: 'text-indigo-600', bg: 'bg-indigo-50' },
};

let featured: any[] = [];
let grouped: Record<string, any[]> = {};

try {
  featured = await client.fetch(`
    *[_type == "topTenList" && isFeaturedReview == true] | order(_updatedAt desc) [0...8] {
      _id, title, "slug": slug.current,
      "categorySlug": coalesce(category->slug.current, categories[0]->slug.current, "top-ten"),
      "imageUrl": mainImage.asset->url
    }
  `);

  const lists = await client.fetch(`
    *[_type == "topTenList"] | order(_createdAt desc) {
      _id, title, "slug": slug.current,
      "categorySlug": coalesce(category->slug.current, categories[0]->slug.current),
      "section": reviewSection,
      "imageUrl": mainImage.asset->url
    }
  `);

  Object.keys(SECTIONS_CONFIG).forEach(key => grouped[key] = []);
  lists.forEach((item: any) => {
    if (grouped[item.section]) grouped[item.section].push(item);
  });
} catch (error) {
  console.error('Error fetching top-ten data:', error);
}
---

<BaseLayout
  title="Top 10 Lists & Buying Guides UAE | Best of UAE Ranked"
  description="Discover the best products and services in the UAE. Unbiased Top 10 lists for Tech, Home, Parenting, and more, updated for 2026."
  canonical="https://toptenuae.com/top-ten"
>
  <div class="min-h-screen bg-slate-50 font-sans pb-20">
    {/* HERO */}
    <div class="relative bg-[#4b0082] text-white py-12 px-4 text-center overflow-hidden lg:py-12">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-amber-400/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-purple-500/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <div class="flex justify-center mb-6">
          <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300 text-sm font-bold uppercase tracking-wider">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            Official Rankings 2026
          </span>
        </div>
        <h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
          Featured Buying Guides <br class="hidden md:block" />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-amber-200 to-amber-400">Best of UAE</span>
        </h1>
        <p class="text-lg md:text-base text-purple-100 max-w-2xl mx-auto leading-relaxed">
          We compare products for UAE shoppers and explain the evidence behind each ranking.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-12 space-y-16">
      {/* Featured */}
      <section>
        <div class="flex items-center gap-3 mb-8">
          <div class="bg-amber-100 p-2 rounded-lg">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Editor's Top Picks</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {featured.map((post: any) => (
            <a href={`/top-ten/${post.slug}`} class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-xl transition-all overflow-hidden flex flex-col h-full">
              <div class="h-48 relative bg-gray-100">
                {post.imageUrl ? (
                  <img src={post.imageUrl} alt={post.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  </div>
                )}
                <div class="absolute top-2 left-2">
                  <span class="bg-[#4b0082] text-white text-[10px] font-bold px-2 py-1 rounded shadow-sm">TOP 10</span>
                </div>
              </div>
              <div class="p-5 flex flex-col flex-1">
                <h3 class="font-bold text-base text-gray-900 group-hover:text-[#4b0082] leading-snug mb-3">{post.title}</h3>
                <div class="mt-auto pt-3 border-t border-gray-50 flex items-center text-[#4b0082] text-xs font-bold uppercase tracking-wide">
                  View Ranking
                  <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* Category Sections */}
      {Object.entries(SECTIONS_CONFIG).map(([key, config]) => {
        const items = grouped[key] || [];
        if (items.length === 0) return null;

        return (
          <section class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm relative overflow-hidden">
            <div class="flex items-center gap-4 mb-8 relative z-10">
              <div class={`${config.bg} p-3 rounded-xl`}>
                <svg class={`w-8 h-8 ${config.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900">{config.title}</h2>
                <p class="text-gray-500 text-sm">Latest rankings in this category</p>
              </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
              {items.slice(0, 8).map((item: any) => (
                <a href={`/top-ten/${item.slug}`} class="group flex flex-col bg-white border border-gray-200 hover:border-[#4b0082]/30 rounded-xl overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1 h-full">
                  <div class="h-40 relative bg-gray-100 shrink-0 border-b border-gray-100">
                    {item.imageUrl ? (
                      <img src={item.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-gray-300">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                      </div>
                    )}
                    <div class="absolute top-2 left-2 z-10">
                      <span class="inline-flex items-center bg-[#4b0082]/90 backdrop-blur-md px-2 py-1 rounded text-[10px] font-bold text-white shadow-sm tracking-wide">TOP 10</span>
                    </div>
                  </div>
                  <div class="p-4 flex flex-col flex-1">
                    <h3 class="font-bold text-sm text-gray-900 group-hover:text-[#4b0082] line-clamp-2 leading-snug mb-3">{item.title}</h3>
                    <div class="mt-auto flex items-center justify-between">
                      <span class="text-[11px] font-medium text-gray-500 uppercase tracking-wider">Guide</span>
                      <svg class="w-4 h-4 text-gray-300 group-hover:text-[#4b0082] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            {items.length > 8 && (
              <div class="mt-8 text-center">
                <a href={`/${key}`} class="inline-block border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 font-bold py-2.5 px-6 rounded-full text-sm transition-all">
                  View All {config.title} →
                </a>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
