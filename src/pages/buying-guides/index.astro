---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { BUYER_GUIDES_INDEX_QUERY } from '@/sanity/queries/buyer-guide.queries';
import { cleanText } from '@/lib/utils/sanity-text';

type BuyerGuide = {
  _id: string;
  title: string;
  slug: string;
  categorySlug: string;
  categoryTitle: string;
  summary?: unknown;
  mainImage?: { url?: string; alt?: string };
  updatedAt?: string;
};

let guides: BuyerGuide[] = [];
try {
  guides = await client.fetch<BuyerGuide[]>(BUYER_GUIDES_INDEX_QUERY);
} catch (error) {
  console.error('[BuyingGuidesIndex] Error fetching buyer guides:', error);
}

const groups = Array.from(
  guides.reduce((map, guide) => {
    const key = guide.categorySlug || 'reviews';
    const current = map.get(key) || { slug: key, title: guide.categoryTitle || 'Other buying guides', guides: [] as BuyerGuide[] };
    current.guides.push(guide);
    map.set(key, current);
    return map;
  }, new Map<string, { slug: string; title: string; guides: BuyerGuide[] }>()).values()
);

const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://toptenuae.com';
const canonicalUrl = `${baseUrl}/buying-guides`;
const title = 'UAE Buying Guides: Choose the Right Product';
const description = 'Practical UAE buying guides for laptops, air fryers, electric shavers, beard trimmers and baby monitors. Compare features before viewing the best picks.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: `${baseUrl}/${guide.categorySlug}/${guide.slug}`,
    })),
  },
};
---

<BaseLayout title={title} description={description} canonical={canonicalUrl} jsonLd={jsonLd}>
  <main class="min-h-screen bg-slate-50 font-sans pb-20">
    <header class="bg-[#4b0082] text-white px-4 py-14 text-center">
      <div class="mx-auto max-w-4xl">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-amber-300 mb-3">Practical UAE decision help</p>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight">UAE Buying Guides</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-purple-100">Understand the size, features and trade-offs that matter before comparing recommended products.</p>
      </div>
    </header>

    <div class="container mx-auto max-w-6xl px-4 py-12">
      {groups.length > 0 ? (
        <div class="space-y-12">
          {groups.map((group) => (
            <section aria-labelledby={`group-${group.slug}`}>
              <div class="mb-5 flex items-end justify-between gap-4 border-b border-slate-200 pb-3">
                <h2 id={`group-${group.slug}`} class="text-2xl font-black text-slate-900">{group.title}</h2>
                <a href={`/${group.slug}`} class="text-sm font-bold text-[#4b0082] hover:underline">View topic →</a>
              </div>
              <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                {group.guides.map((guide) => (
                  <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all hover:border-[#4b0082]/30 hover:shadow-md">
                    <a href={`/${guide.categorySlug}/${guide.slug}`} class="group grid h-full sm:grid-cols-[160px_1fr]">
                      <div class="min-h-36 bg-slate-100">
                        {guide.mainImage?.url ? (
                          <img src={guide.mainImage.url} alt={guide.mainImage.alt || guide.title} class="h-full w-full object-cover" loading="lazy" />
                        ) : (
                          <div class="flex h-full min-h-36 items-center justify-center text-xs font-black uppercase tracking-wider text-slate-400">TopTenUAE</div>
                        )}
                      </div>
                      <div class="flex flex-col p-5">
                        <h3 class="text-lg font-bold leading-snug text-slate-900 transition-colors group-hover:text-[#4b0082]">{guide.title}</h3>
                        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{cleanText(guide.summary) || 'Practical guidance for choosing the right option in the UAE.'}</p>
                        <span class="mt-4 text-sm font-bold text-[#4b0082]">Read buying guide →</span>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <h2 class="text-xl font-bold text-slate-900">Buying guides are being updated</h2>
          <p class="mt-2 text-slate-600">Please check back shortly.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
