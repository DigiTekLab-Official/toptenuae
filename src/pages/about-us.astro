---
// src/pages/about-us.astro
import BaseLayout from '@/layouts/BaseLayout.astro';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://toptenuae.com/about-us#webpage',
  url: 'https://toptenuae.com/about-us',
  name: 'About TopTenUAE',
  about: { '@id': 'https://toptenuae.com/#organization' },
  isPartOf: { '@id': 'https://toptenuae.com/#website' },
};
---

<BaseLayout
  title="About Us | Top Ten UAE"
  description="Learn how TopTenUAE curates the best product recommendations for UAE residents through data-driven analysis and local expertise."
  canonical="https://toptenuae.com/about-us"
  jsonLd={aboutPageSchema}
>
  <div class="bg-white">
    <section class="relative bg-primary py-20 px-4 sm:px-6 lg:px-8 text-center text-white overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-black tracking-tight mb-6">
          Shopping in the UAE, <br /><span class="text-yellow-500">Simplified.</span>
        </h1>
        <p class="text-lg md:text-xl text-indigo-100 leading-relaxed font-medium">
          We analyze thousands of products on Amazon.ae so you don't have to. TopTenUAE is your shortcut to the best deals, gadgets, and essentials in the Emirates.
        </p>
      </div>
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" /></svg>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Why We Started TopTenUAE</h2>
          <div class="w-16 h-1 bg-yellow-400 mb-6"></div>
          <p class="text-gray-600 mb-4 leading-relaxed">Finding the right product in the UAE can be overwhelming. Between fake reviews, confusing specs, and endless options on Amazon.ae and Noon, it's hard to know what's actually worth your Dirhams.</p>
          <p class="text-gray-600 font-medium leading-relaxed">We built TopTenUAE to cut through the noise. We don't just list random products; we analyze verified purchase data, cross-reference local availability, and read the fine print to bring you unbiased top 10 lists.</p>
        </div>
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 shadow-sm">
          <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Our Promise
          </h3>
          <ul class="space-y-4">
            {['100% Unbiased Selection', 'UAE-Specific Availability', 'Data-Backed Rankings', 'Transparent Affiliate Disclosures'].map((item) => (
              <li class="flex items-center gap-3 text-gray-700">
                <div class="shrink-0 w-6 h-6 rounded-full bg-green-100 flex items-center justify-center">
                  <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How We Choose Our Top 10</h2>
          <p class="text-gray-600">We rely on data, not sponsorship. Here is our 3-step vetting process for every list we publish.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mx-auto mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">1. Market Analysis</h3>
            <p class="text-sm text-gray-600 leading-relaxed">We scan Amazon.ae for best-sellers, analyzing sales velocity and "movers and shakers" to see what UAE residents are actually buying.</p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center">
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center mx-auto mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">2. Sentiment Filtering</h3>
            <p class="text-sm text-gray-600 leading-relaxed">We filter out products with suspicious reviews. We look for verified purchase patterns and detailed user feedback to ensure quality.</p>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center">
            <div class="w-12 h-12 bg-yellow-100 text-yellow-600 rounded-lg flex items-center justify-center mx-auto mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">3. The Value Check</h3>
            <p class="text-sm text-gray-600 leading-relaxed">A product might be good, but is it good <em>value</em>? We compare prices across retailers to ensure our top picks justify their price tag.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Transparency & Trust</h2>
      <div class="prose prose-lg mx-auto text-gray-600">
        <p>TopTenUAE is a reader-supported publication. When you buy through links on our site, we may earn an affiliate commission from Amazon.ae or other retailers.</p>
        <p class="font-bold text-gray-900">This comes at no extra cost to you.</p>
        <p>This funding allows us to keep the site ad-minimal and free from sponsored content bias. We do not accept payment to rank products higher. Our "Verdict" is always our own.</p>
      </div>
    </section>

    <section class="bg-primary py-12 px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-6">Ready to find the best?</h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-block bg-yellow-400 text-gray-900 font-bold py-3 px-8 rounded-full hover:bg-yellow-300 transition-colors shadow-lg">Browse Our Top Product Picks</a>
        <a href="/contact-us" class="inline-block bg-transparent border-2 border-white text-white font-bold py-3 px-8 rounded-full hover:bg-white/10 transition-colors">Get in Touch with Our Team</a>
      </div>
    </section>
  </div>
</BaseLayout>
