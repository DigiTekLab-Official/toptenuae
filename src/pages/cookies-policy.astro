---
// src/pages/cookies-policy.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
const lastUpdated = 'December 27, 2025';
---

<BaseLayout
  title="Cookies Policy | Top Ten UAE"
  description="Learn how TopTenUAE uses cookies to improve user experience and analyze site traffic."
  canonical="https://toptenuae.com/cookies-policy"
>
  <div class="bg-white font-sans text-gray-700">

    <!-- HERO -->
    <section class="relative bg-primary py-20 px-4 sm:px-6 lg:px-8 text-center text-white overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-white/10 px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wider mb-6 border border-white/20">
          <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Digital Tracking Policy
        </div>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-6">
          Cookies <span class="text-yellow-400">Policy</span>
        </h1>
        <p class="text-lg md:text-xl text-indigo-100 leading-relaxed font-medium max-w-2xl mx-auto">
          This Cookies Policy explains what Cookies are and how We use them. You should read this policy so You can understand what type of cookies We use.
        </p>
        <p class="mt-4 text-sm text-indigo-200 font-medium">Last Updated: {lastUpdated}</p>
      </div>
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" /></svg>
      </div>
    </section>

    <!-- CONTENT -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <div class="prose prose-lg prose-indigo max-w-none text-gray-700">

        <!-- DEFINITION BOX -->
        <div class="bg-blue-50 p-8 rounded-2xl border border-blue-100 mb-12 not-prose">
          <h2 class="text-xl font-bold text-blue-900 flex items-center gap-3 mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            What are Cookies?
          </h2>
          <p class="text-lg text-blue-800 leading-relaxed font-medium">
            Cookies are small files that are placed on Your computer, mobile device or any other device by a website, containing the details of Your browsing history on that website among its many uses.
          </p>
        </div>

        <h3 class="text-2xl font-bold text-gray-900 mb-6">The Type of Cookies We Use</h3>
        <p class="text-gray-600 mb-8">We use both session and persistent Cookies for the purposes set out below:</p>

        <div class="space-y-6 my-8 not-prose">
          <!-- Necessary -->
          <div class="flex gap-5 items-start bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:border-green-200 transition-colors">
            <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
              <h4 class="text-lg font-bold text-gray-900">Necessary / Essential Cookies</h4>
              <p class="text-gray-600 mt-2 leading-relaxed">These Cookies are essential to provide You with services available through the Website. Without these Cookies, the services You have asked for cannot be provided.</p>
            </div>
          </div>

          <!-- Functional -->
          <div class="flex gap-5 items-start bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:border-indigo-200 transition-colors">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            </div>
            <div>
              <h4 class="text-lg font-bold text-gray-900">Functionality Cookies</h4>
              <p class="text-gray-600 mt-2 leading-relaxed">These allow us to remember choices You make (like login details or language preference). The purpose of these Cookies is to provide You with a more personal experience.</p>
            </div>
          </div>

          <!-- Tracking -->
          <div class="flex gap-5 items-start bg-white border border-gray-100 p-6 rounded-xl shadow-sm hover:border-amber-200 transition-colors">
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h4 class="text-lg font-bold text-gray-900">Tracking & Performance Cookies</h4>
              <p class="text-gray-600 mt-2 leading-relaxed">Used by third-parties like Google Analytics and Amazon. These track information about traffic to the Website and how users use the Website. The information gathered may identify you as an individual visitor.</p>
            </div>
          </div>
        </div>

        <!-- CHOICES SECTION -->
        <div class="mt-16 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Your Choices Regarding Cookies</h2>
          <p class="text-gray-600 mb-6">
            If You prefer to avoid the use of Cookies on the Website, first You must disable the use of Cookies in your browser and then delete the Cookies saved in your browser associated with this website.
          </p>

          <div class="grid sm:grid-cols-2 gap-4 not-prose">
            <a href="https://support.google.com/accounts/answer/32050" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center gap-3 p-4 border border-gray-200 rounded-xl hover:border-primary hover:bg-gray-50 transition-all group">
              <img class="w-6 h-6" src="https://upload.wikimedia.org/wikipedia/commons/e/e1/Google_Chrome_icon_%28February_2022%29.svg" alt="Google Chrome browser logo" loading="lazy" />
              <div class="font-bold text-gray-900 group-hover:text-primary">Manage on Chrome</div>
              <svg class="w-4 h-4 text-gray-400 ml-auto group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <a href="https://support.apple.com/guide/safari/manage-cookies-and-website-data-sfri11471/mac" target="_blank" rel="nofollow noopener noreferrer" class="flex items-center gap-3 p-4 border border-gray-200 rounded-xl hover:border-primary hover:bg-gray-50 transition-all group">
              <img class="w-6 h-6" src="https://upload.wikimedia.org/wikipedia/commons/5/52/Safari_browser_logo.svg" alt="Safari browser logo" loading="lazy" />
              <div class="font-bold text-gray-900 group-hover:text-primary">Manage on Safari</div>
              <svg class="w-4 h-4 text-gray-400 ml-auto group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>

        <!-- CONTACT -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 text-center not-prose mt-12">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Have questions about this policy?</h3>
          <a href="/contact-us" class="inline-flex items-center gap-2 bg-white border border-gray-300 px-8 py-3 rounded-full font-bold text-gray-700 hover:border-primary hover:text-primary transition-all shadow-sm hover:shadow-md">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Contact Us
          </a>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>
