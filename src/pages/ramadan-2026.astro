---
// src/pages/ramadan-2026.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import RamadanCountdown from '@/components/RamadanCountdown';
---

<BaseLayout
  title="Ramadan 2026 UAE: Dates, Iftar Timings & Deals Guide"
  description="Complete guide to Ramadan 2026 in Dubai & UAE. Expected dates, fasting hours, Iftar/Sehri timings, and exclusive Ramadan offers."
  canonical="https://toptenuae.com/ramadan-2026"
>
  <main class="bg-slate-50 min-h-screen font-sans">

    <!-- HERO -->
    <section class="relative bg-[#4b0082] text-white overflow-hidden py-16 lg:py-24">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-amber-400/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-purple-500/30 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>

      <div class="container mx-auto px-4 relative z-10 text-center">
        <span class="inline-block py-1 px-4 rounded-full bg-amber-400/20 text-amber-300 font-bold text-base tracking-widest uppercase mb-4 border border-amber-400/30">
          Ramadan Kareem 1447 AH
        </span>
        <h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
          Ramadan 2026 <br class="hidden md:block" />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-amber-200 to-amber-400">
            UAE Guide & Deals
          </span>
        </h1>
        <p class="text-lg md:text-xl text-purple-100 max-w-2xl mx-auto mb-10 leading-relaxed">
          Your essential guide to dates, Iftar timings, working hours, and the best fasting essentials in Dubai, Abu Dhabi, and across the Emirates.
        </p>

        <RamadanCountdown client:load />
      </div>
    </section>

    <!-- QUICK FACTS -->
    <section class="container mx-auto px-4 -mt-8 relative z-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 flex items-start gap-4">
          <div class="bg-purple-50 p-3 rounded-xl">
            <svg class="w-8 h-8 text-[#4b0082]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-gray-500 uppercase tracking-wider">Expected Start</h3>
            <p class="text-xl font-black text-gray-900 mt-1">Thu, Feb 19, 2026</p>
            <p class="text-base text-gray-400 mt-1">Subject to moon sighting</p>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 flex items-start gap-4">
          <div class="bg-amber-50 p-3 rounded-xl">
            <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-gray-500 uppercase tracking-wider">Fasting Hours</h3>
            <p class="text-xl font-black text-gray-900 mt-1">13-14 Hours</p>
            <p class="text-base text-gray-400 mt-1">Fajr to Maghrib</p>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 flex items-start gap-4">
          <div class="bg-emerald-50 p-3 rounded-xl">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-gray-500 uppercase tracking-wider">Eid Al Fitr</h3>
            <p class="text-xl font-black text-gray-900 mt-1">~ March 19, 2026</p>
            <a href="/events-holidays/uae-holidays-2026" class="text-base font-bold text-emerald-600 hover:underline mt-1 block">
              View 2026 Holiday Calendar &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-16 grid grid-cols-1 lg:grid-cols-12 gap-12">

      <!-- MAIN CONTENT -->
      <div class="lg:col-span-8 space-y-12">

        <!-- Introduction -->
        <div class="prose prose-lg max-w-none text-gray-600">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">When is Ramadan 2026 in the UAE?</h2>
          <p>
            Ramadan 2026 is expected to begin on <strong>Thursday, February 19, 2026</strong>.
            As the holiest month in Islam, it is a time of fasting, prayer, and community.
            In the UAE, the atmosphere transforms with reduced working hours, vibrant night markets,
            and special Iftar tents.
          </p>
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-lg my-6">
            <p class="text-base text-yellow-800 m-0 font-medium">
              ⚠️ <strong>Note:</strong> All dates are subject to the official announcement by the UAE Moon Sighting Committee.
              For broader planning, check our guide to <a href="/events-holidays/uae-holidays-2026" class="underline decoration-yellow-500 hover:bg-yellow-100">Official UAE Holidays in 2026</a>.
            </p>
          </div>
        </div>

        <!-- Timetable -->
        <section>
          <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-[#4b0082]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Expected Prayer Timings
          </h3>
          <div class="overflow-hidden border border-gray-200 rounded-xl shadow-base">
            <table class="min-w-full divide-y divide-gray-200 bg-white">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-base font-bold text-gray-500 uppercase tracking-wider">Time Period</th>
                  <th class="px-6 py-3 text-left text-base font-bold text-gray-500 uppercase tracking-wider">Fajr (Suhoor Ends)</th>
                  <th class="px-6 py-3 text-left text-base font-bold text-gray-500 uppercase tracking-wider">Maghrib (Iftar)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-base font-medium text-gray-900">Beginning (Feb 19)</td>
                  <td class="px-6 py-4 text-base text-gray-600">05:25 AM</td>
                  <td class="px-6 py-4 text-base text-gray-600">06:15 PM</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-base font-medium text-gray-900">Middle (Mar 5)</td>
                  <td class="px-6 py-4 text-base text-gray-600">05:10 AM</td>
                  <td class="px-6 py-4 text-base text-gray-600">06:22 PM</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-base font-medium text-gray-900">End (Mar 19)</td>
                  <td class="px-6 py-4 text-base text-gray-600">04:55 AM</td>
                  <td class="px-6 py-4 text-base text-gray-600">06:30 PM</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-base text-gray-500 mt-2">*Timings are approximate for Dubai and may vary by +/- 3 minutes for Abu Dhabi and Sharjah.</p>
        </section>

        <!-- Grid: Zakat & Eid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- Zakat Card -->
          <div class="bg-white p-6 rounded-2xl border border-gray-200 hover:shadow-md transition-shadow flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 bg-red-50 rounded-lg">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900">Zakat & Charity</h3>
            </div>
            <p class="text-base text-gray-600 mb-6 flex-1">
              Ramadan is the month of giving. Calculate your exact Zakat amount easily or learn how to pay securely online.
            </p>
            <div class="flex flex-col gap-3 mt-auto">
              <a href="/finance-tools/zakat-calculator" class="flex items-center justify-center gap-2 w-full py-2.5 bg-red-50 text-red-700 font-bold rounded-xl text-base hover:bg-red-100 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                Use Zakat Calculator
              </a>
              <a href="/how-to-guides/how-to-pay-zakat-in-uae-online" class="text-center text-base font-bold text-gray-500 hover:text-red-600">
                Read Guide: How to Pay Online &rarr;
              </a>
            </div>
          </div>

          <!-- Eid Card -->
          <div class="bg-white p-6 rounded-2xl border border-gray-200 hover:shadow-md transition-shadow flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 bg-emerald-50 rounded-lg">
                <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900">Eid Al Fitr 2026</h3>
            </div>
            <p class="text-base text-gray-600 mb-6 flex-1">
              As Ramadan concludes, prepare for the celebrations. Find prayer timings and the best spots to visit during the long break.
            </p>
            <div class="space-y-3 mt-auto">
              <a href="/events-holidays/eid-al-fitr-uae-prayer-timings-free-events" class="block text-base font-bold text-emerald-700 hover:underline">
                🕌 Eid Prayer Timings & Locations
              </a>
              <a href="/events-holidays/eid-holidays-uae-2026-best-places-to-visit" class="block text-base font-bold text-emerald-700 hover:underline">
                🎡 Best Places to Visit this Eid
              </a>
            </div>
          </div>
        </div>

        <!-- DEALS BANNER -->
        <section class="relative overflow-hidden bg-linear-to-r from-orange-500 to-amber-500 rounded-2xl shadow-lg text-white">
          <div class="relative z-10 p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="text-center md:text-left">
              <div class="inline-block bg-white/20 backdrop-blur-base px-3 py-1 rounded-full text-base font-bold uppercase tracking-wider mb-3">Early Access</div>
              <h3 class="text-3xl md:text-4xl font-black mb-2">Early Ramadan Deals</h3>
              <p class="text-orange-100 font-medium text-lg mb-6">Up to 50% Off Kitchen, Decor & Electronics</p>
              <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                <div class="bg-white text-orange-600 px-4 py-2 rounded-lg font-bold text-base flex items-center gap-2 shadow-base">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  Extra 10% off with ADCB
                </div>
                <div class="bg-white text-orange-600 px-4 py-2 rounded-lg font-bold text-base flex items-center gap-2 shadow-base">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  FAB Bank Offers
                </div>
              </div>
            </div>
            <div class="shrink-0">
              <a href="/deals" class="inline-flex items-center justify-center w-full md:w-auto px-8 py-4 bg-white text-orange-600 font-black rounded-xl hover:bg-orange-50 transition-all transform hover:scale-105 shadow-xl">
                Shop Deals Now
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </section>

      </div>

      <!-- SIDEBAR -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-24">

          <div class="bg-white p-6 rounded-2xl shadow-base border border-gray-100">
            <h3 class="text-base font-bold text-gray-400 uppercase tracking-wider mb-6 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#4b0082]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              Ramadan Essentials
            </h3>

            <div class="space-y-6">
              <a href="/finance-tools/zakat-calculator" class="group block">
                <span class="text-base font-bold text-[#4b0082] mb-1 block">Finance Tool</span>
                <h4 class="text-gray-900 font-bold leading-snug group-hover:text-[#4b0082] transition-colors">
                  Official UAE Zakat Calculator 2026
                </h4>
              </a>

              <a href="/how-to-guides/how-to-pay-zakat-in-uae-online" class="group block border-t border-gray-100 pt-4">
                <span class="text-base font-bold text-emerald-600 mb-1 block">Step-by-Step Guide</span>
                <h4 class="text-gray-900 font-bold leading-snug group-hover:text-[#4b0082] transition-colors">
                  How to Pay Zakat Online in UAE (Secure & Approved)
                </h4>
              </a>

              <a href="/events-holidays/eid-al-fitr-uae-prayer-timings-free-events" class="group block border-t border-gray-100 pt-4">
                <span class="text-base font-bold text-purple-600 mb-1 block">Eid Al Fitr</span>
                <h4 class="text-gray-900 font-bold leading-snug group-hover:text-[#4b0082] transition-colors">
                  Eid Prayer Timings & Musalla Locations
                </h4>
              </a>

              <a href="/events-holidays/uae-holidays-2026" class="group block border-t border-gray-100 pt-4">
                <span class="text-base font-bold text-amber-500 mb-1 block">Planning Ahead</span>
                <h4 class="text-gray-900 font-bold leading-snug group-hover:text-[#4b0082] transition-colors">
                  Full UAE Public Holiday Calendar 2026
                </h4>
              </a>
            </div>
          </div>

          <div class="bg-[#4b0082] p-6 rounded-2xl shadow-lg text-center mt-6">
            <h4 class="text-white font-bold mb-2">Don't Miss Eid Deals</h4>
            <p class="text-purple-200 text-base mb-4">Get the best offers delivered to your inbox.</p>
            <a href="/subscribe" class="block w-full py-2 bg-white text-[#4b0082] font-bold rounded-lg text-base hover:bg-gray-100 transition-colors">
              Subscribe Free
            </a>
          </div>

        </div>
      </aside>
    </div>

    <!-- DEALS SECTION -->
    <section class="bg-white py-16 border-t border-gray-200">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-black text-gray-900 flex items-center gap-3">
            <span class="bg-red-100 p-2 rounded-lg">
              <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/></svg>
            </span>
            Exclusive Ramadan Offers
          </h2>
          <a href="/deals" class="text-[#4b0082] font-bold hover:underline hidden md:block">
            View All Deals &rarr;
          </a>
        </div>

        <div class="p-12 border-2 border-dashed border-gray-200 rounded-2xl text-center text-gray-400 bg-gray-50">
          [Deals Grid Component Renders Here]
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
