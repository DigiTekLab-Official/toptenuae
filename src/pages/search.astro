---
// src/pages/search.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';

const query = Astro.url.searchParams.get('q')?.trim() || '';

const SEARCH_QUERY = `
  *[
    _type in ["category","product","topTenList","buyerGuide","howTo","news","post","article","holiday","tool"] &&
    !(_id in path("drafts.**")) &&
    (
      title match ["* " + $term + " *", $term + " *", "* " + $term, $term] ||
      pt::text(intro) match ["* " + $term + " *", $term + " *", "* " + $term, $term] ||
      pt::text(body) match ["* " + $term + " *", $term + " *", "* " + $term, $term] ||
      categories[]->title match ["* " + $term + " *", $term + " *", "* " + $term, $term] ||
      menuLabel match ["* " + $term + " *", $term + " *", "* " + $term, $term] ||
      description match ["* " + $term + " *", $term + " *", "* " + $term, $term]
    )
  ] {
    title,
    "slug": slug.current,
    "imageUrl": coalesce(featuredImage.asset->url, mainImage.asset->url, ogImage.asset->url),
    publishedAt,
    "categories": categories[]->title,
    "intro": coalesce(intro, description),
    _type,
    "categorySlug": coalesce(categories[0]->slug.current, category->slug.current),
    "score": (
      select(title match ["* " + $term + " *", $term + " *", "* " + $term, $term] => 4, 0) +
      select(pt::text(intro) match ["* " + $term + " *", $term + " *", "* " + $term, $term] => 3, 0) +
      select(pt::text(body) match ["* " + $term + " *", $term + " *", "* " + $term, $term] => 2, 0) +
      select(categories[]->title match ["* " + $term + " *", $term + " *", "* " + $term, $term] => 1, 0)
    )
  } | order(score desc, publishedAt desc)
`;

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('en-AE', { month: 'long', day: 'numeric', year: 'numeric' });

const resultPath = (post: any) => {
  if (post._type === 'product') return `/reviews/${post.slug}`;
  if (post._type === 'category') return `/${post.slug}`;
  if (post._type === 'topTenList') return `/top-ten/${post.slug}`;
  if (post._type === 'holiday' || post._type === 'event') return `/events-holidays/${post.slug}`;
  if (post._type === 'tool') return `/finance-tools/${post.slug}`;
  if (post._type === 'howTo') return `/how-to-guides/${post.slug}`;
  if (post._type === 'buyerGuide') return `/${post.categorySlug || 'reviews'}/${post.slug}`;
  return `/${post.slug}`;
};

let posts: any[] = [];
if (query.length > 1) {
  try {
    posts = await client.fetch(SEARCH_QUERY, { term: query });
  } catch (error) {
    console.error('Search error:', error);
  }
}
---

<BaseLayout
  title={`Search Results for "${query}" | Top Ten UAE`}
  description={`Search results for ${query} on TopTenUAE.`}
  noIndex={true}
>
  <div class="min-h-screen bg-gray-50 font-sans pb-20">
    {/* HERO */}
    <div class="bg-primary text-white py-12 px-4 text-center relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
        </svg>
      </div>
      <div class="relative z-10">
        <div class="inline-flex items-center justify-center p-3 bg-white/10 rounded-full mb-4 border border-white/20">
          <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <h1 class="text-3xl md:text-5xl font-black mb-2 tracking-tight">
          {query ? `Results for "${query}"` : 'Search TopTenUAE'}
        </h1>
        <p class="text-indigo-200 font-medium">
          Found {posts.length} {posts.length === 1 ? 'match' : 'matches'} in our archives
        </p>
      </div>
    </div>

    {/* MAIN */}
    <div class="container mx-auto px-4 py-12 max-w-7xl">
      <a href="/" class="inline-flex items-center text-sm font-bold text-gray-400 hover:text-primary mb-8 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back to Home
      </a>

      {posts.length === 0 && (
        <div class="max-w-xl mx-auto text-center py-16 bg-white rounded-3xl border border-gray-200 shadow-sm px-6">
          <div class="w-20 h-20 bg-gray-50 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">No matches found</h2>
          <p class="text-gray-500 mb-8 leading-relaxed">
            We couldn't find anything matching <strong class="text-gray-900">{query}</strong>. Try searching for a category like "Tech" or "Travel".
          </p>
          <form action="/search" method="GET" class="relative max-w-sm mx-auto mb-6">
            <input type="text" name="q" value={query} placeholder="Try a different keyword..." class="w-full pl-5 pr-12 py-3 rounded-full bg-gray-50 border border-gray-200 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" />
            <button type="submit" class="absolute right-2 top-2 p-1.5 bg-primary text-white rounded-full hover:bg-primary/90 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
          </form>
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post: any) => (
          <a href={resultPath(post)} class="group flex flex-col bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-primary/30 transition-all duration-300">
            <div class="relative h-56 w-full overflow-hidden bg-gray-100">
              {post.imageUrl ? (
                <img src={post.imageUrl} alt={post.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-10 h-10 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
              )}
              {post.categories && post.categories.length > 0 && (
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-xs font-bold text-gray-800 px-3 py-1 rounded-full shadow-sm">
                  {post.categories[0]}
                </div>
              )}
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs text-gray-400 font-bold uppercase tracking-wider mb-3">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {post.publishedAt ? formatDate(post.publishedAt) : 'Recently Updated'}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary transition-colors line-clamp-2 leading-tight">
                {post.title}
              </h3>
              <p class="text-sm text-gray-500 line-clamp-2 mb-4">
                {Array.isArray(post.intro) ? post.intro[0]?.children?.[0]?.text : (post.intro || 'Read full details in the article...')}
              </p>
              <div class="flex items-center justify-between gap-4 mt-auto">
                <span class="inline-flex items-center text-sm font-bold text-primary group-hover:translate-x-1 transition-transform">
                  Read Article
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
