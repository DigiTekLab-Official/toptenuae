---
// src/pages/reviews/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { PRODUCT_BY_SLUG_QUERY } from '@/sanity/lib/queries';
import { generateSchema } from '@/lib/schemaGenerator';
import ProductView from '@/components/views/ProductView';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404', 404);

let data: any = null;
try {
  data = await client.fetch(PRODUCT_BY_SLUG_QUERY, { slug });
} catch (error) {
  console.error(`Error fetching product review [${slug}]:`, error);
}

if (!data) return Astro.redirect('/404', 404);

// Smart redirects for wrong content types
if (data._type === 'topTenList') return Astro.redirect(`/top-ten/${slug}`, 301);
if (data._type === 'holiday' || data._type === 'event' || data._type === 'article') return Astro.redirect(`/events-holidays/${slug}`, 301);
if (data._type === 'howTo' || data._type === 'tool') {
  return Astro.redirect(`/${data.category?.slug?.current || data.categories?.[0]?.slug?.current || (data._type === 'howTo' ? 'how-to-guides' : 'finance-tools')}/${slug}`, 301);
}

const viewData = {
  ...data,
  title: data.title.toLowerCase().endsWith('review') ? data.title : `${data.title} Review`,
};

const schemaData = generateSchema({ ...data, slug: { current: slug }, _type: data._type || 'product' }, 'reviews', slug);
const canonicalUrl = `https://toptenuae.com/reviews/${slug}`;
const seoTitle = data.seoTitle || viewData.title;
const seoDescription = data.seoDescription || data.itemDescription || '';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  ogImage={data.mainImage?.url}
  jsonLd={schemaData}
>
  <ProductView data={viewData} client:load />
</BaseLayout>
