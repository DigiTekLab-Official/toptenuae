---
// src/pages/reviews/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { PRODUCT_BY_SLUG_QUERY } from '@/sanity/lib/queries';
import { generateSchema } from '@/lib/schemaGenerator';
import ProductView from '@/components/views/ProductView';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

let data: any = null;
try {
  // 1. Try to fetch as a product first
  data = await client.fetch(PRODUCT_BY_SLUG_QUERY, { slug });
} catch (error) {
  console.error(`Error fetching product review [${slug}]:`, error);
}

// 2. If no product data is found, check if it's actually another content type (like topTenList)
if (!data) {
  let fallbackData: any = null;
  try {
    fallbackData = await client.fetch(
      `*[slug.current == $slug][0]{ 
        _type, 
        "categorySlug": category->slug.current, 
        "categories": categories[]->slug.current 
      }`,
      { slug }
    );
  } catch (error) {
    console.error(`Error fetching fallback type for [${slug}]:`, error);
  }

  // 3. Smart 301 Redirects for wrong content types
  if (fallbackData) {
    if (fallbackData._type === 'topTenList') {
      return Astro.redirect(`/top-ten/${slug}`, 301);
    }
    if (fallbackData._type === 'holiday' || fallbackData._type === 'event' || fallbackData._type === 'article') {
      return Astro.redirect(`/events-holidays/${slug}`, 301);
    }
    if (fallbackData._type === 'howTo' || fallbackData._type === 'tool') {
      const catSlug = fallbackData.categorySlug || fallbackData.categories?.[0] || (fallbackData._type === 'howTo' ? 'how-to-guides' : 'finance-tools');
      return Astro.redirect(`/${catSlug}/${slug}`, 301);
    }
  }

  // 4. If it genuinely doesn't exist in Sanity, THEN 404
  return Astro.redirect('/404');
}

// 5. If data exists, format it and render the page normally
const viewData = {
  ...data,
  title: data.title.toLowerCase().endsWith('review') ? data.title : `${data.title} Review`,
};

const schemaData = generateSchema({ ...data, slug: { current: slug }, _type: data._type || 'product' }, 'reviews', slug);
const canonicalUrl = `https://toptenuae.com/reviews/${slug}`;
const seoTitle = data.seoTitle || viewData.title;
const seoDescription = data.seoDescription || data.itemDescription || data.verdict || '';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  ogImage={data.mainImage?.url}
  jsonLd={schemaData}
>
  <ProductView data={viewData} client:load />
</BaseLayout>