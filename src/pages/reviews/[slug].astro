---
// src/pages/reviews/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { PRODUCT_PAGE_QUERY } from '@/sanity/queries/product.queries';
import { generateSchema } from '@/lib/schemaGenerator';
import ProductView from '@/components/views/ProductView';
import RelatedContent from '@/components/views/RelatedContent';
import { buildContentPath } from '@/lib/contentRoute';
import { isKnownGonePath } from '@/lib/seo/legacy-redirects';

const { slug } = Astro.params;
if (!slug) {
  // Was: return Astro.redirect('/404');
  // A missing slug is not a real URL — return 404 status directly rather than
  // redirecting to the /404 route (a 302 → /404 is what GSC classifies as
  // "Redirect error"). This path is effectively unreachable given Astro's
  // routing, but kept correct for safety.
  return Astro.rewrite('/404');
}

let data: any = null;
let fallbackData: any = null;
let related: { lists: any[]; products: any[] } = { lists: [], products: [] };
try {
  const result = await client.fetch(PRODUCT_PAGE_QUERY, { slug });
  data = result?.data || null;
  fallbackData = result?.fallback || null;
  related = result?.related || related;
} catch (error) {
  console.error(`Error fetching product review [${slug}]:`, error);
}

// 2. If no product data is found, check if it's actually another content type (like topTenList)
if (!data) {
  // 3. Keep a type-aware fallback for newly moved content that is not yet in
  //    the frozen legacy map. Document type owns dedicated route prefixes.
  if (fallbackData) {
    const target = buildContentPath({
      _type: fallbackData._type,
      slug,
      categorySlug: fallbackData.categorySlug || fallbackData.categories?.[0],
    });
    if (target) return Astro.redirect(target, 301);
  }

  // Missing review slugs are not presumed deleted. Only an audited exact path
  // may be terminal 410; every unknown miss is a normal direct 404.
  if (isKnownGonePath(`/reviews/${slug}`)) {
    return new Response('Gone', { status: 410 });
  }
  return Astro.rewrite('/404');
}

// 5. If data exists, format it and render the page normally
const viewData = {
  ...data,
  title: data.title.toLowerCase().endsWith('review') ? data.title : `${data.title} Review`,
};

const schemaData = generateSchema(
  { ...data, slug: { current: slug }, _type: data._type || 'product' },
  'reviews',
  slug
);

// Issue 2 fix: derive base URL from environment variable so staging/preview
// environments don't emit a hardcoded production canonical.
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://toptenuae.com';
const canonicalUrl = data.seo?.canonicalUrl || `${baseUrl}/reviews/${slug}`;

// Issue 1 fix: prefer Sanity seo{} block fields before falling back to
// top-level seoTitle / seoDescription / verdict fields.
// data.seo?.metaTitle is populated by the Sanity SEO plugin; older documents
// may only have top-level seoTitle, so both are tried in order.
const seoTitle =
  data.seo?.metaTitle ||
  data.seoTitle ||
  viewData.title;

const seoDescription =
  data.seo?.metaDescription ||
  data.seoDescription ||
  data.verdict ||
  '';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  ogImage={data.mainImage?.url}
  noIndex={data.seo?.noIndex === true}
  jsonLd={schemaData}
>
  <ProductView data={viewData} />
  <RelatedContent lists={related.lists} products={related.products} />
</BaseLayout>
