---
// src/pages/[category]/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { client } from '@/sanity/lib/client';
import { GENERIC_POST_QUERY, TOP_TEN_LIST_QUERY } from '@/sanity/lib/queries';
import { generateSchema } from '@/lib/schemaGenerator';
import ArticleView from '@/components/views/ArticleView';
import groq from 'groq';

const { category, slug } = Astro.params;

if (!category || !slug) return Astro.redirect('/404');

// HOW-TO query
// FIX #1 (High Priority): Added schemaType, _updatedAt, _createdAt so the
// Sanity schema-selector radio button (NewsArticle / HowTo / FAQPage) actually
// reaches the frontend instead of being silently dropped.
const HOW_TO_QUERY = groq`
  *[_type == "howTo" && slug.current == $slug][0]{
    _id, _type, title, "slug": slug.current,
    publishedAt,
    _updatedAt,
    _createdAt,
    schemaType,
    intro, body, faqs, howToSteps,
    "author": Author->{ name, image, bio },
    mainImage { alt, "url": asset->url, "lqip": asset->metadata.lqip, "dimensions": asset->metadata.dimensions },
    "categories": categories[]->{ "slug": slug.current, title },
    seo { metaTitle, metaDescription, shareImage }
  }
`;

// Category normalization
const normalizeCategory = (categorySlug: string) => {
  const map: Record<string, string> = {
    'travel-tourism': 'events-holidays',
    'health-fitness': 'lifestyle',
    'baby-kid': 'parenting-kids',
    'buyers-guide': 'reviews',
  };
  return map[categorySlug] || categorySlug;
};

// Fetch valid categories + doc type in parallel (2 fetches instead of 3)
let validCategories = new Set<string>();
let docType: string | null = null;

try {
  const [categories, fetchedType] = await Promise.all([
    client.fetch(groq`*[_type == "category"]{ "slug": slug.current }`),
    client.fetch(groq`*[slug.current == $slug][0]._type`, { slug }),
  ]);
  validCategories = new Set(categories.map((c: any) => c.slug));
  docType = fetchedType;
} catch { /* ignore */ }

// Fetch data based on content type
let data: any = null;
try {
  if (docType === 'topTenList') {
    data = await client.fetch(TOP_TEN_LIST_QUERY, { slug });
  } else if (docType === 'howTo') {
    data = await client.fetch(HOW_TO_QUERY, { slug });
  } else {
    data = await client.fetch(GENERIC_POST_QUERY, { slug });
  }
} catch (error) {
  console.error(`Error fetching content [${slug}]:`, error);
}

if (!data) return Astro.redirect('/404');

// Determine correct category
let defaultCat = 'reviews';
if (data._type === 'holiday' || data._type === 'event') defaultCat = 'events-holidays';
if (data._type === 'tool') defaultCat = 'finance-tools';
if (data._type === 'howTo') defaultCat = 'how-to-guides';

const rawCategory = data.category?.slug?.current || data.categories?.[0]?.slug?.current || defaultCat;
const correctCategory = normalizeCategory(rawCategory);

// Validate & redirect if needed
if (validCategories.size > 0 && !validCategories.has(correctCategory)) {
  return Astro.redirect('/404');
}

if (correctCategory !== category) {
  return Astro.redirect(`/${correctCategory}/${slug}`, 301);
}

// Generate schema
const schemaData = generateSchema(data, category, slug);

// SEO metadata
const primaryCat = data.categories?.[0]?.slug?.current || data.category?.slug?.current;
const masterCategory = normalizeCategory(primaryCat || 'reviews');
const imageUrl = data.mainImage?.url || data.mainImage?.asset?.url || null;

const seoTitle = data.seo?.metaTitle || data.title || 'Article';
const seoDescription = data.seo?.metaDescription || '';
const canonicalUrl = `https://toptenuae.com/${masterCategory}/${slug}`;
const isToolPage = data._type === 'tool';

// FIX #5 (Opportunity #2): howToSteps is intentionally NOT passed to ArticleView /
// ToolLayout. It is fetched solely for structured-data generation in generateSchema()
// above. Readers see `body`; Google sees the JSON-LD HowTo steps. No duplicate
// content, no clutter in the editor preview.
---

{isToolPage ? (
  <BaseLayout
    title={seoTitle}
    description={seoDescription}
    canonical={canonicalUrl}
    ogImage={imageUrl}
    jsonLd={schemaData}
  >
    <ToolLayout data={data} category={category} slug={slug} />
  </BaseLayout>
) : (
  <BaseLayout
    title={seoTitle}
    description={seoDescription}
    canonical={canonicalUrl}
    ogImage={imageUrl}
    jsonLd={schemaData}
  >
    <ArticleView data={data} category={category} slug={slug} client:load />
  </BaseLayout>
)}