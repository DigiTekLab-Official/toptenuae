---
// src/pages/[category]/[slug].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { client } from '@/sanity/lib/client';
import { GENERIC_POST_QUERY } from '@/sanity/queries/post.queries';
import { generateSchema } from '@/lib/schemaGenerator';
import { getGscSeoOverride } from '@/lib/seo/gsc-overrides';
import { buildContentPath } from '@/lib/contentRoute';
import ArticleView from '@/components/views/ArticleView';

const { category, slug } = Astro.params;

if (!category || !slug) return Astro.rewrite('/404');

// Category normalization
const normalizeCategory = (categorySlug: string) => {
  const map: Record<string, string> = {
    'travel-tourism': 'events-holidays',
    'health-fitness': 'lifestyle',
    'baby-kid': 'parenting-kids',
    'buyers-guide': 'reviews',
  };
  return map[categorySlug] || categorySlug;
};

// A single type-aware projection replaces the old category-list query, type
// probe and content query. Dedicated content types are redirected before this
// generic payload is rendered, preserving every canonical route.
// The generic GROQ projection intentionally spans heterogeneous Sanity schemas.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let data: any = null;
try {
  data = await client.fetch(GENERIC_POST_QUERY, { slug });
} catch (error) {
  console.error(`Error fetching content [${slug}]:`, error);
}

if (!data) return Astro.rewrite('/404');

// Determine correct category
let defaultCat = 'reviews';
if (data._type === 'holiday' || data._type === 'event') defaultCat = 'events-holidays';
if (data._type === 'tool') defaultCat = 'finance-tools';
if (data._type === 'howTo') defaultCat = 'how-to-guides';

const rawCategory =
  data.categorySlug ||
  data.category?.slug?.current ||
  data.category?.slug ||
  data.categories?.[0]?.slug?.current ||
  data.categories?.[0]?.slug ||
  defaultCat;
const typeOwnedPath = buildContentPath({
  _type: data._type,
  slug,
  categorySlug: rawCategory,
});
const hasDedicatedRoute = ['topTenList', 'product', 'howTo', 'tool', 'holiday', 'event']
  .includes(data._type);
const correctCategory = hasDedicatedRoute && typeOwnedPath
  ? typeOwnedPath.split('/')[1]
  : normalizeCategory(rawCategory);

const canonicalPath = typeOwnedPath && hasDedicatedRoute
  ? typeOwnedPath
  : `/${correctCategory}/${slug}`;
if (canonicalPath !== Astro.url.pathname) {
  return Astro.redirect(canonicalPath, 301);
}

// Generate schema. Stored HowTo steps are not rendered by this route, so do not
// emit a HowTo node that describes content readers cannot see. Other page-level
// schemas (Organization, BreadcrumbList and visible FAQs) remain unchanged.
const generatedSchemas = generateSchema(data, category, slug);
const schemaData = data._type === 'howTo' && Array.isArray(generatedSchemas)
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  ? generatedSchemas.filter((schema: any) => schema?.['@type'] !== 'HowTo')
  : generatedSchemas;

// SEO metadata
const imageUrl = data.mainImage?.url || data.mainImage?.asset?.url || null;

const gscSeoOverride = getGscSeoOverride(slug);
const seoTitle = gscSeoOverride?.title || data.seo?.metaTitle || data.seoTitle || data.title || 'Article';
const seoDescription = gscSeoOverride?.description || data.seo?.metaDescription || data.seoDescription || data.intro || '';
// Self-canonical: reuse the type-aware `correctCategory` (line ~93), which the
// redirect guard above guarantees equals the served URL segment. The old
// `masterCategory` ignored content type and defaulted to 'reviews' (and the
// `primaryCat` read was undefined due to a string-vs-object slug shape), so
// howTo/tool/holiday pages emitted a wrong /reviews/ canonical that contradicted
// their own JSON-LD and suppressed indexing.
const baseUrl = import.meta.env.PUBLIC_BASE_URL || 'https://toptenuae.com';
const canonicalUrl = data.seo?.canonicalUrl || `${baseUrl}/${correctCategory}/${slug}`;
const isToolPage = data._type === 'tool';
---

{isToolPage ? (
  <BaseLayout
    title={seoTitle}
    description={seoDescription}
    canonical={canonicalUrl}
    ogImage={imageUrl}
    noIndex={data.seo?.noIndex === true}
    jsonLd={schemaData}
  >
    <ToolLayout data={data} category={category} slug={slug} />
  </BaseLayout>
) : (
  <BaseLayout
    title={seoTitle}
    description={seoDescription}
    canonical={canonicalUrl}
    ogImage={imageUrl}
    noIndex={data.seo?.noIndex === true}
    jsonLd={schemaData}
    enableClientRouter={slug !== 'how-to-choose-wireless-earbuds-uae'}
  >
    <ArticleView data={data} category={category} slug={slug} />
  </BaseLayout>
)}
