---
// src/pages/[category]/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { client } from '@/sanity/lib/client';
import { CATEGORY_PAGE_QUERY } from '@/sanity/queries/category.queries';
import Sidebar from '@/components/Sidebar';
import { cleanText } from '@/lib/utils/sanity-text';
import { listImage } from '@/sanity/lib/image';
import groq from 'groq';

const { category } = Astro.params;

// Custom pages handled by dedicated routes
const CUSTOM_PAGES = ['reviews', 'deals'];
if (!category || CUSTOM_PAGES.includes(category)) {
  return Astro.rewrite('/404');
}

// Cheap guard: malformed/bot junk never touches Sanity (real slugs are lowercase-hyphenated).
const SLUG_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
if (category.length > 96 || !SLUG_RE.test(category)) {
  return Astro.rewrite('/404');
}

// Category normalization — mirror of [category]/[slug].astro so any 301 target is FINAL (no second hop).
const normalizeCategory = (c: string): string => ({
  'travel-tourism': 'events-holidays',
  'health-fitness': 'lifestyle',
  'baby-kid': 'parenting-kids',
  'buyers-guide': 'reviews',
} as Record<string, string>)[c] || c;

// Flat WordPress permalinks that are permanently gone → 410. A slug belongs here
// ONLY if Sanity returns NO live doc for it (else the probe above 301s it). Each
// entry below was confirmed dead via `*[slug.current==$s][0]._type` → null
// (curated from gsc-exports/soft-404.csv + not-found-404.csv, 2026-05-30).
// EXCLUDED because LIVE (probe 301s them): how-to-clean-washing-machine (howTo),
//   eid-al-fitr-uae-prayer-timings-free-events (holiday), charity-organizations-uae-donations
//   (howTo), where-to-donate-used-toys-uae (howTo), best-baby-monitors-uae (topTenList).
const LEGACY_GONE = new Set<string>([
  'best-diaper-bags-uae',                                      // no live doc; no diaper-bags list
  'best-diaper-bags-in-uae',                                   // variant; no live doc
  'best-baby-toys',                                            // no live doc
  'best-books-for-babys-first-library',                        // no live doc
  'nasa-astronaut-don-pettit-burj-khalifa-image-from-space',   // dead WP news article
  'best-educational-toys-uae',                                 // no live doc; no equivalent list
  'best-educational-toys-in-uae',                              // variant; no live doc
  'best-beauty-products-uae',                                  // no live doc; no beauty list
  'best-beauty-personal-care-products-uae',                    // no live doc
  'uae-holidays-2025',                                         // no live doc (2026 is a separate live slug)
  'best-eid-holiday-travel-destinations-uae',                  // no live doc
  'free-eid-events-festive-activities-uae',                    // no live doc
  'ninja-air-fryer-max-xl-af160me-review',                     // no live doc (dead product review)
]);

let data: any = null;
try {
  data = await client.fetch(CATEGORY_PAGE_QUERY, { slug: category });
} catch (error) {
  console.error('Error fetching category data:', error);
}

if (!data) {
  // Not a category hub. Probe whether this flat slug is a live content doc that moved.
  let probe: { _type?: string; cat?: string; cats?: string[] } | null = null;
  try {
    probe = await client.fetch(
      groq`*[slug.current == $slug][0]{ _type, "cat": category->slug.current, "cats": categories[]->slug.current }`,
      { slug: category }
    );
  } catch (error) {
    console.error(`Error probing flat slug [${category}]:`, error);
  }

  if (probe?._type) {
    const t = probe._type;
    let target: string;
    if (t === 'topTenList') target = `/top-ten/${category}`;
    else if (t === 'product') target = `/reviews/${category}`;
    else {
      let def = 'reviews';
      if (t === 'holiday' || t === 'event') def = 'events-holidays';
      else if (t === 'tool') def = 'finance-tools';
      else if (t === 'howTo') def = 'how-to-guides';
      target = `/${normalizeCategory(probe.cat || probe.cats?.[0] || def)}/${category}`;
    }
    return Astro.redirect(target, 301);
  }

  // No live doc: permanently-removed legacy permalink → 410; everything else → hard 404.
  return Astro.rewrite(LEGACY_GONE.has(category) ? '/410' : '/404');
}

const categorySlug = data.slug || category;
if (!categorySlug || categorySlug === 'null') return Astro.redirect('/404');

const validItems = (data.items || []).filter((item: any) => item && item.slug);
const isFinanceTools = categorySlug === 'finance-tools';

// Tool config helper
const getToolConfig = (slug: string) => {
  if (!slug) return { ctaLabel: 'Calculate', iconColor: 'text-purple-600 group-hover:text-white', iconBg: 'bg-purple-50 group-hover:bg-purple-600' };
  const s = slug.toLowerCase();
  if (s.includes('vat')) return { ctaLabel: 'Calculate VAT', iconColor: 'text-[#4b0082] group-hover:text-white', iconBg: 'bg-blue-50 group-hover:bg-[#4b0082]' };
  if (s.includes('zakat')) return { ctaLabel: 'Calculate Zakat', iconColor: 'text-indigo-500 group-hover:text-white', iconBg: 'bg-indigo-50 group-hover:bg-indigo-500' };
  if (s.includes('gratuity')) return { ctaLabel: 'Calculate Benefits', iconColor: 'text-amber-500 group-hover:text-white', iconBg: 'bg-amber-50 group-hover:bg-amber-500' };
  if (s.includes('loan') || s.includes('car')) return { ctaLabel: 'Estimate EMI', iconColor: 'text-sky-500 group-hover:text-white', iconBg: 'bg-sky-50 group-hover:bg-sky-600' };
  if (s.includes('visa') || s.includes('freelance')) return { ctaLabel: 'Compare Costs', iconColor: 'text-violet-500 group-hover:text-white', iconBg: 'bg-violet-50 group-hover:bg-violet-500' };
  if (s.includes('roi')) return { ctaLabel: 'Check ROI', iconColor: 'text-emerald-500 group-hover:text-white', iconBg: 'bg-emerald-50 group-hover:bg-emerald-500' };
  return { ctaLabel: 'Calculate Now', iconColor: 'text-purple-600 group-hover:text-white', iconBg: 'bg-purple-50 group-hover:bg-purple-600' };
};

// JSON-LD
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: cleanText(data.title),
  description: cleanText(data.description) || `Collection of ${data.title}`,
  url: `https://toptenuae.com/${categorySlug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: validItems.map((item: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://toptenuae.com/${categorySlug}/${item.slug}`,
      name: cleanText(item.title),
    })),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toptenuae.com' },
    { '@type': 'ListItem', position: 2, name: cleanText(data.title), item: `https://toptenuae.com/${categorySlug}` },
  ],
};

const seoTitle = `${data.title} | TopTenUAE`;
const seoDescription = cleanText(data.description) || `Explore the best content in ${data.title}.`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`https://toptenuae.com/${categorySlug}`}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <div class="min-h-screen bg-slate-50 font-sans pb-20">

    {/* Hero Section */}
    <div class="bg-[#4b0082] text-white py-12 px-4 text-center relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" />
        </svg>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <div class="flex justify-center mb-6">
          <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-white/10 border border-white/20 text-amber-300 text-xs font-bold uppercase tracking-wider backdrop-blur-md">
            {isFinanceTools ? (
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            ) : (
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
            )}
            {isFinanceTools ? 'Free Tools & Calculators' : 'Category Archive'}
          </span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight">{data.title}</h1>
        <p class="text-indigo-100 text-lg md:text-xl max-w-2xl mx-auto font-medium leading-relaxed">
          {seoDescription}
        </p>
      </div>
    </div>

    {/* Content Area */}
    <div class="container mx-auto px-4 py-16 max-w-7xl">
      <div class="flex flex-col lg:flex-row gap-12">
        <main class="flex-1">
          <div class={`grid gap-8 ${isFinanceTools ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 md:grid-cols-2'}`}>
            {validItems.map((post: any) => {
              if (isFinanceTools) {
                const config = getToolConfig(post.slug);
                return (
                  <a href={`/${categorySlug}/${post.slug}`} class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-xl transition-all p-6 flex flex-col items-start h-full">
                    <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-5 transition-colors ${config.iconBg}`}>
                      <svg class={`w-7 h-7 transition-colors ${config.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900 group-hover:text-[#4b0082] transition-colors mb-2">{post.title}</h2>
                    <p class="text-sm text-slate-500 mb-6 line-clamp-2">
                      {cleanText(post.rawExcerpt) || 'Calculate instantly with our free UAE tool.'}
                    </p>
                    <span class="mt-auto flex items-center gap-2 text-sm font-bold text-[#4b0082] group-hover:underline">
                      {config.ctaLabel}
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </a>
                );
              }

              const optimizedImageUrl = post.mainImage ? ((post.mainImage as any).url || listImage(post.mainImage)) : null;
              return (
                <a href={`/${categorySlug}/${post.slug}`} class="group bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-xl transition-all overflow-hidden flex flex-col h-full">
                  <div class="h-52 relative bg-gray-100 shrink-0">
                    {optimizedImageUrl ? (
                      <img src={optimizedImageUrl} alt={post.title || 'Article image'} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-slate-400 font-bold">TOP TEN UAE</div>
                    )}
                  </div>
                  <div class="p-6 flex flex-col flex-1">
                    <h2 class="text-xl font-bold mb-3 text-gray-900 group-hover:text-[#4b0082] transition-colors leading-tight">{post.title}</h2>
                    <p class="text-gray-600 text-sm line-clamp-3 mb-5 flex-1 leading-relaxed">
                      {cleanText(post.rawExcerpt) || 'Read more about this article'}
                    </p>
                    <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
                      <span class="text-xs font-medium text-gray-400">
                        {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Recent'}
                      </span>
                      <span class="text-sm font-bold text-[#4b0082] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                        Read
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </main>

        <aside class="w-full lg:w-80 shrink-0 space-y-8">
          <Sidebar currentSlug="" categorySlug={categorySlug} client:visible />
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>
