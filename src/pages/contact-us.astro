---
// src/pages/contact-us.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Top Ten UAE"
  description="Get in touch with the TopTenUAE editorial team. We typically respond within 24-48 hours."
  canonical="https://toptenuae.com/contact-us"
>
  <div class="bg-white font-sans">

    <!-- HERO SECTION -->
    <section class="relative bg-primary py-20 px-4 sm:px-6 lg:px-8 text-center text-white overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-white/10 px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wider mb-6 border border-white/20">
          <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          We'd love to hear from you
        </div>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-6">
          Get in <span class="text-yellow-400">Touch</span>
        </h1>
        <p class="text-lg md:text-xl text-indigo-100 leading-relaxed font-medium max-w-2xl mx-auto">
          Have a question about a review? Want to suggest a product? Or just want to say hello? Our team in Dubai & Abu Dhabi is ready to answer.
        </p>
      </div>
      <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 100 C 20 0 50 0 100 100 Z" fill="white" /></svg>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">

        <!-- LEFT COLUMN: Contact Info & FAQ -->
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Contact Information</h2>
          <p class="text-gray-600 mb-8 leading-relaxed">
            While we primarily operate digitally to keep our reviews unbiased and independent, we are rooted in the UAE.
          </p>

          <div class="space-y-6 mb-12">
            <!-- Response Time -->
            <div class="flex items-start gap-4 p-6 bg-blue-50 rounded-xl border border-blue-100">
              <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-blue-900">Response Time</h3>
                <p class="text-sm text-blue-800 font-medium mt-1">24-48 Hours</p>
                <p class="text-sm text-blue-600 mt-1">Monday - Friday (Gulf Standard Time)</p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl border border-gray-100">
              <div class="w-10 h-10 bg-white text-gray-600 border border-gray-200 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900">Email Us</h3>
                <p class="text-sm text-gray-500 mb-1">For general inquiries & partnerships</p>
                <a href="mailto:info@toptenuae.com" class="text-primary font-bold hover:underline">info@toptenuae.com</a>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-xl border border-gray-100">
              <div class="w-10 h-10 bg-white text-gray-600 border border-gray-200 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900">Location</h3>
                <p class="text-sm text-gray-500">Dubai & Abu Dhabi, <br /> United Arab Emirates</p>
              </div>
            </div>
          </div>

          <!-- Mini FAQ -->
          <div class="border-t border-gray-100 pt-8">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Frequently Asked Questions
            </h3>
            <div class="space-y-4">
              <details class="group bg-white border border-gray-200 rounded-lg open:ring-2 open:ring-primary/20">
                <summary class="font-medium text-gray-800 p-4 cursor-pointer list-none flex justify-between items-center">
                  Do you accept sponsored reviews?
                  <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="px-4 pb-4 text-sm text-gray-600 leading-relaxed">
                  No. To maintain our independence, we do not accept payment in exchange for positive reviews or higher rankings.
                </div>
              </details>
              <details class="group bg-white border border-gray-200 rounded-lg open:ring-2 open:ring-primary/20">
                <summary class="font-medium text-gray-800 p-4 cursor-pointer list-none flex justify-between items-center">
                  How do I report a factual error?
                  <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="px-4 pb-4 text-sm text-gray-600 leading-relaxed">
                  We strive for accuracy. If you find outdated info, please email us with the subject line "Correction".
                </div>
              </details>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Form -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 lg:p-10 relative overflow-hidden h-fit">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl translate-x-10 -translate-y-10"></div>

          <h2 class="text-2xl font-bold text-gray-900 mb-2 relative z-10">Send a Message</h2>
          <p class="text-gray-500 text-sm mb-8 relative z-10">
            Please fill out the form below. <span class="font-semibold text-primary">Response time: 24-48 hours.</span>
          </p>

          <form class="space-y-5 relative z-10">
            <!-- Honeypot -->
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Do not fill this field" />

            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="name" class="text-sm font-bold text-gray-700">Name</label>
                <input type="text" id="name" name="name" required placeholder="Your Name" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
              </div>
              <div class="space-y-1">
                <label for="email" class="text-sm font-bold text-gray-700">Email</label>
                <input type="email" id="email" name="email" required placeholder="you@example.com" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
              </div>
            </div>

            <div class="space-y-1">
              <label for="subject" class="text-sm font-bold text-gray-700">Subject</label>
              <select id="subject" name="subject" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-gray-600">
                <option>General Inquiry</option>
                <option>Partnership / Advertising</option>
                <option>Report a Bug</option>
                <option>Review Request</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="message" class="text-sm font-bold text-gray-700">Message</label>
              <textarea id="message" name="message" required rows="5" placeholder="How can we help you?" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-none"></textarea>
            </div>

            <button type="submit" class="w-full bg-primary text-white font-bold py-4 rounded-lg shadow-lg hover:bg-primary/90 transition-transform active:scale-95 flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send Message
            </button>

            <p class="text-sm text-center text-gray-400 mt-4">
              By sending this message, you agree to our <a href="/privacy-policy" class="underline hover:text-gray-600">Privacy Policy</a>.
            </p>
          </form>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>
