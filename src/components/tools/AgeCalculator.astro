---
import { getUaeToday } from '@/lib/calculators/age.js';
const today = getUaeToday();
const todayLabel = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Asia/Dubai', day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(`${today}T00:00:00Z`));
Astro.response.headers.set('Cache-Control', 'no-store');
---

<div id="age-calc" data-today={today} class="w-full max-w-xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden border border-slate-200 font-sans">
  <div class="bg-[#4b0082] p-5 text-center relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-linear-to-r from-amber-300 via-amber-500 to-amber-300"></div>
    <h2 class="text-xl font-bold text-white relative z-10">Age Calculator UAE</h2>
    <p class="text-amber-300 text-sm uppercase tracking-wider font-semibold mt-1 relative z-10">Years, Months &amp; Days</p>
  </div>
  <form class="p-6 space-y-5" novalidate>
    <div>
      <label for="age-dob" class="block text-sm font-semibold text-gray-700 mb-1">Date of birth</label>
      <input id="age-dob" name="dateOfBirth" type="date" min="0001-01-01" max={today} required aria-describedby="age-help age-error" class="w-full px-3 py-1 border border-gray-400 rounded-lg focus:ring-2 focus:ring-[#4b0082] outline-none text-gray-600" />
      <p id="age-help" class="text-sm text-gray-400 mt-1">Age as of <time datetime={today}>{todayLabel}</time> (UAE time). Reload the page for a new day.</p>
    </div>
    <p id="age-error" role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" hidden></p>
    <button id="age-calculate" type="submit" class="w-full bg-[#4b0082] hover:bg-[#3b0066] text-white font-bold py-4 rounded-lg shadow-lg shadow-purple-900/20 transition-all transform active:scale-[0.98] mt-2">Calculate Age</button>
    <div aria-live="polite" aria-atomic="true">
      <div id="age-result" class="mt-6 bg-green-50 border border-green-200 rounded-xl p-5 text-center animate-in fade-in slide-in-from-top-2" hidden>
        <p class="text-sm font-bold text-green-700 uppercase tracking-widest mb-2">Your Age Today</p>
        <output id="age-value" for="age-dob" class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"></output>
        <p class="text-sm text-green-800 mt-2 font-medium">As of {todayLabel} (UAE time)</p>
      </div>
    </div>
  </form>
</div>

<script>
  import { calculateAge } from '@/lib/calculators/age.js';
  function initializeAge() {
    const root = document.getElementById('age-calc');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const dob = root.querySelector<HTMLInputElement>('#age-dob')!;
    const error = root.querySelector<HTMLElement>('#age-error')!;
    const result = root.querySelector<HTMLElement>('#age-result')!;
    const value = root.querySelector<HTMLOutputElement>('#age-value')!;
    dob.addEventListener('input', () => {
      error.hidden = true;
      result.hidden = true;
      dob.removeAttribute('aria-invalid');
    });
    root.querySelector('form')!.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const age = calculateAge(dob.value, root.dataset.today);
        value.value = `${age.years} ${age.years === 1 ? 'year' : 'years'}, ${age.months} ${age.months === 1 ? 'month' : 'months'}, ${age.days} ${age.days === 1 ? 'day' : 'days'}`;
        dob.setAttribute('aria-invalid', 'false');
        error.hidden = true;
        result.hidden = false;
      } catch (problem) {
        result.hidden = true;
        error.textContent = problem instanceof Error ? problem.message : 'Enter a valid date of birth.';
        error.hidden = false;
        dob.setAttribute('aria-invalid', 'true');
        dob.focus();
      }
    });
  }
  initializeAge();
  document.addEventListener('astro:page-load', initializeAge);
</script>
