---
const fieldClass = 'w-full px-3 py-2 border border-gray-400 rounded-lg focus:ring-2 focus:ring-[#4b0082] outline-none font-medium';
const fields = [
  { id: 'age', label: 'Age (years)', min: 18, max: 100, step: '1', example: '30' },
  { id: 'weight', label: 'Weight (kg)', min: 30, max: 300, step: 'any', example: '70' },
  { id: 'height', label: 'Height (cm)', min: 100, max: 250, step: 'any', example: '175' },
];
---
<div id="calories-calc" class="w-full max-w-xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden border border-slate-200 font-sans">
  <div class="bg-[#4b0082] p-5 text-center border-t-4 border-amber-400">
    <h2 class="text-xl font-bold text-white">Calories Calculator UAE</h2>
    <p class="text-amber-300 text-sm font-semibold mt-1">Estimated Daily Calorie Needs</p>
  </div>
  <form class="p-6 space-y-4" novalidate>
    <p id="calories-help" class="text-xs leading-relaxed text-slate-600">For adults 18–100, not during pregnancy or breastfeeding. Estimates are not a diet prescription. Medical conditions, athletic training and eating-disorder recovery need individual guidance.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {fields.map(field => (
        <div>
          <label for={`calories-${field.id}`} class="block text-sm font-semibold text-gray-700 mb-1">{field.label}</label>
          <input id={`calories-${field.id}`} type="number" inputmode={field.id === 'age' ? 'numeric' : 'decimal'} min={field.min} max={field.max} step={field.step} placeholder={`e.g. ${field.example}`} required aria-describedby="calories-help calories-error" class={fieldClass} />
        </div>
      ))}
      <div>
        <label for="calories-sex" class="block text-sm font-semibold text-gray-700 mb-1">Sex used by equation</label>
        <select id="calories-sex" required aria-describedby="calories-help calories-error" class={fieldClass}>
          <option value="">Select</option><option value="female">Female coefficient</option><option value="male">Male coefficient</option>
        </select>
      </div>
    </div>
    <div>
      <label for="calories-activity" class="block text-sm font-semibold text-gray-700 mb-1">Activity level</label>
      <select id="calories-activity" required aria-describedby="calories-activity-help calories-error" class={fieldClass}>
        <option value="sedentary">Sedentary — mostly sitting (×1.2)</option>
        <option value="light">Light — some regular activity (×1.375)</option>
        <option value="moderate">Moderate — regular exercise (×1.55)</option>
        <option value="active">Active — substantial daily activity (×1.725)</option>
        <option value="veryActive">Very active — intensive activity (×1.9)</option>
      </select>
      <p id="calories-activity-help" class="text-xs text-slate-600 mt-1">Activity multipliers are approximate assumptions, not measured energy expenditure.</p>
    </div>
    <p id="calories-error" class="rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-700" role="alert" hidden></p>
    <button type="submit" class="w-full bg-[#4b0082] hover:bg-[#3b0066] text-white font-bold py-4 rounded-lg">Calculate Calories</button>
    <div aria-live="polite" aria-atomic="true">
      <div id="calories-result" class="bg-green-50 border border-green-200 rounded-xl p-5" hidden>
        <p class="text-sm font-bold text-green-700 text-center uppercase mb-2">Estimated maintenance</p>
        <p class="text-center"><output id="calories-maintenance" for="calories-age calories-weight calories-height calories-sex calories-activity" class="text-4xl font-extrabold text-slate-900"></output> <span class="text-slate-700">kcal/day</span></p>
        <dl class="space-y-3 text-sm text-slate-800 mt-4">
          <div><dt class="font-semibold">Resting energy estimate (not an intake target)</dt><dd id="calories-resting"></dd></div>
          <div><dt class="font-semibold">10% lower scenario</dt><dd id="calories-lower"></dd></div>
          <div><dt class="font-semibold">10% higher scenario</dt><dd id="calories-higher"></dd></div>
        </dl>
        <p class="text-xs leading-relaxed text-slate-600 mt-3">Rounded to whole kcal. Lower/higher figures illustrate arithmetic adjustments, not recommended intakes or guaranteed weight changes. A registered dietitian can help set an appropriate target.</p>
      </div>
    </div>
    <p class="text-xs text-slate-600">Method: <a class="underline" href="https://pubmed.ncbi.nlm.nih.gov/2305711/" target="_blank" rel="noopener noreferrer">Mifflin–St Jeor resting-energy equation</a> × selected activity factor. No UAE-specific calorie formula is assumed.</p>
  </form>
</div>
<script>
  import { calculateCalories } from '@/lib/calculators/calories.js';
  function initializeCalories() {
    const root = document.getElementById('calories-calc');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const form = root.querySelector('form')!;
    const error = root.querySelector<HTMLElement>('#calories-error')!;
    const result = root.querySelector<HTMLElement>('#calories-result')!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));
    const reset = () => { error.hidden = true; result.hidden = true; fields.forEach(f => f.removeAttribute('aria-invalid')); };
    form.addEventListener('input', reset);
    form.addEventListener('change', reset);
    form.addEventListener('submit', event => {
      event.preventDefault(); reset();
      const number = (id: string) => root.querySelector<HTMLInputElement>(`#calories-${id}`)!.valueAsNumber;
      const choice = (id: string) => root.querySelector<HTMLSelectElement>(`#calories-${id}`)!.value;
      try {
        const r = calculateCalories({ age: number('age'), weight: number('weight'), height: number('height'), sex: choice('sex'), activity: choice('activity') });
        const display = (n: number) => Math.round(n).toLocaleString('en-AE');
        root.querySelector<HTMLOutputElement>('#calories-maintenance')!.value = display(r.maintenance);
        root.querySelector<HTMLElement>('#calories-resting')!.textContent = `${display(r.resting)} kcal/day`;
        root.querySelector<HTMLElement>('#calories-lower')!.textContent = r.lowerScenario === null ? 'Not shown for underweight inputs or a low calorie estimate. Seek individual advice.' : `${display(r.lowerScenario)} kcal/day`;
        root.querySelector<HTMLElement>('#calories-higher')!.textContent = `${display(r.higherScenario)} kcal/day`;
        result.hidden = false;
      } catch (problem) {
        fields.forEach(f => f.setAttribute('aria-invalid', String(!f.checkValidity())));
        error.textContent = problem instanceof Error ? problem.message : 'Check your measurements.';
        error.hidden = false;
        root.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      }
    });
  }
  initializeCalories();
  document.addEventListener('astro:page-load', initializeCalories);
</script>
