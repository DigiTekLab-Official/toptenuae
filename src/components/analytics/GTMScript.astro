---
/**
 * Enterprise Analytics Router (Astro v4+)
 * Optimized for Core Web Vitals (TBT/INP) via Idle-Deferral
 * Supports global consent initialization states
 * src/components/analytics/GTMScript.astro
 */
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-N3PB47W';
---

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function() { dataLayer.push(arguments); };
  
  // Enterprise Default Consent State (GDPR / CCPA / CPRA Ready)
  // Modify defaults or hook into a Consent Management Platform (CMP) like Cookiebot/OneTrust
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'wait_for_update': 500 // Milliseconds to wait for CMP to update flags
  });

</script>

<script is:inline define:vars={{ gtmId }}>
  if (typeof window !== 'undefined') {
    const injectTrackingScripts = () => {
      // GTM is the only analytics delivery path. GA4 is configured in the
      // published container rather than through a second direct gtag.js load.
      if (gtmId) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      }
    };

    // Defer injection until main thread is completely free to maximize TBT/INP scores
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => injectTrackingScripts(), { timeout: 3500 });
    } else {
      setTimeout(injectTrackingScripts, 3500);
    }
  }
</script>
